# Local optional. Leave blank unless you need these services.
# Do not put real secrets in git.

BETTER_AUTH_SECRET=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PREVIEW_CLIENT_SECRET=
# Required in Production. Production fails closed instead of using process-local state.
DATABASE_URL=
VITE_PUBLIC_HOSTNAME=
VITE_AUTH_ENABLED=false
OPENAI_API_KEY=
ARCHIVE_AI_REQUIRED=0
# At least 32 random bytes. Keep this independent from the OpenAI key.
ARCHIVE_RATE_LIMIT_SECRET=
# Exactly 32 random bytes encoded as base64/base64url, or 64 hex characters.
ARCHIVE_RESULT_ENCRYPTION_KEY=
# At least 32 random bytes, used only by signed internal health probes.
ARCHIVE_MONITOR_TOKEN=
# Search and Persona Pro models use a server-validated allow-list selected in the UI.
# Optional remote-inference budget units (standard=1, advanced=2, pro=3).
ARCHIVE_AI_CLIENT_MINUTE_LIMIT=12
ARCHIVE_AI_CLIENT_DAILY_LIMIT=120
ARCHIVE_AI_GLOBAL_DAILY_LIMIT=250
# Signed deployment/monitor probes use isolated app buckets and never consume user buckets.
ARCHIVE_AI_MONITOR_MINUTE_LIMIT=120
ARCHIVE_AI_MONITOR_DAILY_LIMIT=1500
