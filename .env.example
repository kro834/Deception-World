# Local optional. Leave blank unless you need these services.
# Do not put real secrets in git.

BETTER_AUTH_SECRET=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PREVIEW_CLIENT_SECRET=
# Required in Production. Production fails closed instead of using process-local state.
DATABASE_URL=
VITE_PUBLIC_HOSTNAME=
VITE_AUTH_ENABLED=false

# Optional shared gallery (Supabase Marketplace supplies these server-side).
# Provision the schema by following supabase/README.md; do not replay applied migrations.
# Never expose SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
