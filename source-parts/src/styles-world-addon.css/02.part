
.world-column-stack-item {
  grid-area: 1 / 1;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
}

.world-column-stack-item.is-active {
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
  animation: worldColumnReveal 0.56s cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* 六詠・管理外・その他 share one six-slot matrix. Fixed rows make the
   category switch height-independent; unknown records remain visible slots. */
.manager-archive-panel,
.manager-archive-panel.is-unmanaged,
.manager-archive-panel.is-other {
  display: block;
  min-block-size: 0;
  block-size: 366px;
}

.manager-slot-grid,
.manager-slot-grid.signal-array,
.manager-slot-grid.unmanaged-array,
.manager-slot-grid.other-array {
  display: grid;
  min-block-size: 0;
  block-size: 366px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  grid-template-rows: repeat(2, 178px);
  gap: 10px;
}

.manager-slot-grid > .signal,
.manager-slot-grid > .dante-archive,
.manager-slot-grid > .other-archive-card,
.manager-slot-grid > .archive-placeholder {
  min-block-size: 0;
  block-size: 178px;
}

.manager-slot-grid .dante-archive {
  display: block;
  overflow: hidden;
  border-radius: 20px 34px 20px 12px;
  background: #12070a;
}

.manager-slot-grid .dante-visual {
  position: absolute;
  inset: 0;
}

.manager-slot-grid .dante-visual::after {
  background:
    linear-gradient(180deg, rgba(8, 2, 4, 0.08) 20%, rgba(8, 2, 4, 0.94) 100%),
    linear-gradient(90deg, rgba(8, 2, 4, 0.42), transparent 70%);
}

.manager-slot-grid .dante-copy {
  position: absolute;
  z-index: 2;
  inset: 0;
  justify-content: flex-end;
  padding: 16px;
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.92);
}

.manager-slot-grid .dante-copy small {
  font-size: 6px;
}

.manager-slot-grid .dante-copy b {
  margin-top: 5px;
  font-size: clamp(20px, 2.6vw, 34px);
}

.manager-slot-grid .dante-copy em {
  font-size: 8px;
}

.manager-slot-grid .dante-copy i {
  margin-top: 7px;
  font-size: 5px;
}

.manager-slot-grid .other-archive-card {
  border-radius: 20px 34px 20px 12px;
}

.manager-slot-grid .other-card-code {
  top: 14px;
  left: 14px;
}

.manager-slot-grid .other-card-copy {
  right: 14px;
  bottom: 14px;
  left: 14px;
  gap: 4px;
}

.manager-slot-grid .other-card-copy b {
  font-size: clamp(12px, 1.3vw, 18px);
}

.manager-slot-grid .other-card-copy i {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.archive-placeholder {
  position: relative;
  display: grid;
  min-width: 0;
  align-content: space-between;
  overflow: hidden;
  padding: 16px;
  border: 1px dashed rgba(132, 203, 255, 0.16);
  border-radius: 20px 34px 20px 12px;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.022), transparent 60%), rgba(5, 9, 15, 0.5);
  color: rgba(244, 246, 251, 0.48);
  isolation: isolate;
}

.archive-placeholder::before {
  content: "";
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    135deg,
    transparent 0 17px,
    rgba(255, 255, 255, 0.018) 17px 18px
  );
  pointer-events: none;
}

.archive-placeholder span,
.archive-placeholder i,
.archive-placeholder small,
.archive-placeholder b {
  position: relative;
  z-index: 1;
}

.archive-placeholder span {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 300;
}

.archive-placeholder i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 12px currentColor;
}

.archive-placeholder small {
  font-size: 6px;
  letter-spacing: 0.22em;
}

.archive-placeholder b {
  overflow: hidden;
  font-size: 10px;
  letter-spacing: 0.16em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.archive-placeholder.is-unmanaged {
  border-color: rgba(241, 74, 96, 0.17);
  color: rgba(241, 74, 96, 0.54);
}

.archive-placeholder.is-other {
  border-color: rgba(105, 223, 116, 0.17);
  color: rgba(105, 223, 116, 0.52);
}

@media (max-width: 560px) {
  .manager-archive-panel,
  .manager-archive-panel.is-unmanaged,
  .manager-archive-panel.is-other {
    block-size: 524px;
  }

  .manager-slot-grid,
  .manager-slot-grid.signal-array,
  .manager-slot-grid.unmanaged-array,
  .manager-slot-grid.other-array {
    block-size: 524px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(3, 168px);
  }

  .manager-slot-grid > .signal,
  .manager-slot-grid > .dante-archive,
  .manager-slot-grid > .other-archive-card,
  .manager-slot-grid > .archive-placeholder {
    block-size: 168px;
  }

  .manager-slot-grid .dante-copy {
    padding: 14px;
  }
}

.ios-slide-open::after {
  content: "";
  position: absolute;
  z-index: 5;
  top: 1px;
  right: 14%;
  left: 14%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.54), transparent);
  pointer-events: none;
}

.ios-slide-open-fill {
  position: absolute;
  z-index: 0;
  top: 4px;
  bottom: 4px;
  left: 4px;
  width: var(--slide-fill, var(--slide-thumb-size));
  border-radius: 999px;
  background: linear-gradient(
    90deg,
    color-mix(in srgb, var(--slide-accent) 58%, rgba(255, 255, 255, 0.1)),
    color-mix(in srgb, var(--slide-accent) 28%, transparent)
  );
  opacity: 0.72;
  transition: width 0.44s cubic-bezier(0.18, 1.38, 0.32, 1);
}

.ios-slide-open-label {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 35px;
  bottom: 0;
  left: 64px;
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 3px;
  opacity: var(--slide-label-opacity, 1);
  pointer-events: none;
  transition: opacity 0.18s ease;
}

.ios-slide-open .ios-slide-open-label small,
.ios-slide-open .ios-slide-open-label b {
  display: block;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ios-slide-open .ios-slide-open-label small {
  color: color-mix(in srgb, var(--slide-accent) 72%, #fff);
  font-family: var(--font-display, serif);
  font-size: 6px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.2em;
}

.ios-slide-open .ios-slide-open-label b {
  color: rgba(255, 255, 255, 0.9);
  font-size: 10px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.1em;
}

.ios-slide-open-arrows {
  position: absolute;
  z-index: 2;
  top: 50%;
  right: 15px;
  display: flex;
  gap: 2px;
  transform: translateY(-50%);
  opacity: 0.54;
  pointer-events: none;
}

.ios-slide-open-arrows i {
  display: block;
  width: 6px;
  height: 6px;
  border-top: 1px solid color-mix(in srgb, var(--slide-accent) 72%, #fff);
  border-right: 1px solid color-mix(in srgb, var(--slide-accent) 72%, #fff);
  transform: rotate(45deg);
  animation: iosSlideArrow 1.35s ease-in-out infinite;
}

.ios-slide-open-arrows i:nth-child(2) {
  animation-delay: 0.14s;
}

.ios-slide-open .ios-slide-open-thumb {
  position: absolute;
  z-index: 4;
  /* Both block edges own the vertical geometry. This survives WebKit dropping
     a composited transform and also adapts 50px/46px thumbs without a media
     query that can drift away from the rail height. The matching inline
     geometry in SlideOpenControl protects fresh source reconstruction too. */
  top: 3px;
  right: auto;
  bottom: 3px;
  left: 4px;
  display: grid;
  width: var(--slide-thumb-size);
  height: auto;
  place-items: center;
  overflow: hidden;
  isolation: isolate;
  border: 1px solid color-mix(in srgb, var(--slide-accent) 28%, rgba(255, 255, 255, 0.78));
  border-radius: 50%;
  background:
    radial-gradient(circle at 28% 12%, rgba(255, 255, 255, 0.5), transparent 38%),
    radial-gradient(
      circle at 76% 88%,
      color-mix(in srgb, var(--slide-accent) 34%, transparent),
      transparent 48%
    ),
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.2),
      color-mix(in srgb, var(--slide-accent) 26%, rgba(8, 14, 24, 0.46)) 58%,
      rgba(5, 9, 16, 0.52)
    );
  -webkit-backdrop-filter: blur(16px) saturate(185%) brightness(1.08);
  backdrop-filter: blur(16px) saturate(185%) brightness(1.08);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.72),
    inset 1px 0 0 rgba(255, 255, 255, 0.22),
    inset 0 -1px 0 color-mix(in srgb, var(--slide-accent) 44%, rgba(255, 255, 255, 0.16)),
    inset 0 0 18px color-mix(in srgb, var(--slide-accent) 13%, transparent),
    0 7px 22px color-mix(in srgb, var(--slide-accent) 24%, rgba(0, 0, 0, 0.64)),
    0 2px 5px rgba(0, 0, 0, 0.28);
  transform: translate3d(var(--slide-offset, 0px), 0, 0);
  scale: var(--slide-thumb-scale-x, var(--slide-thumb-press-scale, 1))
    var(--slide-thumb-scale-y, var(--slide-thumb-press-scale, 1));
  rotate: var(--slide-thumb-tilt, 0deg);
  pointer-events: none;
  transition:
    transform 0.44s cubic-bezier(0.18, 1.42, 0.32, 1),
    scale 0.3s cubic-bezier(0.18, 1.5, 0.32, 1),
    rotate 0.3s cubic-bezier(0.18, 1.5, 0.32, 1),
    box-shadow 0.25s ease;
}

.ios-slide-open[data-holding="true"] {
  --slide-thumb-press-scale: 0.92;
  border-color: color-mix(in srgb, var(--slide-accent) 52%, #fff);
}

.ios-slide-open[data-holding="true"] .ios-slide-open-thumb {
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.82),
    inset 0 0 20px color-mix(in srgb, var(--slide-accent) 18%, transparent),
    0 5px 18px color-mix(in srgb, var(--slide-accent) 30%, rgba(0, 0, 0, 0.62));
}

.ios-slide-open .ios-slide-open-thumb::before,
.ios-slide-open .ios-slide-open-thumb::after {
  content: "";
  position: absolute;
  pointer-events: none;
}

.ios-slide-open .ios-slide-open-thumb::before {
  z-index: 0;
  inset: 1px;
  border-radius: inherit;
  background:
    radial-gradient(ellipse at 24% 2%, rgba(255, 255, 255, 0.48), transparent 42%),
    linear-gradient(
      154deg,
      rgba(255, 255, 255, 0.2),
      transparent 34%,
      rgba(255, 255, 255, 0.035) 60%,
      transparent 74%
    );
  mix-blend-mode: screen;
  opacity: 0.9;
}

.ios-slide-open .ios-slide-open-thumb::after {
  z-index: 1;
  top: 6px;
  left: 9px;
  width: 28px;
  height: 12px;
  border-radius: 50%;
  background: linear-gradient(
    104deg,
    transparent 5%,
    rgba(255, 255, 255, 0.18) 22%,
    rgba(255, 255, 255, 0.82) 50%,
    color-mix(in srgb, var(--slide-accent) 34%, transparent) 72%,
    transparent 94%
  );
  filter: blur(0.4px);
  mix-blend-mode: screen;
  opacity: 0.74;
  transform: rotate(-17deg) translate3d(0, 0, 0);
  transition:
    transform 0.28s ease,
    opacity 0.2s ease;
}

.ios-slide-open .ios-slide-open-thumb > i {
  position: absolute;
  z-index: 2;
  inset: 7px;
  border: 1px solid rgba(255, 255, 255, 0.28);
  border-radius: 50%;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.16),
    0 0 12px color-mix(in srgb, var(--slide-accent) 14%, transparent);
}

.ios-slide-open .ios-slide-open-thumb > b {
  position: relative;
  z-index: 3;
  display: grid;
  width: 24px;
  height: 24px;
  place-items: center;
  color: #fff;
  line-height: 0;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.42);
  transition: rotate 0.28s ease;
}

.ios-slide-open .ios-slide-open-thumb svg {
  display: block;
  filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.36)) drop-shadow(0 0 5px rgba(255, 255, 255, 0.16));
}

.ios-slide-open[data-dragging="true"] .ios-slide-open-thumb,
.ios-slide-open[data-dragging="true"] .ios-slide-open-fill {
  transition: none;
  will-change: transform, width;
}

.ios-slide-open[data-dragging="true"] .ios-slide-open-thumb,
.ios-slide-open[data-completing="true"] .ios-slide-open-thumb {
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.82),
    inset 0 -1px 0 color-mix(in srgb, var(--slide-accent) 58%, rgba(255, 255, 255, 0.18)),
    inset 0 0 22px color-mix(in srgb, var(--slide-accent) 20%, transparent),
    0 9px 26px color-mix(in srgb, var(--slide-accent) 34%, rgba(0, 0, 0, 0.62));
}

.ios-slide-open[data-completing="true"] .ios-slide-open-thumb {
  animation: iosSlideThumbDock 0.26s cubic-bezier(0.22, 0.82, 0.24, 1) both;
}

.ios-slide-open[data-completing="true"] .ios-slide-open-fill {
  animation: iosSlideFillDock 0.26s ease-out both;
}

.ios-slide-open[data-dragging="true"] .ios-slide-open-thumb::after,
.ios-slide-open[data-completing="true"] .ios-slide-open-thumb::after {
  opacity: 1;
  transform: rotate(-11deg) translate3d(5px, 1px, 0) scale(1.06);
}

.ios-slide-open[data-completing="true"] {
  border-color: color-mix(in srgb, var(--slide-accent) 58%, #fff);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.42),
    inset 0 0 18px color-mix(in srgb, var(--slide-accent) 16%, transparent),
    0 16px 38px rgba(0, 0, 0, 0.42);
}

.ios-slide-open[data-completing="true"] .ios-slide-open-thumb > b {
  rotate: 90deg;
}
.ios-slide-open[data-completing="true"] .ios-slide-open-arrows {
  opacity: 0;
}

.ios-slide-open:focus,
.ios-slide-open:focus-visible {
  outline: none;
}

.ios-slide-open[data-keyboard-focus="true"]:focus-visible {
  border-color: color-mix(in srgb, var(--slide-accent) 82%, #fff);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.4),
    0 0 0 3px rgba(4, 8, 14, 0.9),
    0 0 0 5px color-mix(in srgb, var(--slide-accent) 72%, #fff),
    0 16px 38px rgba(0, 0, 0, 0.42);
}

.ios-slide-open:active,
.rider-nightmare-pickup-button.ios-slide-open:active {
  transform: none;
  scale: 1;
}

@media (hover: hover) and (pointer: fine) {
  .ios-slide-open:hover .ios-slide-open-thumb {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.82),
      inset 1px 0 0 rgba(255, 255, 255, 0.26),
      inset 0 -1px 0 color-mix(in srgb, var(--slide-accent) 52%, rgba(255, 255, 255, 0.16)),
      inset 0 0 20px color-mix(in srgb, var(--slide-accent) 17%, transparent),
      0 8px 24px color-mix(in srgb, var(--slide-accent) 30%, rgba(0, 0, 0, 0.62)),
      0 2px 5px rgba(0, 0, 0, 0.28);
  }
}

@supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
  .ios-slide-open {
    border-color: rgba(202, 231, 250, 0.28);
    background: #0b111b;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 10px 26px rgba(0, 0, 0, 0.34);
  }

  .ios-slide-open .ios-slide-open-thumb {
    border-color: rgba(211, 238, 255, 0.5);
    background: #315c70;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.42),
      0 6px 18px rgba(0, 0, 0, 0.4);
  }
}

@media (max-width: 480px) {
  .ios-slide-open {
    --slide-thumb-size: 46px;
    width: min(190px, calc(100% - 28px));
    height: 54px;
    min-height: 54px;
  }

  .form-pickup-plus.ios-slide-open {
    right: 14px;
    bottom: 14px;
  }
  .rider-nightmare-pickup-button.ios-slide-open {
    right: auto;
    bottom: auto;
  }

  .ios-slide-open-label {
    left: 59px;
  }
  .ios-slide-open .ios-slide-open-label small {
    font-size: 5.5px;
  }
  .ios-slide-open .ios-slide-open-label b {
    font-size: 9px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ios-slide-open,
  .ios-slide-open-fill,
  .ios-slide-open-label,
  .ios-slide-open .ios-slide-open-thumb,
  .ios-slide-open .ios-slide-open-thumb::after,
  .ios-slide-open .ios-slide-open-thumb > b {
    transition: none !important;
  }

  .ios-slide-open-arrows i {
    animation: none;
  }
  .ios-slide-open[data-completing="true"] .ios-slide-open-thumb,
  .ios-slide-open[data-completing="true"] .ios-slide-open-fill {
    animation: none !important;
  }
}

@media (prefers-contrast: more), (prefers-reduced-transparency: reduce) {
  .ios-slide-open {
    background: #0b111b;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .ios-slide-open .ios-slide-open-thumb {
    background: color-mix(in srgb, var(--slide-accent) 48%, #101824);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}

@media (forced-colors: active) {
  .ios-slide-open,
  .ios-slide-open .ios-slide-open-thumb {
    border: 2px solid ButtonText;
    forced-color-adjust: auto;
  }

  .ios-slide-open .ios-slide-open-thumb::before,
  .ios-slide-open .ios-slide-open-thumb::after {
    display: none;
  }
}

@keyframes iosSlideArrow {
  0%,
  100% {
    opacity: 0.24;
    translate: -2px 0;
  }
  50% {
    opacity: 1;
    translate: 2px 0;
  }
}

@keyframes iosSlideThumbDock {
  0% {
    scale: 1.08 0.94;
    rotate: 3deg;
  }
  48% {
    scale: 0.95 1.08;
    rotate: -1.4deg;
  }
  74% {
    scale: 1.035 0.98;
    rotate: 0.6deg;
  }
  100% {
    scale: 1;
    rotate: 0deg;
  }
}

@keyframes iosSlideFillDock {
  0% {
    filter: brightness(1);
  }
  52% {
    filter: brightness(1.42);
  }
  100% {
    filter: brightness(1.08);
  }
}
/* Zeus keeps the ceremonial sovereign record display, but deliberately has
   no progress meter or percentage. The release is a visual handoff only. */
.load-gate.is-sovereign-gate.is-revealing {
  animation: sovereign-gate-record-release 0.36s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes sovereign-gate-record-release {
  from {
    opacity: 1;
    filter: brightness(1);
  }
  to {
    opacity: 0;
    filter: brightness(1.35);
  }
}

@media (prefers-reduced-motion: reduce) {
  .load-gate.is-sovereign-gate.is-revealing {
    animation: none;
    opacity: 0;
  }
}

/* Modern character records -------------------------------------------------
   Character pages keep their individual accent colours and cinematic art,
   while the reading layer uses a calmer editorial rhythm: one radius system,
   restrained hairlines, and a comfortable measure for long Japanese copy. */
.manager-page:not(.is-sovereign) {
  background:
    radial-gradient(
      circle at 78% 8%,
      color-mix(in srgb, var(--manager-accent) 9%, transparent),
      transparent 30rem
    ),
    radial-gradient(
      circle at 8% 64%,
      color-mix(in srgb, var(--manager-accent) 5%, transparent),
      transparent 36rem
    ),
    #050609;
}

.manager-page:not(.is-sovereign) .manager-grid {
  opacity: 0.055;
  background-size: 88px 88px;
}

.manager-page:not(.is-sovereign) .manager-glow {
  opacity: 0.62;
}

.manager-page:not(.is-sovereign) .manager-hero {
  width: min(1320px, calc(100% - 48px));
  grid-template-columns: minmax(300px, 0.78fr) minmax(0, 1.22fr);
  gap: clamp(48px, 6.6vw, 104px);
}

.manager-page:not(.is-sovereign) .manager-portrait-frame {
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--manager-accent) 28%, rgba(255, 255, 255, 0.1));
  border-radius: clamp(24px, 3vw, 40px);
  background: #090a0e;
  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.42),
    inset 0 1px 0 rgba(255, 255, 255, 0.1),
    0 0 0 1px rgba(255, 255, 255, 0.018);
}

.manager-page:not(.is-sovereign) .manager-portrait-frame::before,
.manager-page:not(.is-sovereign) .manager-portrait-frame::after {
  display: none;
}

.manager-page:not(.is-sovereign) .manager-portrait-frame > img {
  filter: saturate(0.92) contrast(1.025);
  animation-duration: 18s;
}

button.manager-portrait-frame:focus-visible {
  outline: 2px solid color-mix(in srgb, var(--manager-accent) 72%, white);
  outline-offset: 4px;
}

.manager-page:not(.is-sovereign) .manager-numeral {
  top: 22px;
  left: 24px;
  padding: 8px 12px 7px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 999px;
  background: rgba(4, 5, 8, 0.52);
  -webkit-backdrop-filter: blur(14px) saturate(135%);
  backdrop-filter: blur(14px) saturate(135%);
  font-size: clamp(18px, 2.5vw, 30px);
  letter-spacing: -0.025em;
}

.manager-page:not(.is-sovereign) .manager-introduction {
  width: 100%;
  max-width: 720px;
}

.manager-page:not(.is-sovereign) .manager-introduction h1 {
  gap: 12px;
  font-size: clamp(54px, 7.4vw, 104px);
  line-height: 0.96;
  letter-spacing: -0.055em;
}

.manager-page:not(.is-sovereign) .manager-introduction h1 small {
  font-size: 0.12em;
  letter-spacing: 0.32em;
}

.manager-page:not(.is-sovereign) .manager-title {
  max-width: 42rem;
  margin-top: 26px;
  color: rgba(244, 246, 251, 0.68);
  font-size: clamp(14px, 1.25vw, 18px);
  line-height: 1.7;
  letter-spacing: 0.045em;
  text-wrap: pretty;
}

.manager-page:not(.is-sovereign) .manager-quotes {
  gap: 14px;
  margin: 38px 0;
  padding: 22px 24px;
  border: 1px solid color-mix(in srgb, var(--manager-accent) 18%, rgba(255, 255, 255, 0.08));
  border-radius: 18px;
  background:
    linear-gradient(110deg, color-mix(in srgb, var(--manager-accent) 6%, transparent), transparent 64%),
    rgba(255, 255, 255, 0.018);
}

.manager-page:not(.is-sovereign) .manager-quotes q {
  color: rgba(244, 246, 251, 0.84);
  font-size: clamp(13px, 1.08vw, 16px);
  line-height: 1.85;
  text-wrap: pretty;
}

.manager-page:not(.is-sovereign) .manager-facts {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  border: 0;
}

.manager-page:not(.is-sovereign) .manager-facts > div {
  min-height: 72px;
  padding: 15px 17px;
  border: 1px solid color-mix(in srgb, var(--manager-accent) 14%, rgba(255, 255, 255, 0.08));
  border-radius: 16px;
  background:
    linear-gradient(135deg, color-mix(in srgb, var(--manager-accent) 3.5%, transparent), transparent),
    rgba(255, 255, 255, 0.014);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.manager-page:not(.is-sovereign) .manager-dossier {
  width: min(1200px, calc(100% - 48px));
  padding-top: clamp(76px, 8vw, 118px);
}

.manager-page:not(.is-sovereign) .manager-section-index {
  margin-bottom: 22px;
}

.manager-section-nav {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
  gap: 8px;
  margin: 0 0 clamp(34px, 5vw, 58px);
}

.manager-section-nav a {
  display: grid;
  grid-template-columns: 30px minmax(0, 1fr);
  min-height: 58px;
  align-items: center;
  gap: 12px;
  padding: 12px 15px;
  border: 1px solid color-mix(in srgb, var(--manager-accent) 15%, rgba(255, 255, 255, 0.08));
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.016);
  color: rgba(244, 246, 251, 0.66);
  text-decoration: none;
  transition:
    border-color 0.24s ease,
    background 0.24s ease,
    color 0.24s ease,
    transform 0.32s var(--glass-spring);
}

.manager-section-nav a > span {
  color: var(--manager-accent);
  font-family: var(--font-display);
  font-size: 11px;
  letter-spacing: 0.14em;
}

.manager-section-nav a > b {
  min-width: 0;
  font-size: 10px;
  line-height: 1.55;
  letter-spacing: 0.17em;
  overflow-wrap: anywhere;
}

.manager-section-nav a:focus-visible {
  outline: 2px solid color-mix(in srgb, var(--manager-accent) 72%, white);
  outline-offset: 3px;
}

@media (hover: hover) and (pointer: fine) {
  .manager-section-nav a:hover {
    border-color: color-mix(in srgb, var(--manager-accent) 42%, transparent);
    background: color-mix(in srgb, var(--manager-accent) 5%, rgba(255, 255, 255, 0.018));
    color: rgba(255, 255, 255, 0.9);
    transform: translateY(-2px);
  }
}

.manager-copy-section {
  scroll-margin-top: 104px;
}

.manager-page:not(.is-sovereign) .manager-copy-section {
  grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
  gap: clamp(38px, 6vw, 82px);
  margin-bottom: 14px;
  padding: clamp(40px, 5vw, 64px);
  border: 1px solid color-mix(in srgb, var(--manager-accent) 13%, rgba(255, 255, 255, 0.075));
  border-radius: 28px;
  background:
    linear-gradient(132deg, color-mix(in srgb, var(--manager-accent) 3%, transparent), transparent 38%),
    rgba(13, 14, 18, 0.72);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.055),
    0 24px 72px rgba(0, 0, 0, 0.18);
}

.manager-page:not(.is-sovereign) .manager-copy-section::after {
  display: none;
}

.manager-page:not(.is-sovereign) .manager-copy-section:target {
  border-color: color-mix(in srgb, var(--manager-accent) 44%, transparent);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.075),
    0 24px 72px rgba(0, 0, 0, 0.2),
    0 0 0 1px color-mix(in srgb, var(--manager-accent) 12%, transparent);
}

.manager-page:not(.is-sovereign) .manager-copy-heading h2 {
  max-width: 500px;
  font-family: "Yu Mincho", "Hiragino Mincho ProN", "Noto Serif JP", serif;
  font-size: clamp(30px, 3.4vw, 48px);
  font-weight: 600;
  line-height: 1.24;
  letter-spacing: -0.025em;
}

.manager-page:not(.is-sovereign) .manager-copy-body {
  width: 100%;
  max-width: 46rem;
  gap: 18px;
}

.manager-page:not(.is-sovereign) .manager-copy-body p {
  color: rgba(225, 229, 237, 0.72);
  font-size: clamp(13px, 1.02vw, 15px);
  line-height: 1.94;
  text-align: start;
  text-wrap: pretty;
  line-break: strict;
}

/* The second civilian record on rider pages now belongs to the same visual
   family as the primary dossier instead of looking like a separate template. */
.rider-dossier-page .rider-archive-civilian,
.rider-dossier-page .rider-nightmare-card {
  border-radius: 28px;
  border-color: color-mix(in srgb, var(--archive-accent) 18%, rgba(255, 255, 255, 0.08));
  background:
    linear-gradient(135deg, color-mix(in srgb, var(--archive-accent) 4%, transparent), transparent 38%),
    rgba(12, 14, 19, 0.78);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.06),
    0 26px 72px rgba(0, 0, 0, 0.24);
}

.rider-dossier-page .rider-archive-civilian > figcaption > p:not(:first-child),
.rider-dossier-page .rider-partner-copy > p {
  color: rgba(225, 229, 237, 0.7);
  line-height: 1.9;
  letter-spacing: 0.02em;
  text-wrap: pretty;
}

@media (max-width: 980px) {
  .manager-page:not(.is-sovereign) .manager-hero {
    grid-template-columns: minmax(250px, 0.8fr) minmax(0, 1.2fr);
    gap: 34px;
  }

  .manager-page:not(.is-sovereign) .manager-copy-section {
    grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
    gap: 34px;
  }
}

@media (max-width: 760px) {
  .manager-page:not(.is-sovereign) .manager-hero {
    display: block;
    width: 100%;
    padding-top: calc(92px + env(safe-area-inset-top));
    padding-bottom: 70px;
  }

  .manager-page:not(.is-sovereign) .manager-portrait-column {
    margin-bottom: 42px;
  }

  .manager-page:not(.is-sovereign) .manager-portrait-frame {
    border-radius: 24px;
  }

  .manager-page:not(.is-sovereign) .manager-introduction h1 {
    font-size: clamp(48px, 14.5vw, 76px);
  }

  .manager-page:not(.is-sovereign) .manager-title {
    margin-top: 20px;
  }

  .manager-page:not(.is-sovereign) .manager-quotes {
    margin: 28px 0;
    padding: 19px 18px;
  }

  .manager-page:not(.is-sovereign) .manager-dossier {
    width: calc(100% - 36px - env(safe-area-inset-left) - env(safe-area-inset-right));
    padding-top: 68px;
  }

  .manager-section-nav {
    display: flex;
    width: calc(100% + 18px);
    margin-right: -18px;
    padding-right: 18px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .manager-section-nav::-webkit-scrollbar {
    display: none;
  }

  .manager-section-nav a {
    min-width: min(78vw, 280px);
    font-size: 11px;
    scroll-snap-align: start;
  }

  .manager-section-nav a > b {
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .manager-copy-section {
    scroll-margin-top: 86px;
  }

  .manager-page:not(.is-sovereign) .manager-copy-section {
    grid-template-columns: 1fr;
    gap: 28px;
    padding: 32px 22px;
    border-radius: 24px;
  }

  .manager-page:not(.is-sovereign) .manager-copy-heading h2 {
    font-size: clamp(29px, 8vw, 42px);
  }

  .rider-dossier-page .rider-archive-civilian,
  .rider-dossier-page .rider-nightmare-card {
    border-radius: 24px;
  }
}

@media (max-width: 560px) {
  .manager-back,
  .manager-topbar .side-panel-trigger {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
  }

  .manager-page:not(.is-sovereign) .manager-facts {
    grid-template-columns: 1fr;
  }

  .manager-page:not(.is-sovereign) .manager-facts > div {
    min-height: 66px;
  }

  .manager-page:not(.is-sovereign) .manager-dossier {
    width: calc(100% - 28px - env(safe-area-inset-left) - env(safe-area-inset-right));
  }
}

@media (prefers-reduced-motion: reduce) {
  .manager-section-nav a {
    transition: none;
  }
}

@media (prefers-reduced-transparency: reduce) {
  .manager-page:not(.is-sovereign) .manager-numeral,
  .manager-page:not(.is-sovereign) .manager-quotes,
  .manager-page:not(.is-sovereign) .manager-copy-section,
  .rider-dossier-page .rider-archive-civilian,
  .rider-dossier-page .rider-nightmare-card {
    background: #0d0f14;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
