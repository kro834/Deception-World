@import "./styles-world/rexonance-pickup.css";

html[data-mode="world"] {
  height: auto;
  overflow: auto;
}

html[data-mode="world"] body {
  overflow: auto;
  overflow-x: hidden;
  height: auto;
  overscroll-behavior: auto;
  -webkit-user-select: none;
  user-select: none;
}

html[data-mode="world"][data-rail-lock],
html[data-mode="world"][data-loading] {
  overflow: hidden;
}

html[data-mode="world"][data-rail-lock] body,
html[data-mode="world"][data-loading] body {
  overflow: hidden;
  overscroll-behavior: none;
  touch-action: none;
}

.rider-tabs.liquid-swipe-tabs,
.rider-tabs.liquid-swipe-tabs > button[role="tab"],
.liquid-swipe-tabs,
.liquid-swipe-tabs > button[role="tab"],
.world-column-tabs,
.world-column-dialog-tabs {
  touch-action: pan-y;
}

html[data-rail-lock] .world-column-dialog,
html[data-rail-lock] .world-column-dialog-card {
  overflow: hidden !important;
  overscroll-behavior: none;
  touch-action: none;
}

.rider-visual img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.12s linear;
}

.rider-visual img.is-on {
  opacity: 1;
  z-index: 1;
}

.lejas-signal img {
  object-fit: cover;
  object-position: 50% 8%;
  transform: scale(1.06);
  transform-origin: 50% 6%;
}

.manager-portrait-frame {
  cursor: zoom-in;
  border: 0;
  padding: 0;
  display: block;
  width: 100%;
  color: inherit;
  text-align: left;
}

.manager-portrait-frame.is-closeup {
  cursor: zoom-out;
}

.lejas-wide,
.lejas-face {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lejas-face { opacity: 0; }
.manager-portrait-frame.is-closeup .lejas-face { opacity: 1; }
.manager-portrait-frame.is-closeup .lejas-wide { opacity: 0; }

.lejas-tap-hint {
  position: absolute;
  z-index: 4;
  right: 16px;
  bottom: 16px;
  padding: 6px 10px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 999px;
  background: rgba(6, 10, 16, 0.55);
  color: rgba(244, 246, 251, 0.78);
  font-size: 8px;
  letter-spacing: 0.16em;
}

.topbar {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  column-gap: 12px;
}

.topbar-leading {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10px;
  justify-self: start;
}

.topbar .brand { justify-self: start; }
.topbar nav { justify-self: center; }

.topbar-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  justify-self: end;
  grid-column: -2;
}

.site-update-control {
  position: fixed;
  z-index: 38;
  top: calc(90px + env(safe-area-inset-top));
  left: max(16px, env(safe-area-inset-left));
  pointer-events: none;
}

.site-update-button {
  min-width: 46px;
  min-height: 40px;
  pointer-events: auto;
}

.side-panel-trigger {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  padding: 0;
}

.side-panel-trigger-ring { display: none; }

.side-panel-trigger-glyph {
  display: grid;
  gap: 4px;
  justify-items: center;
  justify-self: center;
}

.side-panel-trigger-glyph i,
.side-panel-trigger-glyph i:nth-child(2),
.side-panel-trigger-glyph i:nth-child(3) {
  width: 14px;
}

.side-panel-close {
  display: grid;
  width: 40px;
  height: 40px;
  padding: 0;
  place-items: center;
  line-height: 0;
  font-size: 0;
  color: rgba(238, 250, 255, 0.92);
}

.poster-film,
.poster-film button { display: none !important; }

.world-column-dialog {
  width: 100vw !important;
  max-width: none !important;
  height: 100dvh !important;
  max-height: none !important;
  margin: 0 !important;
  padding: 18px !important;
  border: 0 !important;
  background: transparent !important;
  outline: none !important;
  box-shadow: none !important;
}

.world-column-dialog::backdrop { background: rgba(4, 6, 10, 0.78); }
.world-column-dialog-card { margin: 0 auto; outline: none !important; }
.world-column-dialog:focus,
.world-column-dialog:focus-visible,
.world-column-dialog-card:focus,
.world-column-dialog-close:focus,
.world-column-dialog-close:focus-visible {
  outline: none !important;
  box-shadow: none !important;
}

.world-column-tabs b,
.world-column-dialog-tabs b,
.manager-archive-tabs b,
.liquid-swipe-tabs > button[role="tab"] b,
.liquid-swipe-tabs > button[role="tab"] span {
  white-space: nowrap;
}

.world-column-tabs b,
.world-column-dialog-tabs b,
.manager-archive-tabs b,
.liquid-swipe-tabs > button[role="tab"] b,
.liquid-swipe-tabs > button[role="tab"] span,
.other-card-copy b,
.other-card-copy i,
.dossier-jump b,
.manager-pagination b,
.manager-display-name,
.manager-facts dd,
.form-pickup-copy em,
.rider-person {
  overflow-wrap: normal !important;
  word-break: keep-all;
  line-break: strict;
}

/* Long display names need to wrap independently from the compact UI labels
   above. Keeping these headings in the same keep-all rule caused names to
   overflow or collide with artwork on narrow screens. */
.form-pickup-copy,
.rider-copy-block,
.rider-detail {
  min-width: 0;
}

.form-pickup-copy h2,
.rider-detail h3 {
  max-width: 100%;
  overflow-wrap: anywhere !important;
  word-break: normal;
  line-break: strict;
  text-wrap: balance;
}

.manager-pagination-spacer,
.manager-pagination > .is-empty {
  visibility: hidden;
  pointer-events: none;
}

.world-column-tabs.liquid-swipe-tabs > button[role="tab"],
.world-column-dialog-tabs.liquid-swipe-tabs > button[role="tab"] {
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  grid-template-columns: none;
  text-align: center;
  padding: 10px 8px;
}

.world-column-tabs b,
.world-column-dialog-tabs b {
  width: 100%;
  text-align: center;
}

.rider-dossier-open.ios-slide-open {
  --slide-accent: var(--rider-tone, #67d8ff);
  position: relative;
  width: min(100%, 240px);
  margin-top: 22px;
}

.rider-dossier-open:focus,
.rider-dossier-open:focus-visible {
  outline: none;
}

.dossier-jump a,
.dossier-jump span {
  min-width: 0;
  flex: 1 1 132px;
  padding: 10px 12px 12px;
}

.manager-facts dd {
  padding-right: 4px;
}

br.tab-br { display: none; }

.dante-archive.is-glitching { animation: danteCardGlitch 0.42s steps(2, end); }

.dante-denied-dialog { outline: none !important; }
.dante-denied-inner.is-slam { animation: danteNoSlam 0.55s cubic-bezier(0.16, 1, 0.3, 1); }

.dante-no-stack { position: relative; }
.dante-no-ghost {
  position: absolute;
  inset: 0;
  opacity: 0.28;
  pointer-events: none;
}
.dante-no-ghost.is-offset {
  transform: translate(10px, -6px);
  color: rgba(80, 180, 255, 0.45);
}

.dossier-jump {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  width: min(1100px, calc(100% - 40px));
  margin: 0 auto 72px;
}

.dossier-jump a,
.dossier-jump span {
  display: grid;
  min-width: 108px;
  padding: 10px 12px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 14px;
  color: inherit;
  text-decoration: none;
}

.dossier-jump a.is-current {
  border-color: rgba(255, 255, 255, 0.38);
  background: rgba(255, 255, 255, 0.06);
}

.dossier-jump span.is-locked { opacity: 0.45; }
.dossier-jump small {
  color: rgba(244, 246, 251, 0.45);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.18em;
}
.dossier-jump b { font-size: 13px; font-weight: 600; }
.dossier-jump a:focus,
.dossier-jump a:focus-visible { outline: none; }

.manager-display-name b {
  display: inline;
  margin-left: 0.18em;
  font-weight: 700;
}

.rider-record-heading > small {
  display: block;
  margin-top: 8px;
  color: rgba(244, 246, 251, 0.58);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.rider-form-gallery {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  width: min(1100px, calc(100% - 40px));
  margin: 28px auto 0;
}

.form-pickup {
  width: min(1100px, calc(100% - 40px));
  margin: 24px auto 64px;
}

.form-pickup-card {
  display: grid;
  grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--manager-accent, #78b69b) 34%, transparent);
  border-radius: 22px 48px 28px 16px;
  background: linear-gradient(145deg, rgba(12, 14, 20, 0.98), rgba(6, 8, 12, 0.95));
}

.form-pickup-visual {
  position: relative;
  min-height: 280px;
  overflow: hidden;
  background: #05070b;
}

.form-pickup-visual img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.form-pickup-visual > span {
  position: absolute;
  top: 18px;
  left: 18px;
  z-index: 2;
  color: #fff;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.28em;
}

.form-pickup-plus {
  position: absolute;
  z-index: 6;
  right: 18px;
  bottom: 18px;
  display: grid;
  place-items: center;
  width: 56px;
  height: 56px;
  padding: 0;
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  color: #fff;
  background: color-mix(in srgb, var(--manager-accent, #78b69b) 82%, #000);
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
  cursor: pointer;
}

.form-pickup-plus span { font-size: 30px; font-weight: 300; line-height: 1; }
.form-pickup-plus:focus,
.form-pickup-plus:focus-visible { outline: none; }
