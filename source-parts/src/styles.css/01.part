@import "tailwindcss";

@theme {
  --color-void: #000000;
  --color-ice: #9fd4ff;
  --color-ice-dim: #4a7eaa;
  --color-gold: #d4b056;
  --color-gold-bright: #f0d78a;
  --color-metal: #e8eef8;
  --color-muted: #8b8b96;
  --color-fg: #e8eef8;
  --font-display: "Cinzel", serif;
  --font-sans: "Noto Sans JP", "Hiragino Sans", system-ui, sans-serif;
}

@layer base {
  html,
  body,
  #app {
    background: #000;
    color: var(--color-fg);
    min-height: 100%;
    height: 100%;
  }

  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    color-scheme: dark;
    touch-action: manipulation;
    -ms-touch-action: manipulation;
  }

  body {
    font-family: var(--font-sans);
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: manipulation;
  }

  button:not(:disabled),
  [role="button"]:not(:disabled) {
    cursor: pointer;
  }
}

/* ── Cinematic stage ───────────────────────────────────────── */

.cine-stage {
  --seq: 5.8s;
  position: relative;
  isolation: isolate;
  contain: layout paint style;
  width: 100%;
  height: 100dvh;
  overflow: hidden;
  background: #000;
  color: var(--color-fg);
}

.cine-camera {
  position: absolute;
  z-index: 0;
  inset: -3.5%;
  overflow: hidden;
  pointer-events: none;
  transform: scale(1.035) translate3d(0, 0, 0);
  transform-origin: 50% 50%;
  will-change: transform;
}

.is-playing .cine-camera {
  animation: cinematic-camera-path var(--seq) cubic-bezier(0.2, 0.72, 0.2, 1) both;
}

.is-complete .cine-camera {
  transform: scale(1.018) translate3d(0, 0, 0);
}

.cine-atmosphere {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  filter: brightness(0.42) saturate(1.15);
  transform: scale(1.06);
  will-change: opacity, transform;
  pointer-events: none;
}

.is-playing .cine-atmosphere {
  animation: atm-in 2.05s cubic-bezier(0.22, 1, 0.36, 1) 0.08s forwards;
}

.is-complete .cine-atmosphere {
  animation: none;
  opacity: 0.42;
  filter: brightness(0.4) saturate(1.15);
  transform: scale(1);
}

.cine-light-field {
  position: absolute;
  z-index: 1;
  inset: 8%;
  pointer-events: none;
  opacity: 0;
  transform: scale(0.9);
  background:
    radial-gradient(circle at 34% 48%, rgb(74 137 214 / 0.2), transparent 30%),
    radial-gradient(circle at 68% 52%, rgb(212 176 86 / 0.14), transparent 28%),
    radial-gradient(ellipse at center, rgb(159 212 255 / 0.09), transparent 58%);
  will-change: opacity, transform;
}

.is-playing .cine-light-field {
  animation: light-field-in 5.1s cubic-bezier(0.16, 1, 0.3, 1) 0.18s forwards;
}

.is-complete .cine-light-field {
  opacity: 0.52;
  transform: scale(1.04);
}

.cine-depth-field {
  position: absolute;
  z-index: 2;
  inset: 0;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  transform: translateZ(0) scale(0.9);
  transform-origin: 50% 50%;
  will-change: opacity, transform;
}

.is-playing .cine-depth-field {
  animation: depth-field-reveal 4.9s cubic-bezier(0.16, 1, 0.3, 1) 0.16s both;
}

.is-complete .cine-depth-field {
  opacity: 0.38;
  transform: scale(1);
}

.cine-depth-grid {
  position: absolute;
  inset: -18%;
  opacity: 0.58;
  background:
    repeating-radial-gradient(circle at 50% 50%, transparent 0 7.8%, rgb(148 213 255 / 0.1) 8% 8.08%, transparent 8.3% 15.8%),
    repeating-conic-gradient(from 4deg at 50% 50%, transparent 0deg 14.4deg, rgb(219 187 112 / 0.075) 14.7deg 14.82deg, transparent 15.05deg 30deg);
  -webkit-mask-image: radial-gradient(circle at center, transparent 0 10%, #000 26% 72%, transparent 91%);
  mask-image: radial-gradient(circle at center, transparent 0 10%, #000 26% 72%, transparent 91%);
  transform: rotate(-5deg) scale(0.88);
  will-change: transform;
}

.is-playing .cine-depth-grid {
  animation: depth-grid-drift 5.8s cubic-bezier(0.18, 0.8, 0.2, 1) both;
}

.cine-aperture {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(84vmin, 860px);
  aspect-ratio: 1;
  border-radius: 50%;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.54) rotate(-18deg);
  will-change: opacity, transform;
}

.cine-aperture::before,
.cine-aperture::after,
.cine-aperture > i {
  content: "";
  position: absolute;
  border-radius: 50%;
}

.cine-aperture::before {
  inset: 1%;
  border: 1px solid rgb(163 222 255 / 0.16);
  background: repeating-conic-gradient(from 9deg, transparent 0deg 20deg, rgb(159 212 255 / 0.2) 20.3deg 20.65deg, transparent 21deg 30deg);
  -webkit-mask-image: radial-gradient(circle, transparent 0 73%, #000 73.4% 74%, transparent 74.4%);
  mask-image: radial-gradient(circle, transparent 0 73%, #000 73.4% 74%, transparent 74.4%);
}

.cine-aperture::after {
  inset: 13%;
  border: 1px solid rgb(232 204 136 / 0.18);
  box-shadow: inset 0 0 32px rgb(122 194 236 / 0.05), 0 0 38px rgb(219 181 100 / 0.04);
}

.cine-aperture > i {
  inset: 21%;
  border: 1px solid rgb(179 226 255 / 0.2);
}

.cine-aperture > i:nth-child(2) {
  inset: 29%;
  border-color: rgb(240 215 138 / 0.22);
  border-style: dashed;
}

.cine-aperture > i:nth-child(3) {
  inset: 37%;
  border-color: rgb(255 255 255 / 0.2);
  box-shadow: 0 0 18px rgb(159 212 255 / 0.12);
}

.is-playing .cine-aperture {
  animation: aperture-assembly 3.4s cubic-bezier(0.14, 0.86, 0.18, 1) 0.16s both;
}

.is-complete .cine-aperture {
  opacity: 0.36;
  transform: translate(-50%, -50%) scale(1) rotate(0);
}

.cine-orbit {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(108vw, 1240px);
  height: min(34vw, 390px);
  border: 1px solid rgb(159 212 255 / 0.12);
  border-radius: 50%;
  opacity: 0;
  transform: translate(-50%, -50%) rotate(-8deg) scale(0.72);
  box-shadow: 0 0 28px rgb(77 139 194 / 0.05);
  will-change: opacity, transform;
}

.cine-orbit::before,
.cine-orbit::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 7px;
  aspect-ratio: 1;
  border-radius: 50%;
  background: #dff4ff;
  box-shadow: 0 0 14px rgb(159 212 255 / 0.85), 0 0 28px rgb(159 212 255 / 0.38);
}

.cine-orbit::before { left: 8%; }
.cine-orbit::after { right: 11%; }

.cine-orbit-b {
  width: min(94vw, 1080px);
  height: min(27vw, 310px);
  border-color: rgb(240 215 138 / 0.13);
  transform: translate(-50%, -50%) rotate(64deg) scale(0.68);
}

.cine-orbit-b::before,
.cine-orbit-b::after {
  background: #fff2c6;
  box-shadow: 0 0 14px rgb(240 215 138 / 0.75), 0 0 28px rgb(212 176 86 / 0.3);
}

.is-playing .cine-orbit-a {
  animation: orbit-a-lock 3.9s cubic-bezier(0.16, 1, 0.3, 1) 0.42s both;
}

.is-playing .cine-orbit-b {
  animation: orbit-b-lock 4.4s cubic-bezier(0.16, 1, 0.3, 1) 0.58s both;
}

.is-complete .cine-orbit-a {
  opacity: 0.3;
  transform: translate(-50%, -50%) rotate(5deg) scale(1);
}

.is-complete .cine-orbit-b {
  opacity: 0.24;
  transform: translate(-50%, -50%) rotate(74deg) scale(1);
}

.cine-prism-field {
  position: absolute;
  inset: 0;
}

.cine-prism-field > i {
  position: absolute;
  width: 1px;
  height: clamp(38px, 8vw, 112px);
  border-radius: 50%;
  background: linear-gradient(180deg, transparent, rgb(222 243 255 / 0.68), rgb(112 191 242 / 0.16), transparent);
  box-shadow: 0 0 8px rgb(159 212 255 / 0.2);
  opacity: 0;
  transform: rotate(24deg) scaleY(0.3);
  transform-origin: center;
  will-change: opacity, transform;
}

.cine-prism-field > i:nth-child(1) { top: 14%; left: 11%; }
.cine-prism-field > i:nth-child(2) { top: 22%; left: 25%; height: 58px; }
.cine-prism-field > i:nth-child(3) { top: 10%; right: 21%; transform: rotate(-31deg) scaleY(0.3); }
.cine-prism-field > i:nth-child(4) { top: 25%; right: 8%; height: 82px; transform: rotate(-18deg) scaleY(0.3); }
.cine-prism-field > i:nth-child(5) { bottom: 18%; left: 8%; transform: rotate(-24deg) scaleY(0.3); }
.cine-prism-field > i:nth-child(6) { bottom: 9%; left: 24%; height: 68px; transform: rotate(34deg) scaleY(0.3); }
.cine-prism-field > i:nth-child(7) { right: 26%; bottom: 12%; transform: rotate(-36deg) scaleY(0.3); }
.cine-prism-field > i:nth-child(8) { right: 9%; bottom: 24%; height: 54px; transform: rotate(22deg) scaleY(0.3); }
.cine-prism-field > i:nth-child(9) { top: 48%; left: 4%; height: 46px; transform: rotate(72deg) scaleY(0.3); }
.cine-prism-field > i:nth-child(10) { top: 42%; right: 4%; height: 48px; transform: rotate(-68deg) scaleY(0.3); }
.cine-prism-field > i:nth-child(11) { top: 7%; left: 47%; height: 42px; transform: rotate(4deg) scaleY(0.3); }
.cine-prism-field > i:nth-child(12) { bottom: 5%; left: 53%; height: 44px; transform: rotate(-3deg) scaleY(0.3); }

.is-playing .cine-prism-field > i {
  animation: prism-signal 2.4s ease-out 0.72s both;
}

.is-playing .cine-prism-field > i:nth-child(2n) { animation-delay: 1.06s; }
.is-playing .cine-prism-field > i:nth-child(3n) { animation-delay: 1.44s; }
.is-playing .cine-prism-field > i:nth-child(4n) { animation-delay: 1.86s; }

.cine-impact-bloom {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(88vw, 1060px);
  height: min(44vw, 530px);
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.22);
  will-change: opacity, transform;
}

.cine-impact-bloom::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgb(255 255 255 / 0.66) 0, rgb(178 226 255 / 0.28) 12%, rgb(212 176 86 / 0.12) 30%, transparent 66%);
  filter: blur(2px);
}

.cine-impact-bloom > i {
  position: absolute;
  inset: 12%;
  border: 1px solid rgb(197 232 255 / 0.36);
  border-radius: 50%;
  opacity: 0;
}

.cine-impact-bloom > i:nth-child(2) {
  inset: 24%;
  border-color: rgb(240 215 138 / 0.32);
}

.is-playing .cine-impact-bloom {
  animation: impact-bloom 1.35s cubic-bezier(0.16, 0.82, 0.18, 1) 1.42s both;
}

.is-playing .cine-impact-bloom > i:first-child {
  animation: impact-ring 1.1s ease-out 1.48s both;
}

.is-playing .cine-impact-bloom > i:nth-child(2) {
  animation: impact-ring 1.05s ease-out 1.62s both;
}

.is-complete .cine-impact-bloom,
.is-complete .cine-prism-field {
  display: none;
}

.cine-scanline {
  position: absolute;
  z-index: 7;
  top: 0;
  right: -8%;
  left: -8%;
  height: 16vh;
  pointer-events: none;
  opacity: 0;
  transform: translate3d(0, -24vh, 0);
  background: linear-gradient(180deg, transparent, rgb(159 212 255 / 0.12), rgb(255 255 255 / 0.18), transparent);
  mix-blend-mode: screen;
  will-change: opacity, transform;
}

.is-playing .cine-scanline {
  animation: cinematic-scan 3.9s cubic-bezier(0.45, 0, 0.25, 1) 0.5s forwards;
}

.cine-flare {
  position: absolute;
  z-index: 3;
  top: 50%;
  left: 50%;
  width: min(92vw, 980px);
  height: 3px;
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%, -50%) scaleX(0.18);
  background: linear-gradient(90deg, transparent, rgb(159 212 255 / 0.38), #fff, rgb(240 215 138 / 0.4), transparent);
  box-shadow: 0 0 34px rgb(159 212 255 / 0.32), 0 0 86px rgb(212 176 86 / 0.16);
  will-change: opacity, transform;
}

.is-playing .cine-flare {
  animation: cinematic-flare 5.5s ease-out 0.18s both;
}

.cine-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 6;
  background: radial-gradient(
    ellipse at center,
    transparent 38%,
    rgba(0, 0, 0, 0.55) 78%,
    #000 100%
  );
}

.cine-grain {
  position: absolute;
  inset: -8%;
  z-index: 8;
  pointer-events: none;
  opacity: 0.06;
  mix-blend-mode: overlay;
  background-image: url("/noise.png");
  background-size: 320px 320px;
  animation: grain-shift 0.7s steps(2) infinite;
  will-change: transform;
}

.cine-letterbox {
  position: absolute;
  left: 0;
  right: 0;
  height: max(7.5vh, 42px);
  background: #000;
  z-index: 24;
  pointer-events: none;
}

.cine-letterbox.top {
  top: 0;
  transform: translateY(-100%);
}

.cine-letterbox.bottom {
  bottom: 0;
  transform: translateY(100%);
}

.is-playing .cine-letterbox,
.is-complete .cine-letterbox {
  animation: bar-in 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.05s forwards;
}

.is-complete .cine-letterbox {
  animation: none;
  transform: translateY(0);
}

.cine-hud {
  position: absolute;
  left: 50%;
  top: 50%;
  width: min(72vw, 820px);
  aspect-ratio: 1;
  transform: translate(-50%, -50%) scale(0.92);
  opacity: 0;
  z-index: 2;
  pointer-events: none;
  will-change: opacity, transform;
}

.is-playing .cine-hud {
  animation: hud-in 3.2s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
}

.is-complete .cine-hud {
  animation: none;
  opacity: 0.22;
  transform: translate(-50%, -50%) scale(1);
}

.cine-hud-spin {
  transform-origin: 50% 50%;
  animation: spin-slow 48s linear infinite;
}

.cine-hud-spin-rev {
  transform-origin: 50% 50%;
  animation: spin-slow 72s linear infinite reverse;
}

.cine-hud-orbits {
  opacity: 0.38;
  transform-origin: 50% 50%;
  animation: hud-orbit-precession 24s linear infinite;
}

.cine-hud-reticle {
  opacity: 0.52;
  transform-origin: 50% 50%;
}

.is-playing .cine-hud-reticle {
  animation: hud-reticle-lock 2.35s cubic-bezier(0.16, 1, 0.3, 1) 0.48s both;
}

.cine-stack {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: grid;
  place-items: center;
  pointer-events: none;
}

.cine-title-lockup {
  position: relative;
  width: min(1120px, 92vw, calc(78vh * 1.5));
  aspect-ratio: 3 / 2;
}

.cine-logo-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  aspect-ratio: 3 / 2;
  transform: translateY(6px) scale(0.9);
  opacity: 0;
  clip-path: inset(48% 0 48% 0);
  filter: none;
  will-change: opacity, transform, clip-path;
}

.is-playing .cine-logo-wrap {
  animation: logo-emerge 3.15s cubic-bezier(0.22, 1, 0.36, 1) 0.34s forwards;
}

.is-complete .cine-logo-wrap {
  opacity: 1;
  transform: scale(1);
  clip-path: inset(0);
  filter: none;
}

.cine-logo-glow,
.cine-logo-echo,
.cine-logo-core,
.cine-logo-shine {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.cine-logo-glow {
  opacity: 0;
  filter: blur(16px) saturate(1.3) brightness(1.25);
  transform: scale(1.03);
  pointer-events: none;
}

.is-playing .cine-logo-glow {
  animation: logo-glow 3.15s cubic-bezier(0.22, 1, 0.36, 1) 0.34s forwards;
}

.is-complete .cine-logo-glow {
  opacity: 0;
  visibility: hidden;
  animation: none;
}

.cine-logo-echo {
  z-index: 0;
  opacity: 0;
  pointer-events: none;
  mix-blend-mode: screen;
  will-change: opacity, transform, clip-path;
}

.cine-logo-echo-ice {
  filter: brightness(1.65) saturate(0.7) sepia(0.15) hue-rotate(158deg) blur(0.35px);
  transform: translate3d(-13px, 0, 0) scale(1.008);
  clip-path: inset(0 45% 0 0);
}

.cine-logo-echo-gold {
  filter: brightness(1.48) saturate(1.45) sepia(0.52) hue-rotate(352deg) blur(0.35px);
  transform: translate3d(13px, 0, 0) scale(1.008);
  clip-path: inset(0 0 0 45%);
}

.is-playing .cine-logo-echo-ice {
  animation: logo-echo-ice 1.25s cubic-bezier(0.16, 1, 0.3, 1) 1.05s both;
}

.is-playing .cine-logo-echo-gold {
  animation: logo-echo-gold 1.25s cubic-bezier(0.16, 1, 0.3, 1) 1.05s both;
}

.is-complete .cine-logo-echo {
  display: none;
}

.cine-logo-core {
  opacity: 1;
  filter: none;
  transform: translateZ(0);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

.cine-logo-shine {
  background: linear-gradient(
    108deg,
    transparent 32%,
    rgb(159 212 255 / 0) 42%,
    rgb(255 255 255 / 0.55) 50%,
    rgb(240 215 138 / 0.28) 56%,
    transparent 68%
  );
  background-size: 220% 100%;
  background-position: 120% 0;
  mix-blend-mode: overlay;
  -webkit-mask-image: url("/logo-title.jpg");
  mask-image: url("/logo-title.jpg");
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  opacity: 0;
}

.is-playing .cine-logo-shine {
  animation: shine-sweep 1s ease-in-out 2.15s forwards;
}

.is-complete .cine-logo-shine {
  animation: none;
  opacity: 0;
}

.cine-logo-frame {
  position: absolute;
  z-index: 3;
  inset: 8% 6%;
  pointer-events: none;
  opacity: 0;
  transform: scale(1.06);
  background:
    linear-gradient(var(--color-ice), var(--color-ice)) left top / 34px 1px no-repeat,
    linear-gradient(var(--color-ice), var(--color-ice)) left top / 1px 34px no-repeat,
    linear-gradient(var(--color-gold), var(--color-gold)) right top / 34px 1px no-repeat,
    linear-gradient(var(--color-gold), var(--color-gold)) right top / 1px 34px no-repeat,
    linear-gradient(var(--color-gold), var(--color-gold)) left bottom / 34px 1px no-repeat,
    linear-gradient(var(--color-gold), var(--color-gold)) left bottom / 1px 34px no-repeat,
    linear-gradient(var(--color-ice), var(--color-ice)) right bottom / 34px 1px no-repeat,
    linear-gradient(var(--color-ice), var(--color-ice)) right bottom / 1px 34px no-repeat;
}

.is-playing .cine-logo-frame {
  animation: logo-frame-lock 1.1s cubic-bezier(0.16, 1, 0.3, 1) 1.95s forwards;
}

.is-complete .cine-logo-frame {
  opacity: 0.52;
  transform: scale(1);
}

.cine-title-caption {
  position: absolute;
  z-index: 4;
  right: 10%;
  bottom: 7%;
  left: 10%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(12px, 2.6vw, 32px);
  color: rgb(232 238 248 / 0.7);
  font: 600 clamp(0.48rem, 0.85vw, 0.68rem)/1 var(--font-display);
  letter-spacing: 0.36em;
  text-align: center;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(10px);
}

.cine-title-caption i {
  width: clamp(34px, 7vw, 88px);
  height: 1px;
  background: linear-gradient(90deg, transparent, rgb(240 215 138 / 0.72), transparent);
}

.is-playing .cine-title-caption {
  animation: title-caption-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 2.65s forwards;
}

.is-complete .cine-title-caption {
  opacity: 1;
  transform: translateY(0);
}

.cine-line {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  height: 1px;
  width: 0;
  transform: translate(-50%, -50%);
  background: linear-gradient(
    90deg,
    transparent,
    var(--color-gold),
    transparent
  );
  opacity: 0.85;
  pointer-events: none;
}

.is-playing .cine-line {
  animation:
    line-grow 1.05s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards,
    line-fade 0.7s ease 1.3s forwards;
}

.is-complete .cine-line {
  animation: none;
  opacity: 0;
  width: 0;
}

.cine-sequence-meta {
  position: absolute;
  z-index: 27;
  top: max(1.15rem, env(safe-area-inset-top));
  right: max(1.25rem, env(safe-area-inset-right));
  left: max(1.25rem, env(safe-area-inset-left));
  display: flex;
  justify-content: space-between;
  color: rgb(159 212 255 / 0.54);
  font: 600 0.52rem/1 var(--font-sans);
  letter-spacing: 0.28em;
  pointer-events: none;
  opacity: 0;
}

.is-playing .cine-sequence-meta {
  animation: sequence-meta-in 0.85s ease 0.28s forwards;
}

.is-complete .cine-sequence-meta {
  opacity: 0.62;
}

.cine-progress {
  position: absolute;
  left: max(1.25rem, env(safe-area-inset-left));
  right: max(1.25rem, env(safe-area-inset-right));
  bottom: max(1rem, env(safe-area-inset-bottom));
  height: 1px;
  z-index: 26;
  pointer-events: none;
  background: rgb(159 212 255 / 0.16);
  opacity: 0.7;
}

.cine-progress > span {
  position: absolute;
  inset: 0;
  transform: scaleX(0);
  transform-origin: left center;
  background: linear-gradient(90deg, var(--color-ice-dim), var(--color-ice), var(--color-gold));
  box-shadow: 0 0 12px rgb(159 212 255 / 0.32);
}

.cine-progress > i {
  position: absolute;
  top: 50%;
  width: 5px;
  height: 5px;
  border: 1px solid rgb(159 212 255 / 0.38);
  border-radius: 50%;
  background: #05070b;
  opacity: 0.5;
  transform: translate(-50%, -50%) scale(0.7);
}

.cine-progress > i:nth-of-type(1) { left: 0; }
.cine-progress > i:nth-of-type(2) { left: 33.333%; }
.cine-progress > i:nth-of-type(3) { left: 66.666%; }
.cine-progress > i:nth-of-type(4) { left: 100%; }

.is-playing .cine-progress > span {
  animation: progress-fill var(--seq) linear forwards;
}

.is-playing .cine-progress > i:nth-of-type(1) { animation: progress-marker 0.4s ease 0.2s forwards; }
.is-playing .cine-progress > i:nth-of-type(2) { animation: progress-marker 0.4s ease 1.95s forwards; }
.is-playing .cine-progress > i:nth-of-type(3) { animation: progress-marker 0.4s ease 3.85s forwards; }
.is-playing .cine-progress > i:nth-of-type(4) { animation: progress-marker 0.4s ease 5.4s forwards; }

.is-complete .cine-progress {
  opacity: 0;
  transition: opacity 0.8s ease;
}

.is-complete .cine-progress > span {
  transform: scaleX(1);
}

.cine-cue {
  position: absolute;
  z-index: 27;
  left: max(1.25rem, env(safe-area-inset-left));
  bottom: max(7.5vh, 54px);
  width: min(250px, 46vw);
  height: 16px;
  pointer-events: none;
  color: rgb(232 238 248 / 0.62);
  font: 600 0.5rem/1 var(--font-sans);
  letter-spacing: 0.3em;
}

.cine-cue span {
  position: absolute;
  inset: 0;
  opacity: 0;
  transform: translateY(5px);
}

.is-playing .cine-cue span:nth-child(1) { animation: cue-phase 1.2s ease 0.34s both; }
.is-playing .cine-cue span:nth-child(2) { animation: cue-phase 1.35s ease 1.65s both; }
.is-playing .cine-cue span:nth-child(3) { animation: cue-phase 1.5s ease 3.15s both; }

.is-complete .cine-cue {
  opacity: 0;
}

.cine-chrome {
  position: absolute;
  z-index: 30;
  opacity: 0;
  pointer-events: none;
  transform: translateY(10px) scale(0.985);
  filter: blur(4px);
}

.is-complete .cine-chrome {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0) scale(1);
  filter: blur(0);
  transition: opacity 0.45s ease 0.05s, transform 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.05s, filter 0.35s ease 0.05s;
}

.cine-skip {
  position: absolute;
  right: max(1rem, env(safe-area-inset-right));
  bottom: max(7.5vh, 52px);
  z-index: 30;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  min-width: 124px;
  min-height: 48px;
  padding: 0.6rem 0.85rem 0.6rem 1rem;
  border: 1px solid rgb(159 212 255 / 0.36);
  border-radius: 999px;
  color: rgb(232 238 248 / 0.88);
  background: rgb(5 8 14 / 0.78);
  box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), 0 8px 28px rgb(0 0 0 / 0.32);
  opacity: 0;
  pointer-events: none;
  transform: translateY(4px);
  transition: color 160ms ease, border-color 160ms ease, background 160ms ease, transform 160ms ease;
}

.cine-skip kbd {
  display: inline-grid;
  place-items: center;
  min-width: 30px;
  min-height: 22px;
  padding: 0 0.35rem;
  border: 1px solid rgb(255 255 255 / 0.16);
  border-radius: 6px;
  color: rgb(232 238 248 / 0.58);
  background: rgb(255 255 255 / 0.05);
  font: 600 0.56rem/1 var(--font-sans);
  letter-spacing: 0.08em;
}

.is-playing .cine-skip {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
  transition: opacity 0.25s ease 0.12s, color 160ms ease, border-color 160ms ease, background 160ms ease, transform 0.25s ease 0.12s;
}

.cine-skip:hover {
  border-color: rgb(159 212 255 / 0.72);
  color: #fff;
  background: rgb(10 18 30 / 0.9);
}

.cine-skip:focus-visible {
  outline: 2px solid var(--color-ice);
  outline-offset: 3px;
}

.cine-always {
  position: absolute;
  top: max(3rem, calc(env(safe-area-inset-top) + 2.2rem));
  left: max(0.75rem, env(safe-area-inset-left));
  z-index: 30;
  opacity: 0;
  pointer-events: none;
}

.is-playing .cine-always,
.is-complete .cine-always {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0.3s ease 0.2s;
}

.cine-replay-slot {
  bottom: max(9vh, 64px);
}

.cine-particles {
  z-index: 5;
}

.cine-login-glow {
  background: radial-gradient(
    ellipse at center,
    rgb(45 80 140 / 0.25),
    transparent 62%
  );
}

.cine-kicker {
  font-family: var(--font-display);
  font-size: 0.65rem;
  letter-spacing: 0.42em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--color-gold-bright) 80%, transparent);
}

.cine-btn {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  font-family: var(--font-display);
  letter-spacing: 0.28em;
  text-transform: uppercase;
  font-size: 0.68rem;
  color: var(--color-gold-bright);
  border: 1px solid rgb(255 255 255 / 0.28);
  border-radius: 999px;
  background:
    linear-gradient(180deg, rgb(255 255 255 / 0.22) 0%, rgb(255 255 255 / 0.04) 42%, rgb(212 176 86 / 0.1) 100%),
    rgb(8 10 16 / 0.38);
  -webkit-backdrop-filter: blur(22px) saturate(185%);
  backdrop-filter: blur(22px) saturate(185%);
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.55),
    inset 0 -1px 0 rgb(212 176 86 / 0.18),
    0 10px 28px rgb(0 0 0 / 0.38),
    0 0 0 0.5px rgb(255 255 255 / 0.12);
  padding: 0.7rem 1.45rem;
  min-height: 44px;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
  transition:
    border-color 180ms ease,
    color 180ms ease,
    background 180ms ease,
    transform 160ms ease,
    box-shadow 180ms ease;
}

.cine-btn::before {
  content: "";
  position: absolute;
  inset: 0 auto auto 0;
  width: 100%;
  height: 52%;
  pointer-events: none;
  border-radius: inherit;
  background: linear-gradient(
    180deg,
    rgb(255 255 255 / 0.38),
    rgb(255 255 255 / 0.08) 55%,
    transparent
  );
  opacity: 0.9;
}

.cine-btn > * {
  position: relative;
  z-index: 1;
}

.cine-btn:hover {
  border-color: rgb(240 215 138 / 0.7);
  color: #fff8e6;
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.65),
    inset 0 -1px 0 rgb(212 176 86 / 0.28),
    0 14px 34px rgb(0 0 0 / 0.42),
    0 0 24px rgb(212 176 86 / 0.18);
}

.cine-btn:active {
  transform: scale(0.97);
}

.cine-btn:focus-visible,
.cine-ghost:focus-visible {
  outline: 2px solid var(--color-ice);
  outline-offset: 3px;
}

.cine-ghost {
  font-family: var(--font-sans);
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  color: rgb(232 238 248 / 0.55);
  background: transparent;
  border: none;
  min-height: 44px;
  padding: 0.4rem 0.7rem;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
  transition: color 160ms ease;
}

.cine-btn:disabled,
.cine-ghost:disabled {
  cursor: default;
  pointer-events: none;
}

.cine-ghost:hover {
  color: var(--color-ice);
}

.cine-enter-hint {
  position: absolute;
