@import "tailwindcss";

@theme {
  --color-void: #000000;
  --color-ice: #9fd4ff;
  --color-ice-dim: #4a7eaa;
  --color-gold: #d4b056;
  --color-gold-bright: #f0d78a;
  --color-metal: #e8eef8;
  --color-muted: #8b8b96;
  --color-fg: #e8eef8;
  --font-display: "Cinzel", serif;
  --font-sans: "Noto Sans JP", "Hiragino Sans", system-ui, sans-serif;
}

/* Site-wide content protection. Editable controls retain cursor/selection
   ergonomics, while the capture guard blocks their clipboard operations. */
html,
body,
body * {
  -webkit-touch-callout: none !important;
  -webkit-user-select: none !important;
  user-select: none !important;
}

:where(input, textarea, [contenteditable="true"], [contenteditable="plaintext-only"]),
:where(input, textarea, [contenteditable="true"], [contenteditable="plaintext-only"]) * {
  -webkit-user-select: text !important;
  user-select: text !important;
}

/* ── Form archive route chrome and dive ─────────────────────── */
.archive-route-dive {
  z-index: 2147483000;
  overflow: hidden;
  isolation: isolate;
  background:
    radial-gradient(circle at 50% 48%, rgb(23 90 112 / 0.34), transparent 24%),
    radial-gradient(circle at 30% 18%, rgb(88 48 134 / 0.2), transparent 28%), #010205;
}

.archive-dive-space {
  position: absolute;
  z-index: 1;
  inset: -12%;
  opacity: 0.72;
  background:
    radial-gradient(
      circle at 50% 50%,
      transparent 0 5%,
      rgb(90 206 230 / 0.08) 16%,
      transparent 36%
    ),
    repeating-conic-gradient(
      from 6deg,
      transparent 0deg 6deg,
      rgb(125 220 255 / 0.055) 6.2deg 6.42deg,
      transparent 6.7deg 12deg
    );
  transform: scale(1.08);
  animation: archive-dive-space-rush 0.7s linear infinite;
}

.archive-route-dive.is-arriving .archive-dive-space {
  animation: archive-dive-space-arrive 0.52s cubic-bezier(0.12, 0.78, 0.08, 1) both;
}

.form-archive-page {
  --archive-cyan: #75ddff;
  --archive-violet: #9b83ff;
  --archive-gold: #e0ba66;
  isolation: isolate;
}

.form-archive-page iframe {
  position: relative;
  z-index: 1;
}

.form-archive-switcher.liquid-swipe-tabs {
  --liquid-shell-radius: 999px;
  position: fixed;
  z-index: 54;
  top: max(12px, calc(env(safe-area-inset-top) + 8px));
  left: 50%;
  display: grid;
  width: min(310px, calc(100vw - 148px));
  min-width: 220px;
  isolation: isolate;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  padding: 5px;
  overflow: visible;
  border: 0;
  border-radius: 999px;
  background: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  box-shadow: none;
  cursor: grab;
  touch-action: pan-y pinch-zoom;
  translate: -50% 0;
}

.form-archive-switcher.liquid-swipe-tabs > .liquid-rail-surface {
  border-color: rgb(207 235 255 / 0.2);
  background:
    radial-gradient(circle at 22% -12%, rgb(255 255 255 / 0.2), transparent 38%),
    radial-gradient(
      ellipse at 86% 118%,
      color-mix(in srgb, var(--liquid-current-accent) 10%, transparent),
      transparent 46%
    ),
    linear-gradient(
      132deg,
      rgb(255 255 255 / 0.075),
      transparent 34%,
      rgb(103 216 255 / 0.035) 63%,
      transparent 84%
    ),
    rgb(10 18 29 / 0.26);
  -webkit-backdrop-filter: blur(12px) saturate(155%) contrast(1.035);
  backdrop-filter: blur(12px) saturate(155%) contrast(1.035);
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.2),
    inset 1px 0 0 rgb(255 255 255 / 0.045),
    inset 0 -1px 0 rgb(132 203 255 / 0.055),
    0 14px 36px rgb(0 0 0 / 0.24);
}

.form-archive-switcher.liquid-swipe-tabs > .liquid-selection-lens {
  border-radius: 999px;
}

.form-archive-switcher.liquid-swipe-tabs > .liquid-selection-lens > .liquid-selection-surface {
  border-color: color-mix(in srgb, var(--liquid-current-accent) 52%, rgb(255 255 255 / 0.34));
}

.form-archive-switcher[data-liquid-dragging="true"] {
  cursor: grabbing;
}

.form-archive-switcher button {
  position: relative;
  z-index: 6;
  display: grid;
  min-width: 0;
  min-height: 44px;
  place-content: center;
  gap: 3px;
  overflow: hidden;
  border: 1px solid rgb(202 231 250 / 0.095);
  border-radius: 999px;
  background: transparent;
  color: rgb(188 205 217 / 0.68);
  touch-action: pan-y pinch-zoom;
  -webkit-touch-callout: none;
  user-select: none;
  transition:
    color 0.18s ease,
    text-shadow 0.18s ease,
    border-color 0.22s ease;
}

.form-archive-switcher[data-liquid-dragging="true"] button:active {
  transform: none;
}

.form-archive-switcher[data-liquid-dragging="true"] button[data-liquid-contact="true"] {
  color: #fff;
  text-shadow: 0 0 16px rgb(147 231 255 / 0.48);
}

.form-archive-switcher button[aria-selected="true"] {
  color: #fff;
  text-shadow: 0 0 14px rgb(117 221 255 / 0.32);
}

.form-archive-switcher button small {
  font: 700 0.48rem/1 var(--font-display);
  letter-spacing: 0.26em;
}

.form-archive-switcher button b {
  font: 600 0.72rem/1.1 var(--font-sans);
  letter-spacing: 0.12em;
}

.form-archive-switcher button:focus-visible {
  outline-color: var(--liquid-accent, var(--archive-cyan));
  outline-offset: -3px;
}

/* The archive route has no page scroll of its own. Keeping the gesture stream
   on this fixed rail prevents Chrome Android and embedded WebViews from
   handing a diagonal swipe to the iframe before the common rail can capture
   it. Other, scrollable rails retain the shared `pan-y` behavior. */
html[data-android-renderer] .form-archive-switcher.liquid-swipe-tabs,
html[data-android-renderer] .form-archive-switcher.liquid-swipe-tabs > button {
  touch-action: pan-y pinch-zoom;
  -ms-touch-action: pan-y;
  overscroll-behavior: contain;
}

.form-archive-page .side-panel-trigger.form-archive-menu-trigger {
  position: fixed;
  z-index: 62;
  top: max(14px, calc(env(safe-area-inset-top) + 8px));
  right: max(16px, calc(env(safe-area-inset-right) + 8px));
}

.form-archive-frame-status {
  position: fixed;
  z-index: 53;
  inset: 0;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 12px;
  background: rgb(2 2 7 / 0.86);
  color: rgb(225 238 247 / 0.76);
  font: 600 0.58rem/1 var(--font-display);
  letter-spacing: 0.3em;
  opacity: 1;
  pointer-events: none;
  transition:
    opacity 0.32s ease,
    visibility 0.32s;
}

.form-archive-frame-status.is-loaded {
  opacity: 0;
  visibility: hidden;
}

.form-archive-frame-status i {
  width: 36px;
  aspect-ratio: 1;
  border: 1px solid rgb(117 221 255 / 0.18);
  border-top-color: var(--archive-cyan);
  border-right-color: var(--archive-gold);
  border-radius: 50%;
  animation: archive-frame-spin 0.9s linear infinite;
}

.zeus-button[data-navigating="true"] {
  pointer-events: none;
  filter: brightness(1.08) saturate(1.08);
  transform: translate3d(-50%, -50%, 0) scale(1);
}

@keyframes archive-frame-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes archive-dive-space-rush {
  from {
    opacity: 0.4;
    transform: scale(0.64) rotate(-0.5deg);
  }
  48% {
    opacity: 0.78;
  }
  to {
    opacity: 0.18;
    transform: scale(1.42) rotate(0.7deg);
  }
}

@keyframes archive-dive-space-arrive {
  from {
    opacity: 0.7;
    transform: scale(1.08);
  }
  to {
    opacity: 0;
    transform: scale(2.2);
  }
}

@media (max-width: 560px) {
  .form-archive-switcher {
    left: max(12px, calc(env(safe-area-inset-left) + 8px));
    width: min(248px, calc(100vw - 104px - env(safe-area-inset-left) - env(safe-area-inset-right)));
    min-width: 0;
    translate: 0 0;
  }

  .form-archive-switcher button {
    min-height: 44px;
  }

  .form-archive-page .side-panel-trigger.form-archive-menu-trigger {
    right: max(10px, calc(env(safe-area-inset-right) + 8px));
  }
}

@media (prefers-reduced-motion: reduce) {
  .archive-dive-space,
  .form-archive-frame-status i {
    animation: none !important;
  }

  .form-archive-switcher > .liquid-rail-surface,
  .form-archive-switcher > .liquid-selection-lens,
  .form-archive-switcher .liquid-selection-surface,
  .form-archive-switcher button,
  .form-archive-frame-status,
  .zeus-button[data-navigating="true"] {
    transition-duration: 0.001ms !important;
  }
}

/* Route-level recovery surface. Kept independent from the world cascade so
   invalid deep links remain readable before route-specific CSS has loaded. */
.app-not-found {
  position: relative;
  display: grid;
  min-height: 100svh;
  place-content: center;
  gap: 14px;
  overflow: hidden;
  padding: max(32px, env(safe-area-inset-top)) max(22px, env(safe-area-inset-right))
    max(32px, env(safe-area-inset-bottom)) max(22px, env(safe-area-inset-left));
  background:
    radial-gradient(circle at 50% 28%, rgb(54 157 255 / 0.14), transparent 42%),
    linear-gradient(160deg, #071019, #020407 68%);
  color: #f3f7ff;
  text-align: center;
}

.app-not-found > span,
.app-not-found > p:first-of-type {
  margin: 0;
  color: rgb(113 211 255 / 0.72);
  font-family: var(--font-display);
  font-size: 0.68rem;
  letter-spacing: 0.24em;
}

.app-not-found h1 {
  margin: 4px 0;
  font-family: var(--font-sans);
  font-size: clamp(1.65rem, 7vw, 3.4rem);
  font-weight: 500;
  letter-spacing: -0.035em;
}

.app-not-found > p:last-of-type {
  max-width: 34rem;
  margin: 0 auto;
  color: rgb(231 238 249 / 0.68);
  font-size: clamp(0.88rem, 2.8vw, 1rem);
  line-height: 1.8;
}

.app-not-found a {
  display: inline-flex;
  min-height: 46px;
  align-items: center;
  justify-content: center;
  justify-self: center;
  margin-top: 12px;
  padding: 0 24px;
  border: 1px solid rgb(112 210 255 / 0.3);
  border-radius: 999px;
  background: rgb(82 166 224 / 0.1);
  color: #eff9ff;
  font-family: var(--font-display);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-decoration: none;
  transition:
    transform 180ms ease,
    background 180ms ease,
    border-color 180ms ease;
}

.app-not-found a:hover {
  border-color: rgb(112 210 255 / 0.62);
  background: rgb(82 166 224 / 0.18);
  transform: translateY(-2px);
}

.app-not-found a:focus-visible {
  outline: 2px solid #8fdcff;
  outline-offset: 4px;
}

@media (prefers-reduced-motion: reduce) {
  .app-not-found a {
    transition: none;
  }
}

/* The site is dark-only. Saying so under prefers-color-scheme as well (next
   to the color-scheme meta and the base rule below) tells browsers with a
   dark mode of their own, such as Samsung Internet, that the page already
   has one, so they do not re-darken its colours and artwork. */
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
  }
}

@layer base {
  html,
  body,
  #app {
    background: #000;
    color: var(--color-fg);
    min-height: 100%;
    height: 100%;
  }

  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    color-scheme: dark;
    touch-action: manipulation;
    -ms-touch-action: manipulation;
  }

  body {
    font-family: var(--font-sans);
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: manipulation;
  }

  /* Routed long-form pages can paint before their code-split stylesheet has
     finished evaluating. Promote the document scroller from the first DOM
     frame so iOS does not latch the initial gesture to the title screen's
     overflow lock. */
  body:has(.site-shell, .manager-page, .rider-archive-page) {
    height: auto;
    min-height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-y: auto;
    touch-action: pan-y pinch-zoom;
  }

  button:not(:disabled),
  [role="button"]:not(:disabled) {
    cursor: pointer;
  }
}

/* ── Cinematic stage ───────────────────────────────────────── */

.cine-stage {
  --seq: 7.2s;
  position: relative;
  isolation: isolate;
  contain: layout paint style;
  width: 100%;
  height: 100dvh;
  overflow: hidden;
  background: #000;
  color: var(--color-fg);
}

.cine-camera {
  position: absolute;
  z-index: 0;
  inset: -3.5%;
  overflow: hidden;
  pointer-events: none;
  transform: scale(1.035) translate3d(0, 0, 0);
  transform-origin: 50% 50%;
  will-change: transform;
}

.is-playing .cine-camera {
  animation: cinematic-camera-path var(--seq) cubic-bezier(0.2, 0.72, 0.2, 1) both;
}

.is-complete .cine-camera {
  transform: scale(1.018) translate3d(0, 0, 0);
}

.cine-atmosphere {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  filter: brightness(0.42) saturate(1.15);
  transform: scale(1.06);
  will-change: opacity, transform;
  pointer-events: none;
}

.is-playing .cine-atmosphere {
  animation: atm-in 2.05s cubic-bezier(0.22, 1, 0.36, 1) 0.08s forwards;
}

.is-complete .cine-atmosphere {
  animation: none;
  opacity: 0.42;
  filter: brightness(0.4) saturate(1.15);
  transform: scale(1);
}

.cine-light-field {
  position: absolute;
  z-index: 1;
  inset: 8%;
  pointer-events: none;
  opacity: 0;
  transform: scale(0.9);
  background:
    radial-gradient(circle at 34% 48%, rgb(74 137 214 / 0.2), transparent 30%),
    radial-gradient(circle at 68% 52%, rgb(212 176 86 / 0.14), transparent 28%),
    radial-gradient(ellipse at center, rgb(159 212 255 / 0.09), transparent 58%);
  will-change: opacity, transform;
}

.is-playing .cine-light-field {
  animation: light-field-in 5.1s cubic-bezier(0.16, 1, 0.3, 1) 0.18s forwards;
}

.is-complete .cine-light-field {
  opacity: 0.52;
  transform: scale(1.04);
}

/* Editorial scene typography -------------------------------------------------
   The opening logo remains the hero. These large, restrained marks establish
   changing chapters around it, borrowing the pacing of a premium product-film
   opener without introducing another raster layer or a full-screen filter. */
.cine-editorial {
  --editorial-inset-x: max(26px, 4.4vw);
  --editorial-inset-y: max(54px, 8.2vh);
  position: absolute;
  z-index: 3;
  inset: 0;
  contain: layout paint style;
  overflow: hidden;
  pointer-events: none;
}

.cine-editorial-frame {
  position: absolute;
  inset: var(--editorial-inset-y) var(--editorial-inset-x);
}

.cine-editorial-frame > i {
  position: absolute;
  display: block;
  background: linear-gradient(
    90deg,
    transparent,
    rgb(159 212 255 / 0.48) 20%,
    rgb(240 215 138 / 0.36) 76%,
    transparent
  );
  opacity: 0;
  backface-visibility: hidden;
}

.cine-editorial-frame-top,
.cine-editorial-frame-bottom {
  right: 0;
  left: 0;
  height: 1px;
  transform: scaleX(0);
}

.cine-editorial-frame-top {
  top: 0;
  transform-origin: 0 50%;
}

.cine-editorial-frame-bottom {
  bottom: 0;
  transform-origin: 100% 50%;
}

.cine-editorial-frame > .cine-editorial-frame-right,
.cine-editorial-frame > .cine-editorial-frame-left {
  top: 0;
  bottom: 0;
  width: 1px;
  background: linear-gradient(
    180deg,
    transparent,
    rgb(159 212 255 / 0.38) 24%,
    rgb(240 215 138 / 0.28) 72%,
    transparent
  );
  transform: scaleY(0);
}

.cine-editorial-frame-right {
  right: 0;
  transform-origin: 50% 0;
}

.cine-editorial-frame-left {
  left: 0;
  transform-origin: 50% 100%;
}

.is-playing .cine-editorial-frame-top {
  animation: editorial-frame-x 1.15s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
}

.is-playing .cine-editorial-frame-bottom {
  animation: editorial-frame-x 1.15s cubic-bezier(0.16, 1, 0.3, 1) 0.32s both;
}

.is-playing .cine-editorial-frame-right {
  animation: editorial-frame-y 1.05s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
}

.is-playing .cine-editorial-frame-left {
  animation: editorial-frame-y 1.05s cubic-bezier(0.16, 1, 0.3, 1) 0.64s both;
}

.is-complete .cine-editorial-frame > i {
  opacity: 0.24;
  transform: scale(1);
}

.cine-editorial-type {
  position: absolute;
  top: 50%;
  right: calc(var(--editorial-inset-x) + 1.5vw);
  left: calc(var(--editorial-inset-x) + 1.5vw);
  transform: translate3d(0, -50%, 0);
  text-align: center;
}

.cine-editorial-type::after {
  position: absolute;
  z-index: 2;
  top: 5%;
  bottom: 5%;
  left: 50%;
  width: clamp(80px, 13vw, 210px);
  content: "";
  background: linear-gradient(
    90deg,
    transparent,
    rgb(255 255 255 / 0.08),
    rgb(159 212 255 / 0.12),
    transparent
  );
  opacity: 0;
  transform: translate3d(-460%, 0, 0) skewX(-12deg);
}

.is-playing .cine-editorial-type::after {
  animation: editorial-mask-pass 1.15s cubic-bezier(0.2, 0.68, 0.18, 1) 1.02s both;
}

.cine-editorial-kicker,
.cine-editorial-caption {
  margin: 0;
  color: rgb(224 241 250 / 0.58);
  font: 600 clamp(0.44rem, 0.64vw, 0.62rem) / 1 var(--font-sans);
  letter-spacing: 0.34em;
  opacity: 0;
  transform: translate3d(0, 10px, 0);
}

.cine-editorial-kicker {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(12px, 2vw, 28px);
  margin-bottom: clamp(12px, 2vh, 24px);
}

.cine-editorial-kicker i {
  width: clamp(34px, 6vw, 90px);
  height: 1px;
  background: linear-gradient(90deg, var(--color-ice), var(--color-gold));
  transform: scaleX(0);
}

.cine-editorial-caption {
  margin-top: clamp(14px, 2.2vh, 28px);
  color: rgb(240 215 138 / 0.52);
  letter-spacing: 0.46em;
}

.is-playing .cine-editorial-kicker {
  animation: editorial-meta-in 1s cubic-bezier(0.16, 1, 0.3, 1) 0.34s both;
}

.is-playing .cine-editorial-kicker i {
  animation: editorial-rule-in 0.82s cubic-bezier(0.16, 1, 0.3, 1) 0.58s both;
}

.is-playing .cine-editorial-caption {
  animation: editorial-meta-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) 1.64s both;
}

.is-complete :is(.cine-editorial-kicker, .cine-editorial-caption) {
  opacity: 0.34;
  transform: none;
}

.is-complete .cine-editorial-kicker i {
  transform: scaleX(1);
}

.cine-editorial-word {
  position: relative;
  z-index: 1;
  color: rgb(222 241 250 / 0.76);
  font-family: var(--font-display);
  font-size: clamp(5.4rem, 12.6vw, 13.8rem);
  font-weight: 700;
  letter-spacing: -0.075em;
  line-height: 0.72;
  text-transform: uppercase;
}

.cine-editorial-word > span {
  display: block;
  overflow: hidden;
  padding: 0.08em 0.08em 0.14em 0;
}

.cine-editorial-word b {
  display: block;
  font: inherit;
  opacity: 0;
  transform: translate3d(0, 112%, 0) scale(0.985);
  transform-origin: 50% 100%;
  text-shadow: 0 0 52px rgb(159 212 255 / 0.08);
  backface-visibility: hidden;
}

.cine-editorial-word > span:nth-child(2) b {
  color: rgb(240 215 138 / 0.64);
  letter-spacing: 0.08em;
}

.is-playing .cine-editorial-word > span:first-child b {
  animation: editorial-word-rise 4.7s cubic-bezier(0.16, 1, 0.3, 1) 0.22s both;
}

.is-playing .cine-editorial-word > span:nth-child(2) b {
  animation: editorial-word-rise 4.55s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
}

.is-complete .cine-editorial-word b {
  opacity: 0.055;
  transform: translate3d(0, -2%, 0) scale(0.995);
}

.cine-editorial-coordinate {
  position: absolute;
  top: 50%;
  color: rgb(159 212 255 / 0.34);
  font: 600 0.46rem / 1 var(--font-sans);
  letter-spacing: 0.32em;
  opacity: 0;
  writing-mode: vertical-rl;
}

.cine-editorial-coordinate-left {
  left: calc(var(--editorial-inset-x) + 10px);
  transform: translate3d(-8px, -50%, 0) rotate(180deg);
}

.cine-editorial-coordinate-right {
  right: calc(var(--editorial-inset-x) + 10px);
  transform: translate3d(8px, -50%, 0);
}

.is-playing .cine-editorial-coordinate-left {
  animation: editorial-coordinate-left 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.08s both;
}

.is-playing .cine-editorial-coordinate-right {
  animation: editorial-coordinate-right 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.22s both;
}

.is-complete .cine-editorial-coordinate-left {
  opacity: 0.3;
  transform: translate3d(0, -50%, 0) rotate(180deg);
}

.is-complete .cine-editorial-coordinate-right {
  opacity: 0.3;
  transform: translate3d(0, -50%, 0);
}

.is-diving .cine-editorial {
  animation: editorial-interface-out 0.18s ease-in both;
}

.cine-depth-field {
  position: absolute;
  z-index: 2;
  inset: 0;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  transform: translateZ(0) scale(0.9);
  transform-origin: 50% 50%;
  will-change: opacity, transform;
}

.is-playing .cine-depth-field {
  animation: depth-field-reveal 4.9s cubic-bezier(0.16, 1, 0.3, 1) 0.16s both;
}

.is-complete .cine-depth-field {
  opacity: 0.38;
  transform: scale(1);
}

.cine-depth-grid {
  position: absolute;
  inset: -18%;
  opacity: 0.58;
  background:
    repeating-radial-gradient(
      circle at 50% 50%,
      transparent 0 7.8%,
      rgb(148 213 255 / 0.1) 8% 8.08%,
      transparent 8.3% 15.8%
    ),
    repeating-conic-gradient(
      from 4deg at 50% 50%,
      transparent 0deg 14.4deg,
      rgb(219 187 112 / 0.075) 14.7deg 14.82deg,
      transparent 15.05deg 30deg
    );
  -webkit-mask-image: radial-gradient(
    circle at center,
    transparent 0 10%,
    #000 26% 72%,
    transparent 91%
  );
  mask-image: radial-gradient(circle at center, transparent 0 10%, #000 26% 72%, transparent 91%);
  transform: rotate(-5deg) scale(0.88);
  will-change: transform;
}

.is-playing .cine-depth-grid {
  animation: depth-grid-drift 5.8s cubic-bezier(0.18, 0.8, 0.2, 1) both;
}

.cine-aperture {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(84vmin, 860px);
  aspect-ratio: 1;
  border-radius: 50%;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.54) rotate(-18deg);
  will-change: opacity, transform;
}

.cine-aperture::before,
.cine-aperture::after,
.cine-aperture > i {
  content: "";
  position: absolute;
  border-radius: 50%;
}

.cine-aperture::before {
  inset: 1%;
  border: 1px solid rgb(163 222 255 / 0.16);
  background: repeating-conic-gradient(
    from 9deg,
    transparent 0deg 20deg,
    rgb(159 212 255 / 0.2) 20.3deg 20.65deg,
    transparent 21deg 30deg
  );
  -webkit-mask-image: radial-gradient(circle, transparent 0 73%, #000 73.4% 74%, transparent 74.4%);
  mask-image: radial-gradient(circle, transparent 0 73%, #000 73.4% 74%, transparent 74.4%);
}

.cine-aperture::after {
  inset: 13%;
  border: 1px solid rgb(232 204 136 / 0.18);
  box-shadow:
    inset 0 0 32px rgb(122 194 236 / 0.05),
    0 0 38px rgb(219 181 100 / 0.04);
}

.cine-aperture > i {
  inset: 21%;
  border: 1px solid rgb(179 226 255 / 0.2);
}

.cine-aperture > i:nth-child(2) {
  inset: 29%;
  border-color: rgb(240 215 138 / 0.22);
  border-style: dashed;
}

.cine-aperture > i:nth-child(3) {
  inset: 37%;
  border-color: rgb(255 255 255 / 0.2);
  box-shadow: 0 0 18px rgb(159 212 255 / 0.12);
}

.is-playing .cine-aperture {
  animation: aperture-assembly 3.4s cubic-bezier(0.14, 0.86, 0.18, 1) 0.16s both;
}

.is-complete .cine-aperture {
  opacity: 0.36;
  transform: translate(-50%, -50%) scale(1) rotate(0);
}

.cine-orbit {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(108vw, 1240px);
  height: min(34vw, 390px);
  border: 1px solid rgb(159 212 255 / 0.12);
  border-radius: 50%;
  opacity: 0;
  transform: translate(-50%, -50%) rotate(-8deg) scale(0.72);
  box-shadow: 0 0 28px rgb(77 139 194 / 0.05);
  will-change: opacity, transform;
}

.cine-orbit::before,
.cine-orbit::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 7px;
  aspect-ratio: 1;
  border-radius: 50%;
  background: #dff4ff;
  box-shadow:
    0 0 14px rgb(159 212 255 / 0.85),
    0 0 28px rgb(159 212 255 / 0.38);
}

.cine-orbit::before {
  left: 8%;
}
.cine-orbit::after {
  right: 11%;
}

.cine-orbit-b {
  width: min(94vw, 1080px);
  height: min(27vw, 310px);
  border-color: rgb(240 215 138 / 0.13);
  transform: translate(-50%, -50%) rotate(64deg) scale(0.68);
}

.cine-orbit-b::before,
.cine-orbit-b::after {
  background: #fff2c6;
  box-shadow:
    0 0 14px rgb(240 215 138 / 0.75),
    0 0 28px rgb(212 176 86 / 0.3);
}

.is-playing .cine-orbit-a {
  animation: orbit-a-lock 3.9s cubic-bezier(0.16, 1, 0.3, 1) 0.42s both;
}

.is-playing .cine-orbit-b {
  animation: orbit-b-lock 4.4s cubic-bezier(0.16, 1, 0.3, 1) 0.58s both;
}

.is-complete .cine-orbit-a {
  opacity: 0.3;
  transform: translate(-50%, -50%) rotate(5deg) scale(1);
}

.is-complete .cine-orbit-b {
  opacity: 0.24;
  transform: translate(-50%, -50%) rotate(74deg) scale(1);
}

.cine-prism-field {
  position: absolute;
  inset: 0;
}

.cine-prism-field > i {
  position: absolute;
  width: 1px;
  height: clamp(38px, 8vw, 112px);
  border-radius: 50%;
  background: linear-gradient(
    180deg,
    transparent,
    rgb(222 243 255 / 0.68),
    rgb(112 191 242 / 0.16),
    transparent
  );
  box-shadow: 0 0 8px rgb(159 212 255 / 0.2);
  opacity: 0;
  transform: rotate(24deg) scaleY(0.3);
  transform-origin: center;
  will-change: opacity, transform;
}

.cine-prism-field > i:nth-child(1) {
  top: 14%;
  left: 11%;
}
.cine-prism-field > i:nth-child(2) {
  top: 22%;
  left: 25%;
  height: 58px;
}
.cine-prism-field > i:nth-child(3) {
  top: 10%;
  right: 21%;
  transform: rotate(-31deg) scaleY(0.3);
}
.cine-prism-field > i:nth-child(4) {
  top: 25%;
  right: 8%;
  height: 82px;
  transform: rotate(-18deg) scaleY(0.3);
}
.cine-prism-field > i:nth-child(5) {
  bottom: 18%;
  left: 8%;
  transform: rotate(-24deg) scaleY(0.3);
}
.cine-prism-field > i:nth-child(6) {
  bottom: 9%;
  left: 24%;
  height: 68px;
  transform: rotate(34deg) scaleY(0.3);
}
.cine-prism-field > i:nth-child(7) {
  right: 26%;
  bottom: 12%;
  transform: rotate(-36deg) scaleY(0.3);
}
.cine-prism-field > i:nth-child(8) {
  right: 9%;
  bottom: 24%;
  height: 54px;
  transform: rotate(22deg) scaleY(0.3);
}
.cine-prism-field > i:nth-child(9) {
  top: 48%;
  left: 4%;
  height: 46px;
  transform: rotate(72deg) scaleY(0.3);
}
.cine-prism-field > i:nth-child(10) {
  top: 42%;
  right: 4%;
  height: 48px;
  transform: rotate(-68deg) scaleY(0.3);
}
.cine-prism-field > i:nth-child(11) {
  top: 7%;
  left: 47%;
  height: 42px;
  transform: rotate(4deg) scaleY(0.3);
}
.cine-prism-field > i:nth-child(12) {
  bottom: 5%;
  left: 53%;
  height: 44px;
  transform: rotate(-3deg) scaleY(0.3);
}

.is-playing .cine-prism-field > i {
  animation: prism-signal 2.4s ease-out 0.72s both;
}

.is-playing .cine-prism-field > i:nth-child(2n) {
  animation-delay: 1.06s;
}
.is-playing .cine-prism-field > i:nth-child(3n) {
  animation-delay: 1.44s;
}
.is-playing .cine-prism-field > i:nth-child(4n) {
  animation-delay: 1.86s;
}

.cine-impact-bloom {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(88vw, 1060px);
  height: min(44vw, 530px);
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.22);
  will-change: opacity, transform;
}

.cine-impact-bloom::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(
    ellipse,
    rgb(255 255 255 / 0.66) 0,
    rgb(178 226 255 / 0.28) 12%,
    rgb(212 176 86 / 0.12) 30%,
    transparent 66%
  );
  filter: blur(2px);
}

.cine-impact-bloom > i {
  position: absolute;
  inset: 12%;
  border: 1px solid rgb(197 232 255 / 0.36);
  border-radius: 50%;
  opacity: 0;
}

.cine-impact-bloom > i:nth-child(2) {
  inset: 24%;
  border-color: rgb(240 215 138 / 0.32);
}

.is-playing .cine-impact-bloom {
  animation: impact-bloom 1.35s cubic-bezier(0.16, 0.82, 0.18, 1) 1.42s both;
}

.is-playing .cine-impact-bloom > i:first-child {
  animation: impact-ring 1.1s ease-out 1.48s both;
}

.is-playing .cine-impact-bloom > i:nth-child(2) {
  animation: impact-ring 1.05s ease-out 1.62s both;
}

.is-complete .cine-impact-bloom,
.is-complete .cine-prism-field {
  display: none;
}

.cine-scanline {
  position: absolute;
  z-index: 7;
  top: 0;
  right: -8%;
  left: -8%;
  height: 16vh;
  pointer-events: none;
  opacity: 0;
  transform: translate3d(0, -24vh, 0);
  background: linear-gradient(
    180deg,
    transparent,
    rgb(159 212 255 / 0.12),
    rgb(255 255 255 / 0.18),
    transparent
  );
  mix-blend-mode: screen;
  will-change: opacity, transform;
}

.is-playing .cine-scanline {
  animation: cinematic-scan 3.35s cubic-bezier(0.45, 0, 0.25, 1) 0.42s forwards;
}

.cine-flare {
  position: absolute;
  z-index: 3;
  top: 50%;
  left: 50%;
  width: min(92vw, 980px);
  height: 3px;
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%, -50%) scaleX(0.18);
  background: linear-gradient(
    90deg,
    transparent,
    rgb(159 212 255 / 0.38),
    #fff,
    rgb(240 215 138 / 0.4),
    transparent
  );
  box-shadow:
    0 0 34px rgb(159 212 255 / 0.32),
    0 0 86px rgb(212 176 86 / 0.16);
  will-change: opacity, transform;
}

.is-playing .cine-flare {
  animation: cinematic-flare 5.5s ease-out 0.18s both;
}

.cine-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 6;
  background: radial-gradient(
    ellipse at center,
    transparent 38%,
    rgba(0, 0, 0, 0.55) 78%,
    #000 100%
  );
}

.cine-grain {
  position: absolute;
  inset: -8%;
  z-index: 8;
  pointer-events: none;
  opacity: 0.06;
  mix-blend-mode: overlay;
  background-image: url("/noise.png");
  background-size: 320px 320px;
  animation: grain-shift 0.7s steps(2) infinite;
  will-change: transform;
}

.cine-dive-tunnel,
.cine-dive-flash,
.cine-dive-status {
  position: absolute;
  pointer-events: none;
  opacity: 0;
}

.cine-dive-tunnel {
  z-index: 18;
  top: 50%;
  left: 50%;
  width: 150vmax;
  height: 150vmax;
  border-radius: 50%;
  background: repeating-conic-gradient(
    from 2deg,
    transparent 0deg 4.35deg,
    rgb(159 212 255 / 0.34) 4.62deg 4.86deg,
    rgb(240 215 138 / 0.17) 4.94deg 5.08deg,
    transparent 5.6deg 10deg
  );
  -webkit-mask-image: radial-gradient(circle, transparent 0 4%, #000 12% 72%, transparent 84%);
  mask-image: radial-gradient(circle, transparent 0 4%, #000 12% 72%, transparent 84%);
  transform: translate(-50%, -50%) scale(0.14) rotate(-3deg);
  will-change: opacity, transform, filter;
}

.cine-dive-tunnel > i {
  position: absolute;
  inset: 5%;
  border-radius: 50%;
  opacity: 0;
  background: repeating-conic-gradient(
    from 0deg,
    transparent 0deg 2.58deg,
    rgb(197 235 255 / 0.5) 2.7deg 2.83deg,
    transparent 2.96deg 6.4deg
  );
  -webkit-mask-image: radial-gradient(circle, transparent 0 7%, #000 17% 70%, transparent 82%);
  mask-image: radial-gradient(circle, transparent 0 7%, #000 17% 70%, transparent 82%);
  transform: translateZ(0) scale(0.52);
  will-change: opacity, transform;
}

.cine-dive-tunnel > i:nth-child(2) {
  background: repeating-conic-gradient(
    from 1.7deg,
    transparent 0deg 4.72deg,
    rgb(240 215 138 / 0.38) 4.86deg 5deg,
    transparent 5.16deg 9.2deg
  );
}

.cine-dive-tunnel::before,
.cine-dive-tunnel::after,
.cine-dive-flash::before {
  content: "";
  position: absolute;
  pointer-events: none;
}

.cine-dive-tunnel::before {
  inset: 17%;
  border-radius: 50%;
  background: repeating-radial-gradient(
    circle,
    transparent 0 5.4%,
    rgb(159 212 255 / 0.38) 5.7% 5.84%,
    transparent 6.15% 10.4%
  );
  box-shadow: inset 0 0 12vmax rgb(0 0 0 / 0.72);
}

.cine-dive-tunnel::after {
  inset: 43%;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    #fff 0 3%,
    #9fd4ff 14%,
    rgb(74 126 170 / 0.68) 34%,
    transparent 70%
  );
  box-shadow:
    0 0 7vmax rgb(159 212 255 / 0.74),
    0 0 13vmax rgb(212 176 86 / 0.28);
}

.cine-dive-flash {
  z-index: 29;
  inset: 0;
  overflow: hidden;
  background: radial-gradient(
    circle at center,
    rgb(222 244 255 / 0.52),
    rgb(84 164 194 / 0.2) 28%,
    rgb(1 3 7 / 0.36) 58%,
    transparent 78%
  );
  will-change: opacity;
}

.cine-dive-flash::before {
  top: 50%;
  left: 50%;
  width: min(36vw, 460px);
  aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    #fff 0 4%,
    #bfe6ff 13%,
    rgb(82 167 196 / 0.72) 30%,
    rgb(212 176 86 / 0.3) 49%,
    transparent 72%
  );
  box-shadow: 0 0 14vmax rgb(110 207 218 / 0.4);
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.05);
}

.cine-dive-status {
  z-index: 31;
  left: 50%;
  bottom: max(8vh, calc(env(safe-area-inset-bottom) + 32px));
  display: grid;
  justify-items: center;
  gap: 0.5rem;
  width: min(420px, 82vw);
  color: rgb(232 238 248 / 0.82);
  text-align: center;
  transform: translate(-50%, 8px);
}

.cine-dive-status::before {
  content: "";
  width: min(220px, 48vw);
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--color-ice), var(--color-gold), transparent);
  box-shadow: 0 0 16px rgb(159 212 255 / 0.38);
}

.cine-dive-status small {
  color: var(--color-gold-bright);
  font: 600 0.54rem/1 var(--font-display);
  letter-spacing: 0.36em;
}

.cine-dive-status span {
  font: 500 0.64rem/1 var(--font-sans);
  letter-spacing: 0.32em;
}

.cine-letterbox {
  position: absolute;
  left: 0;
  right: 0;
  height: max(7.5vh, 42px);
  background: #000;
  z-index: 24;
  pointer-events: none;
}

.cine-letterbox.top {
  top: 0;
  transform: translateY(-100%);
}

.cine-letterbox.bottom {
  bottom: 0;
  transform: translateY(100%);
}

.is-playing .cine-letterbox,
.is-complete .cine-letterbox {
  animation: bar-in 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.05s forwards;
}

.is-complete .cine-letterbox {
  animation: none;
  transform: translateY(0);
}

.cine-hud {
  position: absolute;
  left: 50%;
  top: 50%;
  width: min(72vw, 820px);
  aspect-ratio: 1;
  transform: translate(-50%, -50%) scale(0.92);
  opacity: 0;
  z-index: 2;
  pointer-events: none;
  will-change: opacity, transform;
}

.is-playing .cine-hud {
  animation: hud-in 3.2s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
}

.is-complete .cine-hud {
  animation: none;
  opacity: 0.22;
  transform: translate(-50%, -50%) scale(1);
}

.cine-hud-spin {
  transform-origin: 50% 50%;
  animation: spin-slow 48s linear infinite;
}

.cine-hud-spin-rev {
  transform-origin: 50% 50%;
  animation: spin-slow 72s linear infinite reverse;
}

.cine-hud-orbits {
  opacity: 0.38;
  transform-origin: 50% 50%;
  animation: hud-orbit-precession 24s linear infinite;
}

.cine-hud-reticle {
  opacity: 0.52;
  transform-origin: 50% 50%;
}

.is-playing .cine-hud-reticle {
  animation: hud-reticle-lock 2.35s cubic-bezier(0.16, 1, 0.3, 1) 0.48s both;
}

.cine-stack {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: grid;
  place-items: center;
  pointer-events: none;
}

.cine-title-lockup {
  position: relative;
  width: min(1120px, 92vw, calc(78vh * 1.5));
  aspect-ratio: 3 / 2;
}

.cine-logo-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  aspect-ratio: 3 / 2;
  transform: translateY(6px) scale(0.9);
  opacity: 0;
  clip-path: inset(48% 0 48% 0);
  filter: none;
  will-change: opacity, transform, clip-path;
}

.is-playing .cine-logo-wrap {
  animation: logo-emerge 3.15s cubic-bezier(0.22, 1, 0.36, 1) 0.34s forwards;
}

.is-complete .cine-logo-wrap {
  opacity: 1;
  transform: scale(1);
  clip-path: inset(0);
  filter: none;
}

.cine-logo-glow,
.cine-logo-echo,
.cine-logo-core,
.cine-logo-first,
.cine-logo-shine {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.cine-logo-glow {
  opacity: 0;
  filter: blur(16px) saturate(1.3) brightness(1.25);
  transform: scale(1.03);
  pointer-events: none;
}

.is-playing .cine-logo-glow {
  animation: logo-glow 3.15s cubic-bezier(0.22, 1, 0.36, 1) 0.34s forwards;
}

.is-complete .cine-logo-glow {
  opacity: 0;
  visibility: hidden;
  animation: none;
}

.cine-logo-echo {
  z-index: 0;
  opacity: 0;
  pointer-events: none;
  mix-blend-mode: screen;
  will-change: opacity, transform, clip-path;
}

.cine-logo-echo-ice {
  filter: brightness(1.65) saturate(0.7) sepia(0.15) hue-rotate(158deg) blur(0.35px);
  transform: translate3d(-13px, 0, 0) scale(1.008);
  clip-path: inset(0 45% 0 0);
}

.cine-logo-echo-gold {
  filter: brightness(1.48) saturate(1.45) sepia(0.52) hue-rotate(352deg) blur(0.35px);
  transform: translate3d(13px, 0, 0) scale(1.008);
  clip-path: inset(0 0 0 45%);
}

.is-playing .cine-logo-echo-ice {
  animation: logo-echo-ice 1.25s cubic-bezier(0.16, 1, 0.3, 1) 1.05s both;
}

.is-playing .cine-logo-echo-gold {
  animation: logo-echo-gold 1.25s cubic-bezier(0.16, 1, 0.3, 1) 1.05s both;
}

.is-complete .cine-logo-echo {
  display: none;
}

.cine-logo-core,
.cine-logo-first {
  opacity: 1;
  filter: none;
  transform: translateZ(0);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

/* The ice logo arrives first and burns; the prism logo (the core) emerges
   from the burn and stays. Both are alpha-keyed from the supplied artwork, so
   they sit in the scene as light, without a box. */
.is-playing .cine-logo-core,
.is-playing .cine-title-lockup[data-burn] .cine-logo-first,
.is-complete .cine-logo-first {
  opacity: 0;
}

.is-playing .cine-title-lockup[data-burn="webgl"][data-burn-phase="done"] .cine-logo-core {
  opacity: 1;
}

/* ---- The burn ---------------------------------------------------------------
   WebGL tier: a premultiplied canvas (opening-burn.ts) swaps with the ice logo
   in one frame and back to the prism logo in one frame. CSS tier: the ice logo
   is wiped off from below and the prism logo on, under a flame band, with
   transform and opacity only. Both tiers warm the scene with one soft light. */
.cine-logo-burn {
  position: absolute;
  z-index: 2;
  inset: -42% -6% -8%;
  pointer-events: none;
  contain: layout style;
}

.is-complete .cine-logo-burn {
  display: none;
}

.cine-burn-canvas {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0;
}

.cine-title-lockup[data-burn="webgl"][data-burn-phase="burning"] .cine-burn-canvas {
  opacity: 1;
}

.cine-burn-light {
  position: absolute;
  inset: 12% 0 0;
  opacity: 0;
  background:
    radial-gradient(ellipse 46% 42% at 40% 72%, rgb(255 104 44 / 0.34), transparent 72%),
    radial-gradient(ellipse 62% 52% at 52% 64%, rgb(190 40 14 / 0.2), transparent 76%);
}

.cine-title-lockup[data-burn] .cine-burn-light {
  animation: cine-burn-light 3.9s linear both;
}

/* The logo box inside the extended host (42% above, 8% below, 6% each side).
   The wipe's lower edge and the reveal's upper edge both run from 106% to -6%
   of the box: the ice logo fades out just above that edge, the prism logo in
   just below it, and the flame band rides it. */
.cine-burn-box {
  position: absolute;
  top: 28%;
  left: 5.357%;
  width: 89.286%;
  height: 66.667%;
  visibility: hidden;
}

.cine-title-lockup[data-burn="css"] .cine-burn-box {
  visibility: visible;
}

.cine-burn-wipe,
.cine-burn-reveal {
  position: absolute;
  left: 0;
  width: 100%;
  overflow: hidden;
}

.cine-burn-wipe {
  top: 0;
  height: 100%;
  -webkit-mask-image: linear-gradient(to top, transparent, #000 6%);
  mask-image: linear-gradient(to top, transparent, #000 6%);
  transform: translate3d(0, 6%, 0);
}

.cine-burn-reveal {
  top: 0;
  height: 112%;
  -webkit-mask-image: linear-gradient(transparent, #000 5.4%);
  mask-image: linear-gradient(transparent, #000 5.4%);
  transform: translate3d(0, 94.64%, 0);
}

.cine-burn-art {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.cine-burn-wipe > .cine-burn-art {
  transform: translate3d(0, -6%, 0);
}

.cine-burn-reveal > .cine-burn-art {
  height: 89.286%;
  transform: translate3d(0, -106%, 0);
}

/* The prism logo glows ember-hot where it has just been uncovered, then cools. */
.cine-burn-hot {
  filter: sepia(1) saturate(4.2) hue-rotate(-18deg) brightness(1.08);
  opacity: 0.9;
}

.cine-burn-flame {
  position: absolute;
  top: 0;
  left: 1%;
  width: 98%;
  height: 34%;
  opacity: 0;
  /* Its top sits 30% of the box above the burning edge, its base 4% below. */
  transform: translate3d(0, 223.5%, 0);
  -webkit-mask-image:
    radial-gradient(ellipse 50% 100% at 50% 100%, #000 42%, transparent 100%),
    linear-gradient(to top, transparent, #000 14%);
  -webkit-mask-composite: source-in;
  mask-image:
    radial-gradient(ellipse 50% 100% at 50% 100%, #000 42%, transparent 100%),
    linear-gradient(to top, transparent, #000 14%);
  mask-composite: intersect;
}

.cine-burn-flame > i {
  position: absolute;
  inset: 0 -8%;
  background:
    linear-gradient(to top, transparent, rgb(255 170 92 / 0.72) 9%, rgb(255 84 30 / 0.38) 22%, transparent 42%),
    radial-gradient(ellipse 4% 62% at 7% 100%, rgb(255 132 58 / 0.82), rgb(180 28 10 / 0.42) 58%, transparent),
    radial-gradient(ellipse 5% 86% at 19% 100%, rgb(255 120 48 / 0.8), rgb(170 24 8 / 0.4) 60%, transparent),
    radial-gradient(ellipse 3.5% 58% at 31% 100%, rgb(255 146 70 / 0.8), rgb(180 30 10 / 0.4) 58%, transparent),
    radial-gradient(ellipse 5% 96% at 44% 100%, rgb(255 118 46 / 0.82), rgb(170 24 8 / 0.42) 60%, transparent),
    radial-gradient(ellipse 4% 70% at 57% 100%, rgb(255 138 62 / 0.8), rgb(180 28 10 / 0.4) 58%, transparent),
    radial-gradient(ellipse 5% 90% at 70% 100%, rgb(255 120 48 / 0.8), rgb(170 24 8 / 0.4) 60%, transparent),
    radial-gradient(ellipse 3.5% 60% at 82% 100%, rgb(255 146 70 / 0.8), rgb(180 30 10 / 0.4) 58%, transparent),
    radial-gradient(ellipse 4.5% 80% at 93% 100%, rgb(255 126 52 / 0.8), rgb(170 24 8 / 0.4) 60%, transparent);
}

.cine-burn-flame > i:nth-child(2) {
  opacity: 0.6;
  transform: translate3d(3%, 0, 0) scaleY(0.8);
  transform-origin: 50% 100%;
}

.cine-burn-embers > i {
  position: absolute;
  bottom: 18%;
  left: 12%;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: rgb(255 170 90);
  box-shadow: 0 0 6px rgb(255 96 30 / 0.8);
  opacity: 0;
}

.cine-burn-embers > i:nth-child(2) { left: 24%; bottom: 30%; }
.cine-burn-embers > i:nth-child(3) { left: 33%; bottom: 44%; }
.cine-burn-embers > i:nth-child(4) { left: 41%; bottom: 22%; }
.cine-burn-embers > i:nth-child(5) { left: 52%; bottom: 56%; }
.cine-burn-embers > i:nth-child(6) { left: 58%; bottom: 36%; }
.cine-burn-embers > i:nth-child(7) { left: 66%; bottom: 62%; }
.cine-burn-embers > i:nth-child(8) { left: 74%; bottom: 48%; }
.cine-burn-embers > i:nth-child(9) { left: 83%; bottom: 70%; }
.cine-burn-embers > i:nth-child(10) { left: 90%; bottom: 58%; }

/* CSS tier: one front, 0.2 -> 3.0 s after the burn starts (OPENING_BURN.front). */
.cine-title-lockup[data-burn="css"] .cine-burn-wipe {
  animation: cine-burn-wipe 2.8s cubic-bezier(0.3, 0.1, 0.7, 0.9) 0.2s both;
}

.cine-title-lockup[data-burn="css"] .cine-burn-wipe > .cine-burn-art {
  animation: cine-burn-wipe-art 2.8s cubic-bezier(0.3, 0.1, 0.7, 0.9) 0.2s both;
}

.cine-title-lockup[data-burn="css"] .cine-burn-reveal {
  animation: cine-burn-reveal 2.8s cubic-bezier(0.3, 0.1, 0.7, 0.9) 0.2s both;
}

.cine-title-lockup[data-burn="css"] .cine-burn-reveal > .cine-burn-art {
  animation: cine-burn-reveal-art 2.8s cubic-bezier(0.3, 0.1, 0.7, 0.9) 0.2s both;
}

/* The ember-hot copy rides with the reveal and cools as the fire moves on. */
.cine-title-lockup[data-burn="css"] .cine-burn-reveal > .cine-burn-hot {
  animation:
    cine-burn-reveal-art 2.8s cubic-bezier(0.3, 0.1, 0.7, 0.9) 0.2s both,
    cine-burn-cool 3.5s ease-in-out both;
}

.cine-title-lockup[data-burn="css"] .cine-burn-flame {
  animation:
    cine-burn-flame-rise 2.8s cubic-bezier(0.3, 0.1, 0.7, 0.9) 0.2s both,
    cine-burn-flame-life 3.3s linear both;
}

.cine-title-lockup[data-burn="css"] .cine-burn-flame > i {
  animation: cine-burn-flame-drift 3.3s linear both;
}

.cine-title-lockup[data-burn="css"] .cine-burn-flame > i:nth-child(2) {
  animation-name: cine-burn-flame-drift-back;
}

.cine-title-lockup[data-burn="css"] .cine-burn-embers > i {
  animation: cine-burn-ember 1.5s ease-out both;
}

.cine-title-lockup[data-burn="css"] .cine-burn-embers > i:nth-child(2n) {
  animation-duration: 1.8s;
}

.cine-title-lockup[data-burn="css"] .cine-burn-embers > i:nth-child(1) { animation-delay: 0.45s; }
.cine-title-lockup[data-burn="css"] .cine-burn-embers > i:nth-child(2) { animation-delay: 0.7s; }
.cine-title-lockup[data-burn="css"] .cine-burn-embers > i:nth-child(3) { animation-delay: 1.05s; }
.cine-title-lockup[data-burn="css"] .cine-burn-embers > i:nth-child(4) { animation-delay: 0.6s; }
.cine-title-lockup[data-burn="css"] .cine-burn-embers > i:nth-child(5) { animation-delay: 1.45s; }
.cine-title-lockup[data-burn="css"] .cine-burn-embers > i:nth-child(6) { animation-delay: 1.15s; }
.cine-title-lockup[data-burn="css"] .cine-burn-embers > i:nth-child(7) { animation-delay: 1.75s; }
.cine-title-lockup[data-burn="css"] .cine-burn-embers > i:nth-child(8) { animation-delay: 1.4s; }
.cine-title-lockup[data-burn="css"] .cine-burn-embers > i:nth-child(9) { animation-delay: 2.05s; }
.cine-title-lockup[data-burn="css"] .cine-burn-embers > i:nth-child(10) { animation-delay: 1.9s; }

@keyframes cine-burn-light {
  0% {
    opacity: 0;
  }
  18% {
    opacity: 0.55;
  }
  45% {
    opacity: 0.85;
  }
  66% {
    opacity: 0.7;
  }
  82% {
    opacity: 0.22;
  }
  100% {
    opacity: 0;
  }
}

@keyframes cine-burn-wipe {
  to {
    transform: translate3d(0, -106%, 0);
  }
}

@keyframes cine-burn-wipe-art {
  to {
    transform: translate3d(0, 106%, 0);
  }
}

@keyframes cine-burn-reveal {
  to {
    transform: translate3d(0, -5.357%, 0);
  }
}

@keyframes cine-burn-reveal-art {
  to {
    transform: translate3d(0, 6%, 0);
  }
}

@keyframes cine-burn-cool {
  0%,
  40% {
    opacity: 0.85;
  }
  100% {
    opacity: 0;
  }
}

@keyframes cine-burn-flame-rise {
  to {
    transform: translate3d(0, -105.9%, 0);
  }
}

/* In with the fire, out as the edge leaves the top of the logo. */
@keyframes cine-burn-flame-life {
  0% {
    opacity: 0;
  }
  16% {
    opacity: 0.95;
  }
  52% {
    opacity: 0.95;
  }
  74%,
  100% {
    opacity: 0;
  }
}

@keyframes cine-burn-flame-drift {
  to {
    transform: translate3d(6%, 0, 0);
  }
}

@keyframes cine-burn-flame-drift-back {
  from {
    transform: translate3d(3%, 0, 0) scaleY(0.8);
  }
  to {
    transform: translate3d(-4%, 0, 0) scaleY(0.8);
  }
}

@keyframes cine-burn-ember {
  0% {
    opacity: 0;
    transform: translate3d(0, 0, 0);
  }
  25% {
    opacity: 0.9;
  }
  100% {
    opacity: 0;
    transform: translate3d(1.2vmin, -16vmin, 0);
  }
}

.cine-logo-shine {
  background: linear-gradient(
    108deg,
    transparent 32%,
    rgb(159 212 255 / 0) 42%,
    rgb(255 255 255 / 0.55) 50%,
    rgb(240 215 138 / 0.28) 56%,
    transparent 68%
  );
  background-size: 220% 100%;
  background-position: 120% 0;
  mix-blend-mode: overlay;
  /* The prism logo's alpha, from the file the core <img> chose (--cine-logo-mask,
     set when it loads); fully masked until then, never a bare box. */
  -webkit-mask-image: var(--cine-logo-mask, linear-gradient(transparent, transparent));
  mask-image: var(--cine-logo-mask, linear-gradient(transparent, transparent));
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  opacity: 0;
}

.is-playing .cine-logo-shine {
  animation: shine-sweep 1s ease-in-out 6.2s forwards;
}

.is-complete .cine-logo-shine {
  animation: none;
  opacity: 0;
}

.cine-logo-frame {
  position: absolute;
  z-index: 3;
  inset: 8% 6%;
  pointer-events: none;
  opacity: 0;
  transform: scale(1.06);
  background:
    linear-gradient(var(--color-ice), var(--color-ice)) left top / 34px 1px no-repeat,
    linear-gradient(var(--color-ice), var(--color-ice)) left top / 1px 34px no-repeat,
    linear-gradient(var(--color-gold), var(--color-gold)) right top / 34px 1px no-repeat,
    linear-gradient(var(--color-gold), var(--color-gold)) right top / 1px 34px no-repeat,
    linear-gradient(var(--color-gold), var(--color-gold)) left bottom / 34px 1px no-repeat,
    linear-gradient(var(--color-gold), var(--color-gold)) left bottom / 1px 34px no-repeat,
    linear-gradient(var(--color-ice), var(--color-ice)) right bottom / 34px 1px no-repeat,
    linear-gradient(var(--color-ice), var(--color-ice)) right bottom / 1px 34px no-repeat;
}

.is-playing .cine-logo-frame {
  animation: logo-frame-lock 1.1s cubic-bezier(0.16, 1, 0.3, 1) 1.95s forwards;
}

.is-complete .cine-logo-frame {
  opacity: 0.52;
  transform: scale(1);
}

.cine-title-caption {
  position: absolute;
  z-index: 4;
  right: 10%;
  bottom: 7%;
  left: 10%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(12px, 2.6vw, 32px);
  color: rgb(232 238 248 / 0.7);
  font: 600 clamp(0.48rem, 0.85vw, 0.68rem)/1 var(--font-display);
  letter-spacing: 0.36em;
  text-align: center;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(10px);
}

.cine-title-caption i {
  width: clamp(34px, 7vw, 88px);
  height: 1px;
  background: linear-gradient(90deg, transparent, rgb(240 215 138 / 0.72), transparent);
}

.is-playing .cine-title-caption {
  animation: title-caption-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 2.65s forwards;
}

.is-complete .cine-title-caption {
  opacity: 1;
  transform: translateY(0);
}

.cine-line {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  height: 1px;
  width: 0;
  transform: translate(-50%, -50%);
  background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
  opacity: 0.85;
  pointer-events: none;
}

.is-playing .cine-line {
  animation:
    line-grow 1.05s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards,
    line-fade 0.7s ease 1.3s forwards;
}

.is-complete .cine-line {
  animation: none;
  opacity: 0;
  width: 0;
}

.cine-sequence-meta {
  position: absolute;
  z-index: 27;
  top: max(1.15rem, env(safe-area-inset-top));
  right: max(1.25rem, env(safe-area-inset-right));
  left: max(1.25rem, env(safe-area-inset-left));
  display: flex;
  justify-content: space-between;
  color: rgb(159 212 255 / 0.54);
  font: 600 0.52rem/1 var(--font-sans);
  letter-spacing: 0.28em;
  pointer-events: none;
  opacity: 0;
}

.is-playing .cine-sequence-meta {
  animation: sequence-meta-in 0.85s ease 0.28s forwards;
}

.is-complete .cine-sequence-meta {
  opacity: 0.62;
}

.cine-progress {
  position: absolute;
  left: max(1.25rem, env(safe-area-inset-left));
  right: max(1.25rem, env(safe-area-inset-right));
  bottom: max(1rem, env(safe-area-inset-bottom));
  height: 1px;
  z-index: 26;
  pointer-events: none;
  background: rgb(159 212 255 / 0.16);
  opacity: 0.7;
}

.cine-progress > span {
  position: absolute;
  inset: 0;
  transform: scaleX(0);
  transform-origin: left center;
  background: linear-gradient(90deg, var(--color-ice-dim), var(--color-ice), var(--color-gold));
  box-shadow: 0 0 12px rgb(159 212 255 / 0.32);
}

.cine-progress > i {
  position: absolute;
  top: 50%;
  width: 5px;
  height: 5px;
  border: 1px solid rgb(159 212 255 / 0.38);
  border-radius: 50%;
  background: #05070b;
  opacity: 0.5;
  transform: translate(-50%, -50%) scale(0.7);
}

.cine-progress > i:nth-of-type(1) {
  left: 0;
}
.cine-progress > i:nth-of-type(2) {
  left: 33.333%;
}
.cine-progress > i:nth-of-type(3) {
  left: 66.666%;
}
.cine-progress > i:nth-of-type(4) {
  left: 100%;
}

.is-playing .cine-progress > span {
  animation: progress-fill var(--seq) linear forwards;
}

.is-playing .cine-progress > i:nth-of-type(1) {
  animation: progress-marker 0.4s ease 0.2s forwards;
}
.is-playing .cine-progress > i:nth-of-type(2) {
  animation: progress-marker 0.4s ease 2.6s forwards;
}
.is-playing .cine-progress > i:nth-of-type(3) {
  animation: progress-marker 0.4s ease 4.6s forwards;
}
.is-playing .cine-progress > i:nth-of-type(4) {
  animation: progress-marker 0.4s ease 6.6s forwards;
}

.is-complete .cine-progress {
  opacity: 0;
  transition: opacity 0.8s ease;
}

.is-complete .cine-progress > span {
  transform: scaleX(1);
}

.cine-cue {
  position: absolute;
  z-index: 27;
  left: max(1.25rem, env(safe-area-inset-left));
  bottom: max(7.5vh, 54px);
  width: min(250px, 46vw);
  height: 16px;
  pointer-events: none;
  color: rgb(232 238 248 / 0.62);
  font: 600 0.5rem/1 var(--font-sans);
