  inset: 0;
  z-index: 28;
  display: grid;
  place-items: center;
  pointer-events: none;
  opacity: 1;
  transition: opacity 0.8s ease;
}
/* ── Form archive route chrome and dive ─────────────────────── */
.archive-route-dive {
  z-index: 2147483000;
  overflow: hidden;
  isolation: isolate;
  background:
    radial-gradient(circle at 50% 48%, rgb(23 90 112 / 0.34), transparent 24%),
    radial-gradient(circle at 30% 18%, rgb(88 48 134 / 0.2), transparent 28%),
    #010205;
}

.archive-dive-space {
  position: absolute;
  z-index: 1;
  inset: -12%;
  opacity: 0.72;
  background:
    radial-gradient(circle at 50% 50%, transparent 0 5%, rgb(90 206 230 / 0.08) 16%, transparent 36%),
    repeating-conic-gradient(from 6deg, transparent 0deg 6deg, rgb(125 220 255 / 0.055) 6.2deg 6.42deg, transparent 6.7deg 12deg);
  transform: scale(1.08);
  animation: archive-dive-space-rush 0.7s linear infinite;
}

.archive-route-dive.is-arriving .archive-dive-space {
  animation: archive-dive-space-arrive 0.52s cubic-bezier(0.12, 0.78, 0.08, 1) both;
}

.form-archive-page {
  --archive-cyan: #75ddff;
  --archive-violet: #9b83ff;
  --archive-gold: #e0ba66;
  isolation: isolate;
}

.form-archive-page iframe {
  position: relative;
  z-index: 1;
}

.form-archive-switcher.liquid-swipe-tabs {
  position: fixed;
  z-index: 54;
  top: max(12px, env(safe-area-inset-top));
  left: 50%;
  display: grid;
  width: min(310px, calc(100vw - 148px));
  min-width: 220px;
  isolation: isolate;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  padding: 5px;
  overflow: visible;
  border: 0;
  border-radius: 999px;
  background: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  box-shadow: none;
  cursor: grab;
  touch-action: pan-y pinch-zoom;
  translate: -50% 0;
}

.form-archive-switcher.liquid-swipe-tabs > .liquid-rail-surface {
  border-color: rgb(207 235 255 / 0.2);
  background:
    radial-gradient(circle at 22% -12%, rgb(255 255 255 / 0.2), transparent 38%),
    radial-gradient(ellipse at 86% 118%, color-mix(in srgb, var(--liquid-current-accent) 10%, transparent), transparent 46%),
    linear-gradient(132deg, rgb(255 255 255 / 0.075), transparent 34%, rgb(103 216 255 / 0.035) 63%, transparent 84%),
    rgb(10 18 29 / 0.26);
  -webkit-backdrop-filter: blur(12px) saturate(155%) contrast(1.035);
  backdrop-filter: blur(12px) saturate(155%) contrast(1.035);
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.2),
    inset 1px 0 0 rgb(255 255 255 / 0.045),
    inset 0 -1px 0 rgb(132 203 255 / 0.055),
    0 14px 36px rgb(0 0 0 / 0.24);
}

.form-archive-switcher.liquid-swipe-tabs > .liquid-selection-lens {
  border-radius: 999px;
}

.form-archive-switcher.liquid-swipe-tabs > .liquid-selection-lens > .liquid-selection-surface {
  border-color: color-mix(in srgb, var(--liquid-current-accent) 52%, rgb(255 255 255 / 0.34));
}

.form-archive-switcher[data-liquid-dragging="true"] {
  cursor: grabbing;
}

.form-archive-switcher button {
  position: relative;
  z-index: 6;
  display: grid;
  min-width: 0;
  min-height: 44px;
  place-content: center;
  gap: 3px;
  overflow: hidden;
  border: 1px solid rgb(202 231 250 / 0.095);
  border-radius: 999px;
  background: transparent;
  color: rgb(188 205 217 / 0.68);
  touch-action: pan-y pinch-zoom;
  -webkit-touch-callout: none;
  user-select: none;
  transition: color 0.18s ease, text-shadow 0.18s ease, border-color 0.22s ease;
}

.form-archive-switcher[data-liquid-dragging="true"] button:active {
  transform: none;
}

.form-archive-switcher[data-liquid-dragging="true"] button[data-liquid-contact="true"] {
  color: #fff;
  text-shadow: 0 0 16px rgb(147 231 255 / 0.48);
}

.form-archive-switcher button[aria-selected="true"] {
  color: #fff;
  text-shadow: 0 0 14px rgb(117 221 255 / 0.32);
}

.form-archive-switcher button small {
  font: 700 0.48rem/1 var(--font-display);
  letter-spacing: 0.26em;
}

.form-archive-switcher button b {
  font: 600 0.72rem/1.1 var(--font-sans);
  letter-spacing: 0.12em;
}

.form-archive-switcher button:focus-visible {
  outline-color: var(--liquid-accent, var(--archive-cyan));
  outline-offset: -3px;
}

/* The archive route has no page scroll of its own. Keeping the gesture stream
   on this fixed rail prevents Chrome Android and embedded WebViews from
   handing a diagonal swipe to the iframe before the common rail can capture
   it. Other, scrollable rails retain the shared `pan-y` behavior. */
html[data-android-renderer] .form-archive-switcher.liquid-swipe-tabs,
html[data-android-renderer] .form-archive-switcher.liquid-swipe-tabs > button {
  touch-action: none;
  -ms-touch-action: none;
  overscroll-behavior: contain;
}

.form-archive-page .side-panel-trigger.form-archive-menu-trigger {
  position: fixed;
  z-index: 62;
  top: max(14px, env(safe-area-inset-top));
  right: max(16px, env(safe-area-inset-right));
}

.form-archive-frame-status {
  position: fixed;
  z-index: 53;
  inset: 0;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 12px;
  background: rgb(2 2 7 / 0.86);
  color: rgb(225 238 247 / 0.76);
  font: 600 0.58rem/1 var(--font-display);
  letter-spacing: 0.3em;
  opacity: 1;
  pointer-events: none;
  transition: opacity 0.32s ease, visibility 0.32s;
}

.form-archive-frame-status.is-loaded {
  opacity: 0;
  visibility: hidden;
}

.form-archive-frame-status i {
  width: 36px;
  aspect-ratio: 1;
  border: 1px solid rgb(117 221 255 / 0.18);
  border-top-color: var(--archive-cyan);
  border-right-color: var(--archive-gold);
  border-radius: 50%;
  animation: archive-frame-spin 0.9s linear infinite;
}

.zeus-button[data-navigating="true"] {
  pointer-events: none;
  filter: brightness(1.08) saturate(1.08);
  transform: translate3d(-50%, -50%, 0) scale(0.94);
}

@keyframes archive-frame-spin {
  to { transform: rotate(360deg); }
}

@keyframes archive-dive-space-rush {
  from { opacity: 0.4; transform: scale(0.64) rotate(-0.5deg); }
  48% { opacity: 0.78; }
  to { opacity: 0.18; transform: scale(1.42) rotate(0.7deg); }
}

@keyframes archive-dive-space-arrive {
  from { opacity: 0.7; transform: scale(1.08); }
  to { opacity: 0; transform: scale(2.2); }
}

@media (max-width: 560px) {
  .form-archive-switcher {
    left: max(12px, env(safe-area-inset-left));
    width: min(248px, calc(100vw - 84px));
    min-width: 0;
    translate: 0 0;
  }

  .form-archive-switcher button {
    min-height: 42px;
  }

  .form-archive-page .side-panel-trigger.form-archive-menu-trigger {
    right: max(10px, env(safe-area-inset-right));
  }
}

@media (prefers-reduced-motion: reduce) {
  .archive-dive-space,
  .form-archive-frame-status i {
    animation: none !important;
  }

  .form-archive-switcher > .liquid-rail-surface,
  .form-archive-switcher > .liquid-selection-lens,
  .form-archive-switcher .liquid-selection-surface,
  .form-archive-switcher button,
  .form-archive-frame-status,
  .zeus-button[data-navigating="true"] {
    transition-duration: 0.001ms !important;
  }
}


.is-playing .cine-enter-hint,
.is-complete .cine-enter-hint {
  opacity: 0;
}

@keyframes atm-in {
  0% {
    opacity: 0;
    transform: scale(1.1);
  }
  46% { opacity: 0.4; }
  100% {
    opacity: 0.5;
    transform: scale(1.015);
  }
}

@keyframes logo-emerge {
  0% {
    opacity: 0;
    transform: translateY(6px) scale(0.9);
    clip-path: inset(48% 0 48% 0);
  }
  20% {
    opacity: 0.26;
    clip-path: inset(41% 0 41% 0);
  }
  52% {
    opacity: 0.86;
    transform: translateY(0) scale(1.018);
    clip-path: inset(6% 0 6% 0);
  }
  100% {
    opacity: 1;
    transform: scale(1);
    clip-path: inset(0);
  }
}

@keyframes light-field-in {
  0% { opacity: 0; transform: scale(0.9); }
  44% { opacity: 0.86; transform: scale(1); }
  100% { opacity: 0.52; transform: scale(1.04); }
}

@keyframes cinematic-scan {
  0% { opacity: 0; transform: translate3d(0, -24vh, 0); }
  12% { opacity: 0.85; }
  72% { opacity: 0.36; }
  100% { opacity: 0; transform: translate3d(0, 118vh, 0); }
}

@keyframes cinematic-flare {
  0%, 15%, 36%, 59%, 100% { opacity: 0; transform: translate(-50%, -50%) scaleX(0.18); }
  20% { opacity: 0.7; transform: translate(-50%, -50%) scaleX(0.82); }
  26% { opacity: 0.1; transform: translate(-50%, -50%) scaleX(1); }
  66% { opacity: 0.38; transform: translate(-50%, -50%) scaleX(0.72); }
  73% { opacity: 0; transform: translate(-50%, -50%) scaleX(1); }
}

@keyframes logo-frame-lock {
  0% { opacity: 0; transform: scale(1.06); }
  48% { opacity: 0.78; }
  100% { opacity: 0.52; transform: scale(1); }
}

@keyframes title-caption-in {
  from { opacity: 0; transform: translateY(10px); letter-spacing: 0.48em; }
  to { opacity: 1; transform: translateY(0); letter-spacing: 0.36em; }
}

@keyframes sequence-meta-in {
  from { opacity: 0; transform: translateY(-5px); }
  to { opacity: 0.62; transform: translateY(0); }
}

@keyframes cue-phase {
  0% { opacity: 0; transform: translateY(5px); }
  18%, 72% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-4px); }
}

@keyframes progress-marker {
  to {
    border-color: rgb(240 215 138 / 0.78);
    background: var(--color-gold-bright);
    box-shadow: 0 0 12px rgb(240 215 138 / 0.5);
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes logo-glow {
  0% {
    opacity: 0;
  }
  28% {
    opacity: 0.4;
  }
  72% {
    opacity: 0.12;
  }
  100% {
    opacity: 0;
  }
}

@keyframes shine-sweep {
  0% {
    opacity: 0;
    background-position: 120% 0;
  }
  18% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    background-position: -40% 0;
  }
}

@keyframes hud-in {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }
  100% {
    opacity: 0.28;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes line-grow {
  from {
    width: 0;
    opacity: 0.9;
  }
  to {
    width: min(460px, 62vw);
    opacity: 0.9;
  }
}

@keyframes line-fade {
  to {
    opacity: 0;
  }
}

@keyframes bar-in {
  to {
    transform: translateY(0);
  }
}

@keyframes progress-fill {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

@keyframes grain-shift {
  0% {
    transform: translate(0, 0);
  }
  25% {
    transform: translate(-3%, 2%);
  }
  50% {
    transform: translate(2%, -4%);
  }
  75% {
    transform: translate(-1%, 3%);
  }
  100% {
    transform: translate(0, 0);
  }
}

@keyframes spin-slow {
  to {
    transform: rotate(360deg);
  }
}

@keyframes pulse-hint {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 1;
  }
}

@keyframes glow-breathe {
  0%,
  100% {
    opacity: 0.42;
  }
  50% {
    opacity: 0.78;
  }
}

.cine-pulse {
  animation: pulse-hint 2.4s ease-in-out infinite;
}

@media (max-width: 700px) {
  .cine-sequence-meta {
    top: max(0.9rem, env(safe-area-inset-top));
    right: max(0.85rem, env(safe-area-inset-right));
    left: max(0.85rem, env(safe-area-inset-left));
    font-size: 0.44rem;
    letter-spacing: 0.18em;
  }

  .cine-always {
    top: max(2.65rem, calc(env(safe-area-inset-top) + 1.9rem));
  }

  .cine-title-caption {
    right: 4%;
    bottom: 4%;
    left: 4%;
    gap: 8px;
    font-size: 0.42rem;
    letter-spacing: 0.22em;
  }

  .cine-title-caption i {
    width: 26px;
  }

  .cine-cue {
    left: max(0.85rem, env(safe-area-inset-left));
    width: 44vw;
    font-size: 0.43rem;
    letter-spacing: 0.2em;
  }

  .cine-progress {
    right: max(0.85rem, env(safe-area-inset-right));
    left: max(0.85rem, env(safe-area-inset-left));
  }

  .cine-replay-slot {
    flex-wrap: wrap;
    padding-inline: 1rem;
  }

  .cine-btn {
    padding-inline: 1.1rem;
  }

  .cine-grain {
    opacity: 0.035;
    animation-duration: 1.2s;
  }

  .cine-logo-glow {
    filter: blur(10px) saturate(1.2) brightness(1.15);
  }

  .cine-skip {
    right: max(0.75rem, env(safe-area-inset-right));
    bottom: max(7.5vh, 48px);
    min-width: 112px;
  }

  .cine-skip kbd {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .cine-atmosphere,
  .cine-logo-wrap,
  .cine-logo-shine,
  .cine-hud,
  .cine-line,
  .cine-letterbox,
  .cine-progress,
  .cine-grain,
  .cine-hud-spin,
  .cine-hud-spin-rev,
  .cine-pulse,
  .cine-logo-glow,
  .cine-light-field,
  .cine-scanline,
  .cine-flare,
  .cine-logo-frame,
  .cine-title-caption,
  .cine-sequence-meta,
  .cine-cue,
  .cine-progress > span,
  .cine-progress > i {
    animation: none !important;
  }

  .cine-atmosphere {
    opacity: 0.4;
    transform: none;
    filter: brightness(0.4);
  }

  .cine-logo-wrap {
    opacity: 1;
    transform: none;
    filter: none;
    clip-path: none;
  }

  .cine-light-field {
    opacity: 0.45;
    transform: none;
  }

  .cine-scanline,
  .cine-flare,
  .cine-cue {
    display: none;
  }

  .cine-logo-frame {
    opacity: 0.45;
    transform: none;
  }

  .cine-title-caption,
  .cine-sequence-meta {
    opacity: 0.62;
    transform: none;
  }

  .cine-progress {
    opacity: 0;
  }

  .cine-chrome,
  .cine-always,
  .cine-skip {
    transition: none !important;
  }

  .cine-chrome {
    transform: none;
    filter: none;
  }

  .cine-letterbox {
    transform: none;
  }

  .cine-hud {
    opacity: 0.2;
    transform: translate(-50%, -50%);
  }

  .cine-grain {
    opacity: 0.05;
  }
}

/* ── Copy / mis-tap guards ─────────────────────────────────── */

html,
body,
#app {
  -webkit-user-select: none;
  user-select: none;
  -webkit-touch-callout: none;
}

img,
video,
svg {
  -webkit-user-drag: none;
  user-select: none;
  -webkit-touch-callout: none;
}

input,
textarea,
[contenteditable="true"] {
  -webkit-user-select: text;
  user-select: text;
}

html[data-loading],
html[data-rail-lock] {
  overflow: hidden;
}

html[data-loading] body,
html[data-rail-lock] body {
  overflow: hidden;
  overscroll-behavior: none;
  touch-action: none;
}

/* ── Route load gate ───────────────────────────────────────── */

.load-gate {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  background: rgb(0 0 0 / 0.92);
  color: var(--color-metal);
}

.load-gate-inner {
  position: relative;
  display: grid;
  justify-items: center;
  gap: 0.85rem;
  min-width: min(72vw, 280px);
  text-align: center;
}

.load-gate-mark {
  position: relative;
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  border: 1px solid rgb(159 212 255 / 0.28);
  border-radius: 14px;
  color: var(--color-ice);
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
  animation: load-mark-pulse 1.8s ease-in-out infinite;
}

.load-gate-mark::after {
  content: "";
  position: absolute;
  inset: -7px;
  border: 1px solid rgb(159 212 255 / 0.14);
  border-top-color: var(--color-ice);
  border-radius: 18px;
  animation: load-ring 1.15s linear infinite;
}

.load-gate-scan {
  position: absolute;
  top: 0;
  left: 8%;
  right: 8%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--color-gold-bright), transparent);
  animation: load-scan 1.7s ease-in-out infinite;
  pointer-events: none;
}

.load-gate-label {
  margin: 0;
  color: rgb(232 238 248 / 0.78);
  font-family: var(--font-sans);
  font-size: 0.92rem;
  font-weight: 500;
  letter-spacing: 0.42em;
}

.load-gate-percent {
  color: var(--color-gold-bright);
  font-family: var(--font-display);
  font-size: 1.65rem;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.18em;
}

.load-gate-track {
  width: 100%;
  height: 2px;
  overflow: hidden;
  background: rgb(159 212 255 / 0.12);
}

.load-gate-track > i {
  display: block;
  width: 100%;
  height: 100%;
  transform: scaleX(0);
  transform-origin: left center;
  background: linear-gradient(90deg, var(--color-ice-dim), var(--color-gold));
}

@media (prefers-reduced-motion: reduce) {
  .load-gate-track > i,
  .load-gate-mark,
  .load-gate-mark::after,
  .load-gate-scan {
    animation: none;
  }
}

@keyframes load-ring {
  to {
    transform: rotate(360deg);
  }
}

@keyframes load-mark-pulse {
  0%,
  100% {
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12), 0 0 0 rgb(159 212 255 / 0);
  }
  50% {
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.2), 0 0 22px rgb(159 212 255 / 0.28);
  }
}

@keyframes load-scan {
  0% {
    transform: translateY(8px);
    opacity: 0;
  }
  18% {
    opacity: 1;
  }
  100% {
    transform: translateY(148px);
    opacity: 0;
  }
}

/* ── Zeus global navigation button ─────────────────────────────── */
.form-archive-page {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100dvh;
  overflow: hidden;
  background: #020207;
}

.form-archive-page iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
  background: #020207;
}

.zeus-button {
  --zeus-button-size: clamp(84px, 8.8vw, 122px);
  position: fixed;
  z-index: 2147483647;
  top: 82dvh;
  left: 90vw;
  width: var(--zeus-button-size);
  height: var(--zeus-button-size);
  padding: 5px;
  overflow: visible;
  isolation: isolate;
  border: 1px solid rgb(245 210 121 / 0.72);
  border-radius: 42% 42% 48% 48%;
  background:
    linear-gradient(145deg, rgb(255 255 255 / 0.7), rgb(56 205 178 / 0.2) 54%, rgb(212 176 86 / 0.34)),
    rgb(9 18 20 / 0.88);
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.86),
    0 0 0 3px rgb(14 29 28 / 0.72),
    0 12px 34px rgb(0 0 0 / 0.5),
    0 0 24px rgb(52 215 183 / 0.18),
    0 0 34px rgb(238 196 93 / 0.13);
  transform: translate3d(-50%, -50%, 0) scale(1);
  transform-origin: center;
  cursor: grab;
  touch-action: none;
  -webkit-user-select: none;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
  transition:
    transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
    filter 0.26s ease,
    box-shadow 0.3s ease;
  will-change: transform, filter;
  contain: layout paint style;
}

.zeus-button::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: -7px;
  border: 1px solid rgb(67 222 189 / 0.38);
  border-radius: inherit;
  box-shadow: inset 0 0 0 1px rgb(239 196 91 / 0.22);
  pointer-events: none;
}

.zeus-button img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: calc(42% - 3px) calc(42% - 3px) calc(48% - 3px) calc(48% - 3px);
  object-fit: cover;
  pointer-events: none;
  -webkit-user-drag: none;
}

.zeus-button-aura {
  position: absolute;
  z-index: 2;
  inset: 4px;
  border: 1px solid rgb(255 235 178 / 0.64);
  border-radius: inherit;
  box-shadow: inset 0 -12px 22px rgb(21 168 145 / 0.12);
  pointer-events: none;
}

.zeus-button-move {
  position: absolute;
  z-index: 3;
  right: 8px;
  bottom: 7px;
  left: 8px;
  padding: 3px 5px;
  border: 1px solid rgb(255 235 178 / 0.58);
  border-radius: 999px;
  background: rgb(4 18 19 / 0.78);
  color: rgb(235 255 249 / 0.94);
  font-family: var(--font-display);
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.24em;
  opacity: 0;
  pointer-events: none;
  transform: translateY(5px);
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.zeus-button[data-dragging="true"] {
  cursor: grabbing;
  filter: saturate(1.12) brightness(1.04);
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.9),
    0 0 0 4px rgb(14 29 28 / 0.82),
    0 18px 42px rgb(0 0 0 / 0.54),
    0 0 34px rgb(52 215 183 / 0.34),
    0 0 46px rgb(238 196 93 / 0.24);
  transform: translate3d(-50%, -50%, 0) scale(1.075);
  transition-duration: 0.12s;
}

.zeus-button[data-dragging="true"] .zeus-button-move {
  opacity: 1;
  transform: translateY(0);
}

.zeus-button:focus-visible {
  outline: 2px solid rgb(85 232 202 / 0.94);
  outline-offset: 6px;
}

.side-panel-zeus-toggle {
  display: flex;
  width: 100%;
  min-height: 54px;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 9px 12px 9px 18px;
  border: 1px solid rgb(202 231 250 / 0.09);
  border-radius: 999px;
  background: rgb(255 255 255 / 0.018);
  color: rgb(238 250 255 / 0.82);
  text-align: left;
  transition: border-color 0.22s ease, background 0.22s ease;
}

.side-panel-zeus-toggle > span {
  display: grid;
  gap: 3px;
}

.side-panel-zeus-toggle b {
  font-size: 12px;
  letter-spacing: 0.06em;
}

.side-panel-zeus-toggle small {
  color: rgb(158 177 189 / 0.7);
  font-size: 7px;
  letter-spacing: 0.14em;
}

.side-panel-zeus-toggle > i {
  position: relative;
  display: flex;
  width: 54px;
  height: 30px;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end;
  padding: 0 8px;
  border: 1px solid rgb(255 255 255 / 0.14);
  border-radius: 999px;
  background: rgb(4 11 16 / 0.72);
  color: rgb(145 159 169 / 0.82);
  font-style: normal;
  transition: border-color 0.22s ease, background 0.22s ease, color 0.22s ease;
}

.side-panel-zeus-toggle > i em {
  font-size: 6px;
  font-style: normal;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.side-panel-zeus-toggle > i u {
  position: absolute;
  top: 4px;
  left: 4px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: rgb(161 174 182 / 0.9);
  box-shadow: 0 3px 9px rgb(0 0 0 / 0.38);
  text-decoration: none;
  transition: translate 0.28s cubic-bezier(0.16, 1, 0.3, 1), background 0.22s ease, box-shadow 0.22s ease;
}

.side-panel-zeus-toggle[aria-pressed="true"] {
  border-color: rgb(74 218 188 / 0.24);
  background: linear-gradient(90deg, rgb(50 207 176 / 0.07), rgb(222 184 86 / 0.055));
}

.side-panel-zeus-toggle[aria-pressed="true"] > i {
  border-color: rgb(75 221 190 / 0.44);
  background: linear-gradient(90deg, rgb(33 165 143 / 0.62), rgb(184 145 50 / 0.54));
  color: white;
}

.side-panel-zeus-toggle[aria-pressed="true"] > i u {
  background: linear-gradient(145deg, #f8e4a9, #47d7b7);
  box-shadow: 0 0 12px rgb(70 218 187 / 0.42), 0 3px 9px rgb(0 0 0 / 0.38);
  translate: 24px 0;
}

.side-panel-zeus-toggle:focus-visible {
  border-color: rgb(77 226 194 / 0.72);
  outline: 2px solid rgb(77 226 194 / 0.64);
  outline-offset: 2px;
}

/* The menu must not resize or relocate the global control. A subtle ring lift
   confirms that the button remains available above the open panel. */
.zeus-button[data-menu-open="true"]::before {
  border-color: rgb(67 222 189 / 0.56);
  box-shadow:
    inset 0 0 0 1px rgb(239 196 91 / 0.3),
    0 0 22px rgb(52 215 183 / 0.2);
}

@media (max-width: 560px) {
  .zeus-button {
    --zeus-button-size: 82px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .zeus-button,
  .zeus-button-move,
  .side-panel-zeus-toggle,
  .side-panel-zeus-toggle > i,
  .side-panel-zeus-toggle > i u {
    transition-duration: 0.001ms !important;
  }
}
