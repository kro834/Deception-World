    border-color: rgb(240 215 138 / 0.78);
    background: var(--color-gold-bright);
    box-shadow: 0 0 12px rgb(240 215 138 / 0.5);
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes logo-glow {
  0% {
    opacity: 0;
  }
  28% {
    opacity: 0.4;
  }
  72% {
    opacity: 0.12;
  }
  100% {
    opacity: 0;
  }
}

@keyframes shine-sweep {
  0% {
    opacity: 0;
    background-position: 120% 0;
  }
  18% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    background-position: -40% 0;
  }
}

@keyframes hud-in {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }
  100% {
    opacity: 0.28;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes line-grow {
  from {
    width: 0;
    opacity: 0.9;
  }
  to {
    width: min(460px, 62vw);
    opacity: 0.9;
  }
}

@keyframes line-fade {
  to {
    opacity: 0;
  }
}

@keyframes bar-in {
  to {
    transform: translateY(0);
  }
}

@keyframes progress-fill {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

@keyframes grain-shift {
  0% {
    transform: translate(0, 0);
  }
  25% {
    transform: translate(-3%, 2%);
  }
  50% {
    transform: translate(2%, -4%);
  }
  75% {
    transform: translate(-1%, 3%);
  }
  100% {
    transform: translate(0, 0);
  }
}

@keyframes spin-slow {
  to {
    transform: rotate(360deg);
  }
}

@keyframes pulse-hint {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 1;
  }
}

@keyframes glow-breathe {
  0%,
  100% {
    opacity: 0.42;
  }
  50% {
    opacity: 0.78;
  }
}

.cine-pulse {
  animation: pulse-hint 2.4s ease-in-out infinite;
}

@media (max-width: 700px) {
  .cine-editorial {
    --editorial-inset-x: max(14px, calc(env(safe-area-inset-left) + 10px));
    --editorial-inset-y: max(42px, calc(env(safe-area-inset-top) + 28px));
  }

  .cine-editorial-type {
    right: calc(var(--editorial-inset-x) + 8px);
    left: calc(var(--editorial-inset-x) + 8px);
  }

  .cine-editorial-word {
    font-size: clamp(3rem, 15.7vw, 7rem);
    letter-spacing: -0.085em;
    line-height: 0.76;
  }

  .cine-editorial-kicker,
  .cine-editorial-caption {
    font-size: 0.4rem;
    letter-spacing: 0.2em;
  }

  .cine-editorial-kicker {
    gap: 8px;
  }

  .cine-editorial-kicker i {
    width: 28px;
  }

  .cine-editorial-caption {
    letter-spacing: 0.24em;
  }

  .cine-editorial-coordinate {
    display: none;
  }

  .cine-camera {
    inset: -2.5%;
  }

  .cine-depth-grid {
    opacity: 0.36;
  }

  .cine-aperture {
    width: min(112vw, 720px);
  }

  .cine-orbit {
    width: 126vw;
    height: 48vw;
  }

  .cine-orbit-b {
    width: 112vw;
    height: 38vw;
  }

  .cine-prism-field > i:nth-child(n + 7) {
    display: none;
  }

  .cine-impact-bloom {
    width: 118vw;
    height: 58vw;
  }

  .cine-sequence-meta {
    top: max(0.9rem, env(safe-area-inset-top));
    right: max(0.85rem, env(safe-area-inset-right));
    left: max(0.85rem, env(safe-area-inset-left));
    font-size: 0.44rem;
    letter-spacing: 0.18em;
  }

  .cine-always {
    top: max(2.65rem, calc(env(safe-area-inset-top) + 1.9rem));
  }

  .cine-title-caption {
    right: 4%;
    bottom: 4%;
    left: 4%;
    gap: 8px;
    font-size: 0.42rem;
    letter-spacing: 0.22em;
  }

  .cine-title-caption i {
    width: 26px;
  }

  .cine-cue {
    left: max(0.85rem, env(safe-area-inset-left));
    width: 44vw;
    font-size: 0.43rem;
    letter-spacing: 0.2em;
  }

  .cine-progress {
    right: max(0.85rem, env(safe-area-inset-right));
    left: max(0.85rem, env(safe-area-inset-left));
  }

  .cine-replay-slot {
    flex-wrap: wrap;
    padding-inline: 1rem;
  }

  .cine-btn {
    padding-inline: 1.1rem;
  }

  .cine-grain {
    opacity: 0.035;
    animation-duration: 1.2s;
  }

  .cine-logo-glow {
    filter: blur(10px) saturate(1.2) brightness(1.15);
  }

  .cine-logo-echo-ice {
    transform: translate3d(-8px, 0, 0) scale(1.006);
  }

  .cine-logo-echo-gold {
    transform: translate3d(8px, 0, 0) scale(1.006);
  }

  .cine-skip {
    right: max(0.75rem, env(safe-area-inset-right));
    bottom: max(7.5vh, 48px);
    min-width: 112px;
  }

  .cine-skip kbd {
    display: none;
  }
}

.cine-stage.is-economy-opening .cine-depth-grid,
.cine-stage.is-economy-opening .cine-orbit-b,
.cine-stage.is-economy-opening .cine-logo-echo,
.cine-stage.is-economy-opening .cine-prism-field > i:nth-child(n + 5) {
  display: none;
}

.cine-stage.is-economy-opening .cine-grain {
  animation: none;
  opacity: 0.025;
}

.cine-stage.is-economy-opening .cine-impact-bloom::before {
  filter: none;
}

.cine-stage.is-economy-opening .cine-editorial-coordinate,
.cine-stage.is-economy-opening .cine-editorial-type::after,
.cine-stage.is-economy-opening .cine-editorial-frame-right,
.cine-stage.is-economy-opening .cine-editorial-frame-left {
  display: none;
}

.cine-stage.is-economy-opening .cine-editorial-word b {
  text-shadow: none;
}

@media (max-height: 560px) and (orientation: landscape) {
  .cine-editorial {
    --editorial-inset-y: max(26px, calc(env(safe-area-inset-top) + 16px));
  }

  .cine-editorial-word {
    font-size: clamp(3rem, 18vh, 7.5rem);
    line-height: 0.7;
  }

  .cine-editorial-kicker,
  .cine-editorial-caption,
  .cine-editorial-coordinate {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .cine-editorial-frame > i,
  .cine-editorial-kicker,
  .cine-editorial-kicker i,
  .cine-editorial-caption,
  .cine-editorial-word b,
  .cine-editorial-coordinate,
  .cine-editorial-type::after,
  .cine-camera,
  .cine-depth-field,
  .cine-depth-grid,
  .cine-aperture,
  .cine-orbit,
  .cine-prism-field > i,
  .cine-impact-bloom,
  .cine-impact-bloom > i,
  .cine-logo-echo,
  .cine-hud-orbits,
  .cine-hud-reticle,
  .cine-atmosphere,
  .cine-logo-wrap,
  .cine-logo-shine,
  .cine-hud,
  .cine-line,
  .cine-letterbox,
  .cine-progress,
  .cine-grain,
  .cine-hud-spin,
  .cine-hud-spin-rev,
  .cine-pulse,
  .cine-logo-glow,
  .cine-light-field,
  .cine-scanline,
  .cine-flare,
  .cine-logo-frame,
  .cine-title-caption,
  .cine-sequence-meta,
  .cine-cue,
  .cine-progress > span,
  .cine-progress > i,
  .cine-dive-tunnel,
  .cine-dive-tunnel::before,
  .cine-dive-tunnel::after,
  .cine-dive-tunnel > i,
  .cine-dive-flash,
  .cine-dive-flash::before,
  .cine-dive-status {
    animation: none !important;
  }

  .cine-editorial-type::after {
    display: none;
  }

  .cine-editorial-frame > i {
    opacity: 0.2;
    transform: scale(1);
  }

  .cine-editorial-kicker,
  .cine-editorial-caption {
    opacity: 0.3;
    transform: none;
  }

  .cine-editorial-kicker i {
    transform: scaleX(1);
  }

  .cine-editorial-word b {
    opacity: 0.05;
    transform: none;
    text-shadow: none;
  }

  .cine-editorial-coordinate-left {
    opacity: 0.24;
    transform: translate3d(0, -50%, 0) rotate(180deg);
  }

  .cine-editorial-coordinate-right {
    opacity: 0.24;
    transform: translate3d(0, -50%, 0);
  }

  .cine-atmosphere {
    opacity: 0.4;
    transform: none;
    filter: brightness(0.4);
  }

  .cine-logo-wrap {
    opacity: 1;
    transform: none;
    filter: none;
    clip-path: none;
  }

  .cine-light-field {
    opacity: 0.45;
    transform: none;
  }

  .cine-camera {
    transform: none;
  }

  .cine-depth-field {
    opacity: 0.24;
    transform: none;
  }

  .cine-depth-grid,
  .cine-orbit-b,
  .cine-prism-field,
  .cine-impact-bloom,
  .cine-logo-echo {
    display: none;
  }

  .cine-aperture {
    opacity: 0.22;
    transform: translate(-50%, -50%);
  }

  .cine-orbit-a {
    opacity: 0.18;
    transform: translate(-50%, -50%) rotate(5deg);
  }

  .cine-scanline,
  .cine-flare,
  .cine-cue {
    display: none;
  }

  .cine-logo-frame {
    opacity: 0.45;
    transform: none;
  }

  .cine-title-caption,
  .cine-sequence-meta {
    opacity: 0.62;
    transform: none;
  }

  .cine-progress {
    opacity: 0;
  }

  .cine-chrome,
  .cine-always,
  .cine-skip {
    transition: none !important;
  }

  .cine-chrome {
    transform: none;
    filter: none;
  }

  .cine-letterbox {
    transform: none;
  }

  .cine-hud {
    opacity: 0.2;
    transform: translate(-50%, -50%);
  }

  .cine-grain {
    opacity: 0.05;
  }

  .is-diving .cine-atmosphere,
  .is-diving .cine-light-field,
  .is-diving .cine-stack,
  .is-diving .cine-hud,
  .is-diving .cine-particles,
  .is-diving .cine-vignette,
  .is-diving .cine-chrome,
  .is-diving .cine-always,
  .is-diving .cine-sequence-meta,
  .is-diving .cine-progress,
  .is-diving .cine-cue,
  .is-diving .cine-skip,
  .is-diving .cine-letterbox {
    opacity: 0;
  }

  .is-diving .cine-dive-flash {
    opacity: 1;
  }

  .is-diving .cine-dive-status {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

/* ── Media / control mis-tap guards ────────────────────────── */

/* Prose remains selectable and the native iOS callout stays available.
   Drag prevention is limited to media and controls where it protects an
   intentional gesture. */

img,
video,
svg {
  -webkit-user-drag: none;
  user-select: none;
  -webkit-touch-callout: none;
}

input,
textarea,
[contenteditable="true"] {
  -webkit-user-select: text;
  user-select: text;
}

html[data-loading],
html[data-rail-lock] {
  overflow: hidden;
}

html[data-loading] body,
html[data-rail-lock] body {
  overflow: hidden;
  overscroll-behavior: none;
  touch-action: none;
}

/* ── Route load gate ───────────────────────────────────────── */

.load-gate {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  background: rgb(0 0 0 / 0.92);
  color: var(--color-metal);
}

.load-gate-inner {
  position: relative;
  display: grid;
  justify-items: center;
  gap: 0.85rem;
  min-width: min(72vw, 280px);
  text-align: center;
}

.load-gate-mark {
  position: relative;
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  border: 1px solid rgb(159 212 255 / 0.28);
  border-radius: 14px;
  color: var(--color-ice);
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
  animation: load-mark-pulse 1.8s ease-in-out infinite;
}

.load-gate-mark::after {
  content: "";
  position: absolute;
  inset: -7px;
  border: 1px solid rgb(159 212 255 / 0.14);
  border-top-color: var(--color-ice);
  border-radius: 18px;
  animation: load-ring 1.15s linear infinite;
}

.load-gate-scan {
  position: absolute;
  top: 0;
  left: 8%;
  right: 8%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--color-gold-bright), transparent);
  animation: load-scan 1.7s ease-in-out infinite;
  pointer-events: none;
}

.load-gate-label {
  margin: 0;
  color: rgb(232 238 248 / 0.78);
  font-family: var(--font-sans);
  font-size: 0.92rem;
  font-weight: 500;
  letter-spacing: 0.42em;
}

.load-gate-percent {
  color: var(--color-gold-bright);
  font-family: var(--font-display);
  font-size: 1.65rem;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.18em;
}

.load-gate-track {
  width: 100%;
  height: 2px;
  overflow: hidden;
  background: rgb(159 212 255 / 0.12);
}

.load-gate-track > i {
  display: block;
  width: 100%;
  height: 100%;
  transform: scaleX(0);
  transform-origin: left center;
  background: linear-gradient(90deg, var(--color-ice-dim), var(--color-gold));
}

@media (prefers-reduced-motion: reduce) {
  .load-gate-track > i,
  .load-gate-mark,
  .load-gate-mark::after,
  .load-gate-scan {
    animation: none;
  }
}

@keyframes load-ring {
  to {
    transform: rotate(360deg);
  }
}

@keyframes load-mark-pulse {
  0%,
  100% {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 0 0 rgb(159 212 255 / 0);
  }
  50% {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.2),
      0 0 22px rgb(159 212 255 / 0.28);
  }
}

@keyframes load-scan {
  0% {
    transform: translateY(8px);
    opacity: 0;
  }
  18% {
    opacity: 1;
  }
  100% {
    transform: translateY(148px);
    opacity: 0;
  }
}

/* ── Zeus global navigation button ─────────────────────────────── */
.form-archive-page {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100vh;
  height: 100svh;
  height: 100dvh;
  overflow: hidden;
  background: #020207;
  overscroll-behavior: none;
}

.form-archive-page iframe {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
  background: #020207;
  color-scheme: dark;
}

@supports (-webkit-touch-callout: none) {
  .form-archive-page,
  .form-archive-page iframe {
    max-width: 100vw;
    max-height: 100dvh;
  }
}

/* The desktop tunnel deliberately spans far beyond the viewport. On iOS and
   touch-first iPads that geometry can allocate several full-screen GPU
   surfaces while WebKit is also constructing the archive iframe. Retain the
   forward-rush silhouette with one streak layer and bounded transforms. */
@media (max-width: 1180px), (any-pointer: coarse) {
  .archive-route-dive {
    contain: strict;
  }

  .archive-route-dive .cine-dive-tunnel {
    width: min(92vmax, 980px);
    height: min(92vmax, 980px);
    -webkit-mask-image: none;
    mask-image: none;
    filter: none !important;
    will-change: transform, opacity;
  }

  .archive-route-dive .cine-dive-tunnel > i {
    inset: 12%;
    -webkit-mask-image: none;
    mask-image: none;
    will-change: auto;
  }

  .archive-route-dive .cine-dive-tunnel > i:nth-child(2),
  .archive-route-dive .cine-dive-tunnel::before {
    display: none;
  }

  .archive-route-dive.is-diving .cine-dive-tunnel {
    animation: archive-mobile-tunnel-in 0.32s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .archive-route-dive.is-diving .cine-dive-tunnel > i:first-child {
    animation: archive-mobile-streak 0.72s linear infinite;
  }

  .archive-route-dive.is-diving .cine-dive-tunnel::after {
    animation: none;
  }

  .archive-route-dive.is-arriving .cine-dive-tunnel {
    animation: archive-mobile-tunnel-out 0.42s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .archive-route-dive.is-arriving .cine-dive-tunnel > i,
  .archive-route-dive.is-arriving .cine-dive-tunnel::before,
  .archive-route-dive.is-arriving .cine-dive-tunnel::after {
    animation: none !important;
    opacity: 0;
  }
}

@keyframes archive-mobile-tunnel-in {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.72) rotate(-2deg);
  }
  to {
    opacity: 0.86;
    transform: translate(-50%, -50%) scale(1) rotate(0);
  }
}

@keyframes archive-mobile-tunnel-out {
  from {
    opacity: 0.86;
    transform: translate(-50%, -50%) scale(1);
  }
  to {
    opacity: 0;
    transform: translate(-50%, -50%) scale(1.12);
  }
}

@keyframes archive-mobile-streak {
  from {
    opacity: 0;
    transform: scale(0.72);
  }
  25% {
    opacity: 0.78;
  }
  to {
    opacity: 0;
    transform: scale(1.12);
  }
}

.zeus-button {
  --zeus-button-size: clamp(84px, 8.8vw, 122px);
  --zeus-safe-top: env(safe-area-inset-top, 0px);
  --zeus-safe-right: env(safe-area-inset-right, 0px);
  --zeus-safe-bottom: env(safe-area-inset-bottom, 0px);
  --zeus-safe-left: env(safe-area-inset-left, 0px);
  position: fixed;
  z-index: 2147483647;
  top: 82dvh;
  left: 90vw;
  width: var(--zeus-button-size);
  height: var(--zeus-button-size);
  padding: 5px;
  overflow: visible;
  isolation: isolate;
  border: 1px solid rgb(245 210 121 / 0.72);
  border-radius: 42% 42% 48% 48%;
  background:
    linear-gradient(
      145deg,
      rgb(255 255 255 / 0.7),
      rgb(56 205 178 / 0.2) 54%,
      rgb(212 176 86 / 0.34)
    ),
    rgb(9 18 20 / 0.88);
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.86),
    0 0 0 3px rgb(14 29 28 / 0.72),
    0 12px 34px rgb(0 0 0 / 0.5),
    0 0 24px rgb(52 215 183 / 0.18),
    0 0 34px rgb(238 196 93 / 0.13);
  transform: translate3d(-50%, -50%, 0) scale(1);
  transform-origin: center;
  cursor: grab;
  touch-action: pan-y pinch-zoom;
  -webkit-user-select: none;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
  transition:
    opacity 0.2s ease,
    transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
    filter 0.26s ease,
    box-shadow 0.3s ease,
    visibility 0.2s;
  will-change: transform;
  contain: layout paint style;
}

.zeus-button::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: -7px;
  border: 1px solid rgb(67 222 189 / 0.38);
  border-radius: inherit;
  box-shadow: inset 0 0 0 1px rgb(239 196 91 / 0.22);
  pointer-events: none;
}

.zeus-button img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: calc(42% - 3px) calc(42% - 3px) calc(48% - 3px) calc(48% - 3px);
  object-fit: cover;
  pointer-events: none;
  -webkit-user-drag: none;
}

.zeus-button-image {
  position: relative;
  z-index: 0;
  opacity: 1;
  transform: scale(1);
  transition:
    opacity 0.2s ease,
    transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
    filter 0.24s ease;
}

.zeus-button-image.is-returning {
  position: absolute;
  z-index: 1;
  inset: 5px;
  width: calc(100% - 10px);
  height: calc(100% - 10px);
  opacity: 0;
  filter: saturate(1.08) brightness(1.04);
  transform: scale(0.88);
}

.zeus-button[data-return-loading="true"] {
  border-color: rgb(235 211 142 / 0.92);
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.92),
    0 0 0 3px rgb(8 34 31 / 0.8),
    0 12px 34px rgb(0 0 0 / 0.5),
    0 0 28px rgb(55 230 194 / 0.34),
    0 0 42px rgb(239 211 139 / 0.24);
}

.zeus-button[data-return-loading="true"] .zeus-button-image.is-default {
  opacity: 0;
  filter: blur(1.5px) brightness(1.16);
  transform: scale(1.1);
}

.zeus-button[data-return-loading="true"] .zeus-button-image.is-returning {
  opacity: 1;
  transform: scale(1);
}

.zeus-button-aura {
  position: absolute;
  z-index: 2;
  inset: 4px;
  border: 1px solid rgb(255 235 178 / 0.64);
  border-radius: inherit;
  box-shadow: inset 0 -12px 22px rgb(21 168 145 / 0.12);
  pointer-events: none;
}

.zeus-button-move {
  position: absolute;
  z-index: 3;
  right: 8px;
  bottom: 7px;
  left: 8px;
  padding: 3px 5px;
  border: 1px solid rgb(255 235 178 / 0.58);
  border-radius: 999px;
  background: rgb(4 18 19 / 0.78);
  color: rgb(235 255 249 / 0.94);
  font-family: var(--font-display);
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.24em;
  opacity: 0;
  pointer-events: none;
  transform: translateY(5px);
  transition:
    opacity 0.18s ease,
    transform 0.18s ease;
}

.zeus-button[data-dragging="true"] {
  cursor: grabbing;
  filter: saturate(1.12) brightness(1.04);
  will-change: transform, filter;
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.9),
    0 0 0 4px rgb(14 29 28 / 0.82),
    0 18px 42px rgb(0 0 0 / 0.54),
    0 0 34px rgb(52 215 183 / 0.34),
    0 0 46px rgb(238 196 93 / 0.24);
  transform: translate3d(-50%, -50%, 0) scale(1.075);
  transition-duration: 0.12s;
}

.zeus-button[data-dragging="true"] .zeus-button-move {
  opacity: 1;
  transform: translateY(0);
}

.zeus-button:focus-visible {
  outline: 2px solid rgb(85 232 202 / 0.94);
  outline-offset: 6px;
}

.side-panel-zeus-toggle {
  display: flex;
  width: 100%;
  min-height: 54px;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 9px 12px 9px 18px;
  border: 1px solid rgb(202 231 250 / 0.09);
  border-radius: 999px;
  background: rgb(255 255 255 / 0.018);
  color: rgb(238 250 255 / 0.82);
  text-align: left;
  transition:
    border-color 0.22s ease,
    background 0.22s ease;
}

.side-panel-zeus-toggle > span {
  display: grid;
  gap: 3px;
}

.side-panel-zeus-toggle b {
  font-size: 12px;
  letter-spacing: 0.06em;
}

.side-panel-zeus-toggle small {
  color: rgb(158 177 189 / 0.7);
  font-size: 7px;
  letter-spacing: 0.14em;
}

.side-panel-zeus-toggle > i {
  position: relative;
  display: flex;
  width: 54px;
  height: 30px;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end;
  padding: 0 8px;
  border: 1px solid rgb(255 255 255 / 0.14);
  border-radius: 999px;
  background: rgb(4 11 16 / 0.72);
  color: rgb(145 159 169 / 0.82);
  font-style: normal;
  transition:
    border-color 0.22s ease,
    background 0.22s ease,
    color 0.22s ease;
}

.side-panel-zeus-toggle > i em {
  font-size: 6px;
  font-style: normal;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.side-panel-zeus-toggle > i u {
  position: absolute;
  top: 4px;
  left: 4px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: rgb(161 174 182 / 0.9);
  box-shadow: 0 3px 9px rgb(0 0 0 / 0.38);
  text-decoration: none;
  transition:
    translate 0.28s cubic-bezier(0.16, 1, 0.3, 1),
    background 0.22s ease,
    box-shadow 0.22s ease;
}

.side-panel-zeus-toggle[aria-pressed="true"] {
  border-color: rgb(74 218 188 / 0.24);
  background: linear-gradient(90deg, rgb(50 207 176 / 0.07), rgb(222 184 86 / 0.055));
}

.side-panel-zeus-toggle[aria-pressed="true"] > i {
  border-color: rgb(75 221 190 / 0.44);
  background: linear-gradient(90deg, rgb(33 165 143 / 0.62), rgb(184 145 50 / 0.54));
  color: white;
}

.side-panel-zeus-toggle[aria-pressed="true"] > i u {
  background: linear-gradient(145deg, #f8e4a9, #47d7b7);
  box-shadow:
    0 0 12px rgb(70 218 187 / 0.42),
    0 3px 9px rgb(0 0 0 / 0.38);
  translate: 24px 0;
}

.side-panel-zeus-toggle:focus-visible {
  border-color: rgb(77 226 194 / 0.72);
  outline: 2px solid rgb(77 226 194 / 0.64);
  outline-offset: 2px;
}

/* The side panel contains its own Zeus setting. Yield the top layer while the
   panel is open so the floating control can never cover navigation or CLOSE. */
.zeus-button[data-menu-open="true"] {
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transform: translate3d(-50%, -50%, 0) scale(0.82);
}

@media (max-width: 560px) {
  .zeus-button {
    --zeus-button-size: 72px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .zeus-button,
  .zeus-button-image,
  .zeus-button-move,
  .side-panel-zeus-toggle,
  .side-panel-zeus-toggle > i,
  .side-panel-zeus-toggle > i u {
    transition-duration: 0.001ms !important;
  }
}
