    transform: translateY(100%);
  }
}

@keyframes logo-emerge {
  0% {
    opacity: 0;
    transform: translateY(10px) scale(0.86);
    clip-path: inset(48% 0 48% 0);
  }
  18% {
    opacity: 0.2;
    clip-path: inset(41% 0 41% 0);
  }
  44% {
    opacity: 0.92;
    transform: translateY(0) scale(1.026);
    clip-path: inset(4% 0 4% 0);
  }
  62% {
    opacity: 1;
    transform: scale(0.996);
    clip-path: inset(0);
  }
  100% {
    opacity: 1;
    transform: scale(1);
    clip-path: inset(0);
  }
}

@keyframes light-field-in {
  0% {
    opacity: 0;
    transform: scale(0.9);
  }
  44% {
    opacity: 0.86;
    transform: scale(1);
  }
  100% {
    opacity: 0.52;
    transform: scale(1.04);
  }
}

@keyframes cinematic-scan {
  0% {
    opacity: 0;
    transform: translate3d(0, -24vh, 0);
  }
  12% {
    opacity: 0.85;
  }
  72% {
    opacity: 0.36;
  }
  100% {
    opacity: 0;
    transform: translate3d(0, 118vh, 0);
  }
}

@keyframes cinematic-flare {
  0%,
  15%,
  36%,
  59%,
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scaleX(0.18);
  }
  20% {
    opacity: 0.7;
    transform: translate(-50%, -50%) scaleX(0.82);
  }
  26% {
    opacity: 0.1;
    transform: translate(-50%, -50%) scaleX(1);
  }
  66% {
    opacity: 0.38;
    transform: translate(-50%, -50%) scaleX(0.72);
  }
  73% {
    opacity: 0;
    transform: translate(-50%, -50%) scaleX(1);
  }
}

@keyframes logo-frame-lock {
  0% {
    opacity: 0;
    transform: scale(1.06);
  }
  48% {
    opacity: 0.78;
  }
  100% {
    opacity: 0.52;
    transform: scale(1);
  }
}

@keyframes title-caption-in {
  from {
    opacity: 0;
    transform: translateY(10px);
    letter-spacing: 0.48em;
  }
  to {
    opacity: 1;
    transform: translateY(0);
    letter-spacing: 0.36em;
  }
}

@keyframes sequence-meta-in {
  from {
    opacity: 0;
    transform: translateY(-5px);
  }
  to {
    opacity: 0.62;
    transform: translateY(0);
  }
}

@keyframes cue-phase {
