    transform: translate(-50%, -50%) scale(1.035) rotate(2deg);
  }
  100% {
    opacity: 0.36;
    transform: translate(-50%, -50%) scale(1) rotate(0);
  }
}

@keyframes orbit-a-lock {
  0% {
