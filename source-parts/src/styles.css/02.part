    transform: rotate(-8deg) scale(0.76);
  }
  26% {
    opacity: 0.72;
  }
  100% {
    opacity: 0.42;
    transform: rotate(1deg) scale(1.06);
  }
}

@keyframes aperture-assembly {
  0% {
    opacity: 0;
