    transform 0.25s ease 0.12s;
}

.cine-skip:focus-visible {
  outline: 2px solid var(--color-ice);
  outline-offset: 3px;
}

.cine-always {
  position: absolute;
  top: max(3rem, calc(env(safe-area-inset-top) + 2.2rem));
  left: max(0.75rem, env(safe-area-inset-left));
  z-index: 30;
  opacity: 0;
  pointer-events: none;
}

.is-playing .cine-always,
.is-complete .cine-always {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0.3s ease 0.2s;
}

.cine-replay-slot {
  bottom: max(9vh, 64px);
}

.cine-particles {
  z-index: 5;
}

.cine-login-glow {
  background: radial-gradient(ellipse at center, rgb(45 80 140 / 0.25), transparent 62%);
}

.cine-kicker {
  font-family: var(--font-display);
  font-size: 0.65rem;
  letter-spacing: 0.42em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--color-gold-bright) 80%, transparent);
}

.cine-btn {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  font-family: var(--font-display);
  letter-spacing: 0.28em;
  text-transform: uppercase;
  font-size: 0.68rem;
  color: var(--color-gold-bright);
  border: 1px solid rgb(255 255 255 / 0.28);
  border-radius: 999px;
  background:
    linear-gradient(
      180deg,
      rgb(255 255 255 / 0.22) 0%,
      rgb(255 255 255 / 0.04) 42%,
      rgb(212 176 86 / 0.1) 100%
    ),
    rgb(8 10 16 / 0.38);
  -webkit-backdrop-filter: blur(22px) saturate(185%);
  backdrop-filter: blur(22px) saturate(185%);
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.55),
    inset 0 -1px 0 rgb(212 176 86 / 0.18),
    0 10px 28px rgb(0 0 0 / 0.38),
    0 0 0 0.5px rgb(255 255 255 / 0.12);
  padding: 0.7rem 1.45rem;
  min-height: 44px;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
  transition:
    border-color 180ms ease,
    color 180ms ease,
    background 180ms ease,
    transform 160ms ease,
    box-shadow 180ms ease;
}

.cine-btn::before {
  content: "";
  position: absolute;
  inset: 0 auto auto 0;
  width: 100%;
  height: 52%;
  pointer-events: none;
  border-radius: inherit;
  background: linear-gradient(
    180deg,
    rgb(255 255 255 / 0.38),
    rgb(255 255 255 / 0.08) 55%,
    transparent
  );
  opacity: 0.9;
}

.cine-btn > * {
  position: relative;
  z-index: 1;
}

@media (hover: hover) and (pointer: fine) {
  .cine-skip:hover {
    border-color: rgb(159 212 255 / 0.72);
    color: #fff;
    background: rgb(10 18 30 / 0.9);
  }

  .cine-btn:hover {
    border-color: rgb(240 215 138 / 0.7);
    color: #fff8e6;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.65),
      inset 0 -1px 0 rgb(212 176 86 / 0.28),
      0 14px 34px rgb(0 0 0 / 0.42),
      0 0 24px rgb(212 176 86 / 0.18);
  }

  .cine-ghost:hover {
    color: var(--color-ice);
  }
}

.cine-btn:active {
  transform: scale(0.97);
}

.cine-btn:focus-visible,
.cine-ghost:focus-visible {
  outline: 2px solid var(--color-ice);
  outline-offset: 3px;
}

.cine-ghost {
  font-family: var(--font-sans);
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  color: rgb(232 238 248 / 0.55);
  background: transparent;
  border: none;
  min-width: 44px;
  min-height: 44px;
  padding: 0.4rem 0.7rem;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
  transition: color 160ms ease;
}

.cine-btn:disabled,
.cine-ghost:disabled {
  cursor: default;
  pointer-events: none;
}

.cine-enter-hint {
  position: absolute;
  inset: 0;
  z-index: 28;
  display: grid;
  place-items: center;
  pointer-events: none;
  opacity: 1;
  transition: opacity 0.8s ease;
}

.is-playing .cine-enter-hint,
.is-complete .cine-enter-hint {
  opacity: 0;
}

@keyframes editorial-frame-x {
  from {
    opacity: 0;
    transform: scaleX(0);
  }
  to {
    opacity: 0.24;
    transform: scaleX(1);
  }
}

@keyframes editorial-frame-y {
  from {
    opacity: 0;
    transform: scaleY(0);
  }
  to {
    opacity: 0.24;
    transform: scaleY(1);
  }
}

@keyframes editorial-meta-in {
  0% {
    opacity: 0;
    transform: translate3d(0, 10px, 0);
  }
  36% {
    opacity: 0.72;
  }
  100% {
    opacity: 0.34;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes editorial-rule-in {
  from {
    opacity: 0;
    transform: scaleX(0);
  }
  to {
    opacity: 1;
    transform: scaleX(1);
  }
}

@keyframes editorial-mask-pass {
  0% {
    opacity: 0;
    transform: translate3d(-460%, 0, 0) skewX(-12deg);
  }
  24% {
    opacity: 0.72;
  }
  74% {
    opacity: 0.42;
  }
  100% {
    opacity: 0;
    transform: translate3d(360%, 0, 0) skewX(-12deg);
  }
}

@keyframes editorial-word-rise {
  0% {
    opacity: 0;
    transform: translate3d(0, 112%, 0) scale(0.985);
  }
  18% {
    opacity: 0.17;
    transform: translate3d(0, 0, 0) scale(1);
  }
  58% {
    opacity: 0.1;
  }
  100% {
    opacity: 0.055;
    transform: translate3d(0, -2%, 0) scale(0.995);
  }
}

@keyframes editorial-coordinate-left {
  from {
    opacity: 0;
    transform: translate3d(-8px, -50%, 0) rotate(180deg);
  }
  to {
    opacity: 0.3;
    transform: translate3d(0, -50%, 0) rotate(180deg);
  }
}

@keyframes editorial-coordinate-right {
  from {
    opacity: 0;
    transform: translate3d(8px, -50%, 0);
  }
  to {
    opacity: 0.3;
    transform: translate3d(0, -50%, 0);
  }
}

@keyframes editorial-interface-out {
