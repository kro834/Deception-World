    transform: scale(1.07) translate3d(-0.7%, 0.45%, 0);
  }
  31% {
    transform: scale(1.035) translate3d(0.35%, -0.2%, 0);
  }
  58% {
    transform: scale(1.048) translate3d(-0.15%, -0.45%, 0);
  }
  100% {
    transform: scale(1.018) translate3d(0, 0, 0);
  }
}

@keyframes depth-field-reveal {
  0% {
    opacity: 0;
