    transform: scale(1.018);
  }
}

@keyframes atm-in {
  0% {
    opacity: 0;
    transform: scale(1.1);
  }
  46% {
    opacity: 0.4;
  }
  100% {
    opacity: 0.5;
    transform: scale(1.015);
  }
}

@keyframes cinematic-camera-path {
