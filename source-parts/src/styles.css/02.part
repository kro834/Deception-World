  inset: 0;
  z-index: 28;
  display: grid;
  place-items: center;
  pointer-events: none;
  opacity: 1;
  transition: opacity 0.8s ease;
}

.is-playing .cine-enter-hint,
.is-complete .cine-enter-hint {
  opacity: 0;
}

@keyframes atm-in {
  0% {
    opacity: 0;
    transform: scale(1.1);
  }
  46% { opacity: 0.4; }
  100% {
    opacity: 0.5;
    transform: scale(1.015);
  }
}

@keyframes logo-emerge {
  0% {
    opacity: 0;
    transform: translateY(6px) scale(0.9);
    clip-path: inset(48% 0 48% 0);
  }
  20% {
    opacity: 0.26;
    clip-path: inset(41% 0 41% 0);
  }
  52% {
    opacity: 0.86;
    transform: translateY(0) scale(1.018);
    clip-path: inset(6% 0 6% 0);
  }
  100% {
    opacity: 1;
    transform: scale(1);
    clip-path: inset(0);
  }
}

@keyframes light-field-in {
  0% { opacity: 0; transform: scale(0.9); }
  44% { opacity: 0.86; transform: scale(1); }
  100% { opacity: 0.52; transform: scale(1.04); }
}

@keyframes cinematic-scan {
  0% { opacity: 0; transform: translate3d(0, -24vh, 0); }
  12% { opacity: 0.85; }
  72% { opacity: 0.36; }
  100% { opacity: 0; transform: translate3d(0, 118vh, 0); }
}

@keyframes cinematic-flare {
  0%, 15%, 36%, 59%, 100% { opacity: 0; transform: translate(-50%, -50%) scaleX(0.18); }
  20% { opacity: 0.7; transform: translate(-50%, -50%) scaleX(0.82); }
  26% { opacity: 0.1; transform: translate(-50%, -50%) scaleX(1); }
  66% { opacity: 0.38; transform: translate(-50%, -50%) scaleX(0.72); }
  73% { opacity: 0; transform: translate(-50%, -50%) scaleX(1); }
}

@keyframes logo-frame-lock {
  0% { opacity: 0; transform: scale(1.06); }
  48% { opacity: 0.78; }
  100% { opacity: 0.52; transform: scale(1); }
}

@keyframes title-caption-in {
  from { opacity: 0; transform: translateY(10px); letter-spacing: 0.48em; }
  to { opacity: 1; transform: translateY(0); letter-spacing: 0.36em; }
}

@keyframes sequence-meta-in {
  from { opacity: 0; transform: translateY(-5px); }
  to { opacity: 0.62; transform: translateY(0); }
}

@keyframes cue-phase {
  0% { opacity: 0; transform: translateY(5px); }
  18%, 72% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-4px); }
}

@keyframes progress-marker {
  to {
    border-color: rgb(240 215 138 / 0.78);
    background: var(--color-gold-bright);
    box-shadow: 0 0 12px rgb(240 215 138 / 0.5);
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes logo-glow {
  0% {
    opacity: 0;
  }
  28% {
    opacity: 0.4;
  }
  72% {
    opacity: 0.12;
  }
  100% {
    opacity: 0;
  }
}

@keyframes shine-sweep {
  0% {
    opacity: 0;
    background-position: 120% 0;
  }
  18% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    background-position: -40% 0;
  }
}

@keyframes hud-in {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }
  100% {
    opacity: 0.28;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes line-grow {
  from {
    width: 0;
    opacity: 0.9;
  }
  to {
    width: min(460px, 62vw);
    opacity: 0.9;
  }
}

@keyframes line-fade {
  to {
    opacity: 0;
  }
}

@keyframes bar-in {
  to {
    transform: translateY(0);
  }
}

@keyframes progress-fill {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

@keyframes grain-shift {
  0% {
    transform: translate(0, 0);
  }
  25% {
    transform: translate(-3%, 2%);
  }
  50% {
    transform: translate(2%, -4%);
  }
  75% {
    transform: translate(-1%, 3%);
  }
  100% {
    transform: translate(0, 0);
  }
}

@keyframes spin-slow {
  to {
    transform: rotate(360deg);
  }
}

@keyframes pulse-hint {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 1;
  }
}

@keyframes glow-breathe {
  0%,
  100% {
    opacity: 0.42;
  }
  50% {
    opacity: 0.78;
  }
}

.cine-pulse {
  animation: pulse-hint 2.4s ease-in-out infinite;
}

@media (max-width: 700px) {
  .cine-sequence-meta {
    top: max(0.9rem, env(safe-area-inset-top));
    right: max(0.85rem, env(safe-area-inset-right));
    left: max(0.85rem, env(safe-area-inset-left));
    font-size: 0.44rem;
    letter-spacing: 0.18em;
  }

  .cine-always {
    top: max(2.65rem, calc(env(safe-area-inset-top) + 1.9rem));
  }

  .cine-title-caption {
    right: 4%;
    bottom: 4%;
    left: 4%;
    gap: 8px;
    font-size: 0.42rem;
    letter-spacing: 0.22em;
  }

  .cine-title-caption i {
    width: 26px;
  }

  .cine-cue {
    left: max(0.85rem, env(safe-area-inset-left));
    width: 44vw;
    font-size: 0.43rem;
    letter-spacing: 0.2em;
  }

  .cine-progress {
    right: max(0.85rem, env(safe-area-inset-right));
    left: max(0.85rem, env(safe-area-inset-left));
  }

  .cine-replay-slot {
    flex-wrap: wrap;
    padding-inline: 1rem;
  }

  .cine-btn {
    padding-inline: 1.1rem;
  }

  .cine-grain {
    opacity: 0.035;
    animation-duration: 1.2s;
  }

  .cine-logo-glow {
    filter: blur(10px) saturate(1.2) brightness(1.15);
  }

  .cine-skip {
    right: max(0.75rem, env(safe-area-inset-right));
    bottom: max(7.5vh, 48px);
    min-width: 112px;
  }

  .cine-skip kbd {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .cine-atmosphere,
  .cine-logo-wrap,
  .cine-logo-shine,
  .cine-hud,
  .cine-line,
  .cine-letterbox,
  .cine-progress,
  .cine-grain,
  .cine-hud-spin,
  .cine-hud-spin-rev,
  .cine-pulse,
  .cine-logo-glow,
  .cine-light-field,
  .cine-scanline,
  .cine-flare,
  .cine-logo-frame,
  .cine-title-caption,
  .cine-sequence-meta,
  .cine-cue,
  .cine-progress > span,
  .cine-progress > i {
    animation: none !important;
  }

  .cine-atmosphere {
    opacity: 0.4;
    transform: none;
    filter: brightness(0.4);
  }

  .cine-logo-wrap {
    opacity: 1;
    transform: none;
    filter: none;
    clip-path: none;
  }

  .cine-light-field {
    opacity: 0.45;
    transform: none;
  }

  .cine-scanline,
  .cine-flare,
  .cine-cue {
    display: none;
  }

  .cine-logo-frame {
    opacity: 0.45;
    transform: none;
  }

  .cine-title-caption,
  .cine-sequence-meta {
    opacity: 0.62;
    transform: none;
  }

  .cine-progress {
    opacity: 0;
  }

  .cine-chrome,
  .cine-always,
  .cine-skip {
    transition: none !important;
  }

  .cine-chrome {
    transform: none;
    filter: none;
  }

  .cine-letterbox {
    transform: none;
  }

  .cine-hud {
    opacity: 0.2;
    transform: translate(-50%, -50%);
  }

  .cine-grain {
    opacity: 0.05;
  }
}

/* ── Copy / mis-tap guards ─────────────────────────────────── */

html,
body,
#app {
  -webkit-user-select: none;
  user-select: none;
  -webkit-touch-callout: none;
}

img,
video,
svg {
  -webkit-user-drag: none;
  user-select: none;
  -webkit-touch-callout: none;
}

input,
textarea,
[contenteditable="true"] {
  -webkit-user-select: text;
  user-select: text;
}

html[data-loading],
html[data-rail-lock] {
  overflow: hidden;
}

html[data-loading] body,
html[data-rail-lock] body {
  overflow: hidden;
  overscroll-behavior: none;
  touch-action: none;
}

/* ── Route load gate ───────────────────────────────────────── */

.load-gate {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  background: rgb(0 0 0 / 0.92);
  color: var(--color-metal);
}

.load-gate-inner {
  position: relative;
  display: grid;
  justify-items: center;
  gap: 0.85rem;
  min-width: min(72vw, 280px);
  text-align: center;
}

.load-gate-mark {
  position: relative;
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  border: 1px solid rgb(159 212 255 / 0.28);
  border-radius: 14px;
  color: var(--color-ice);
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
  animation: load-mark-pulse 1.8s ease-in-out infinite;
}

.load-gate-mark::after {
  content: "";
  position: absolute;
  inset: -7px;
  border: 1px solid rgb(159 212 255 / 0.14);
  border-top-color: var(--color-ice);
  border-radius: 18px;
  animation: load-ring 1.15s linear infinite;
}

.load-gate-scan {
  position: absolute;
  top: 0;
  left: 8%;
  right: 8%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--color-gold-bright), transparent);
  animation: load-scan 1.7s ease-in-out infinite;
  pointer-events: none;
}

.load-gate-label {
  margin: 0;
  color: rgb(232 238 248 / 0.78);
  font-family: var(--font-sans);
  font-size: 0.92rem;
  font-weight: 500;
  letter-spacing: 0.42em;
}

.load-gate-percent {
  color: var(--color-gold-bright);
  font-family: var(--font-display);
  font-size: 1.65rem;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.18em;
}

.load-gate-track {
  width: 100%;
  height: 2px;
  overflow: hidden;
  background: rgb(159 212 255 / 0.12);
}

.load-gate-track > i {
  display: block;
  width: 100%;
  height: 100%;
  transform: scaleX(0);
  transform-origin: left center;
  background: linear-gradient(90deg, var(--color-ice-dim), var(--color-gold));
}

@media (prefers-reduced-motion: reduce) {
  .load-gate-track > i,
  .load-gate-mark,
  .load-gate-mark::after,
  .load-gate-scan {
    animation: none;
  }
}

@keyframes load-ring {
  to {
    transform: rotate(360deg);
  }
}

@keyframes load-mark-pulse {
  0%,
  100% {
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12), 0 0 0 rgb(159 212 255 / 0);
  }
  50% {
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.2), 0 0 22px rgb(159 212 255 / 0.28);
  }
}

@keyframes load-scan {
  0% {
    transform: translateY(8px);
    opacity: 0;
  }
  18% {
    opacity: 1;
  }
  100% {
    transform: translateY(148px);
    opacity: 0;
  }
}
