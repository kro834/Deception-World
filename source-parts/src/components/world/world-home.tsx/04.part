      grid.removeEventListener("scrollend", settleScroll);
    };
  }, []);

  useEffect(() => {
    syncRail(columnRail.current, columnTab);
    syncRail(pickupRail.current, columnTab);
  }, [columnTab]);

  useEffect(() => {
    syncRail(riderRail.current, riderTab);
  }, [riderTab]);

  // Only the selected classification's panel is rendered, so only its tab
  // names a panel; the others would point screen readers at nothing.
  useEffect(() => {
    managerRail.current?.querySelectorAll<HTMLElement>('button[role="tab"]').forEach((tab, i) => {
      if (i === managerTab) tab.setAttribute("aria-controls", `manager-panel-${i}`);
      else tab.removeAttribute("aria-controls");
    });
  }, [managerTab]);

  useEffect(() => {
    return () => {
      if (pickupCloseTimer.current != null) window.clearTimeout(pickupCloseTimer.current);
      shuffleRunId.current += 1;
      shuffleTimers.current.forEach((timer) => window.clearTimeout(timer));
      shuffleActive.current = false;
      posterLoader.current?.dispose();
      posterLoader.current = null;
      if (riderTransitionTimer.current != null) window.clearTimeout(riderTransitionTimer.current);
      if (episodeScrollTimer.current != null) window.clearTimeout(episodeScrollTimer.current);
      if (episodePointerFocusTimer.current != null) {
        window.clearTimeout(episodePointerFocusTimer.current);
      }
      cancelEpisodePickupScrollReset.current?.();
      cancelColumnPickupScrollReset.current?.();
      cancelPickupGlass.current?.();
    };
  }, []);
  const current = POSTERS[poster];
  const rider = RIDERS[riderTab];
  const column = COLUMNS[columnTab];
  const selectedEpisodePickup = episodePickup == null ? null : EPISODES[episodePickup];

  const requestPoster = async (next: number, retry = false) => {
    cancelPosterShuffle();
    const runId = shuffleRunId.current;
    const retryControl = retry ? document.activeElement : null;
    if (!retry) setPosterFailure(null);
    setPosterResetting(true);
    const ready = await goPoster(next, { retry: retry && next === poster });
    if (shuffleRunId.current !== runId) return;
    if (ready && retryControl && retryControl === document.activeElement) {
      posterShuffleButton.current?.focus({ preventScroll: true });
    }
    setPosterResetting(false);
    setPosterFailure(ready ? null : next);
  };

  const shufflePoster = () => {
    if (ambientPaused || shuffleActive.current) return;
    posterRestoring.current = false;
    cancelPosterFrame();
    setPosterFailure(null);
    setPosterResetting(false);
    shuffleActive.current = true;
    setShuffling(true);
    setLocked(true);
    const runId = ++shuffleRunId.current;
    shuffleTimers.current.forEach((timer) => window.clearTimeout(timer));
    shuffleTimers.current = [];

    const randomBelow = (upperBound: number) => {
      if (typeof window.crypto?.getRandomValues !== "function") {
        return Math.floor(Math.random() * upperBound);
      }
      const values = new Uint32Array(1);
      const rejectionLimit = Math.floor(0x1_0000_0000 / upperBound) * upperBound;
      do {
        window.crypto.getRandomValues(values);
      } while (values[0] >= rejectionLimit);
      return values[0] % upperBound;
    };
    const posterSequence = POSTERS.map((_, index) => index).filter((index) => index !== poster);
    for (let index = posterSequence.length - 1; index > 0; index -= 1) {
      const swapIndex = randomBelow(index + 1);
      [posterSequence[index], posterSequence[swapIndex]] = [
        posterSequence[swapIndex],
        posterSequence[index],
      ];
    }
    const finalPoster = posterSequence.pop() ?? (poster + 1) % POSTERS.length;
    const candidateIsCurrent = () =>
      shuffleActive.current &&
      shuffleRunId.current === runId &&
      heroInViewRef.current &&
      !document.hidden &&
      !document.querySelector("dialog[open]");
    const selectFinal = async (ready: boolean) => {
      if (!shuffleActive.current || shuffleRunId.current !== runId) return false;
      if (!candidateIsCurrent()) {
        cancelPosterShuffle();
        return false;
      }
      if (!ready) cancelPosterFrame();
      const shown = ready && (await goPoster(finalPoster, { canShow: candidateIsCurrent }));
      if (shuffleRunId.current !== runId) return false;
      if (!shown && candidateIsCurrent()) setPosterFailure(finalPoster);
      return true;
    };
    const finalReady = loadPoster(finalPoster);
    if (motionReduced) {
      void finalReady.then(async (ready) => {
        if (!(await selectFinal(ready))) return;
        shuffleActive.current = false;
        setShuffling(false);
      });
      return;
    }

    const nextIndex = (poster + 1) % POSTERS.length;
    const previewPool = [...new Set([poster, prevPoster ?? poster, nextIndex])];
    const previewReady = new Set([poster, prevPoster ?? poster]);
    const previewLoad = nextIndex === finalPoster ? finalReady : loadPoster(nextIndex, "low");
    void previewLoad.then((ready) => {
      if (ready && candidateIsCurrent()) previewReady.add(nextIndex);
    });

    [0, 75, 155, 240, 335, 440, 560, 695, 850, 1025].forEach((delay, index, steps) => {
      const timer = window.setTimeout(async () => {
        const isFinalStep = index === steps.length - 1;
        if (isFinalStep) {
          if (!(await selectFinal(await finalReady))) return;
          const settleTimer = window.setTimeout(() => {
            if (!shuffleActive.current || shuffleRunId.current !== runId) return;
            setShuffling(false);
            shuffleActive.current = false;
            shuffleTimers.current = [];
          }, 300);
          shuffleTimers.current.push(settleTimer);
        } else if (candidateIsCurrent()) {
          const preview = previewPool[index % previewPool.length];
          if (previewReady.has(preview)) void goPoster(preview, { canShow: candidateIsCurrent });
        }
      }, delay);
      shuffleTimers.current.push(timer);
    });
  };

  const goEpisode = (index: number) => {
    const next = Math.max(0, Math.min(EPISODES.length - 1, index));
    setEpisode(next);
    const card = episodeGridRef.current?.querySelectorAll<HTMLElement>(".episode-card")[next];
    episodeProgrammatic.current = true;
    scrollAxisX(episodeGridRef.current, card ?? null);
    if (episodeScrollTimer.current != null) window.clearTimeout(episodeScrollTimer.current);
    episodeScrollTimer.current = window.setTimeout(() => {
      episodeProgrammatic.current = false;
      episodeScrollTimer.current = null;
    }, 520);
  };

  const openEpisodePickup = (
    index: number,
    trigger: HTMLButtonElement,
    openedByKeyboard: boolean,
  ) => {
    const dialog = episodePickupDialogRef.current;
    if (!dialog || !EPISODES[index]?.pickups?.length) return;
    if (episodePointerFocusTimer.current != null) {
      window.clearTimeout(episodePointerFocusTimer.current);
      episodePointerFocusTimer.current = null;
    }
    episodeGridRef.current?.removeAttribute("data-pointer-focus-suppressed");
    goEpisode(index);
    episodePickupTriggerRef.current = trigger;
    episodePickupOpenedByKeyboard.current = openedByKeyboard;
    setEpisodePickup(index);
    cancelEpisodePickupScrollReset.current?.();
    if (!dialog.open) {
      try {
        dialog.showModal();
      } catch {
        /* already open */
      }
    }
    if (!openedByKeyboard) dialog.focus({ preventScroll: true });
    cancelEpisodePickupScrollReset.current = settlePickupScroll(
      dialog,
      [".episode-pickup-panel"],
      () => {
        if (episodePickupOpenedByKeyboard.current) {
          dialog
            .querySelector<HTMLButtonElement>(".episode-pickup-close")
            ?.focus({ preventScroll: true });
        } else {
          dialog.focus({ preventScroll: true });
        }
      },
    );
  };

  const closeEpisodePickup = () => {
    cancelEpisodePickupScrollReset.current?.();
    cancelEpisodePickupScrollReset.current = null;
    const dialog = episodePickupDialogRef.current;
    if (dialog?.open) dialog.close();
  };

  const openPickup = () => {
    const dlg = pickupDialogRef.current;
    if (!dlg) return;
    if (pickupCloseTimer.current != null) {
      window.clearTimeout(pickupCloseTimer.current);
      pickupCloseTimer.current = null;
    }
    delete dlg.dataset.closing;
    cancelColumnPickupScrollReset.current?.();
    cancelPickupGlass.current?.();
    if (!dlg.open) {
      try {
        dlg.showModal();
      } catch {
        /* already open */
      }
    }
    // WebKit otherwise auto-focuses the first column tab for a frame after a
    // pointer slide, making column 01 look selected even when another column
    // is active. Move focus to the neutral dialog surface immediately; the
    // rail remains keyboard-accessible when a user deliberately tabs into it.
    dlg.focus({ preventScroll: true });
    setPickupOpen(true);
    syncRail(pickupRail.current, columnTab);
    cancelColumnPickupScrollReset.current = settlePickupScroll(
      dlg,
      [".world-column-dialog-card"],
      () => {
        cancelPickupGlass.current = scheduleLiquidGlassBoot((boot) => {
          if (!dlg.open || !dlg.isConnected) return;
          boot(dlg);
          pickupRail.current?.dispatchEvent(new Event("liquidrelayout"));
        });
        dlg.focus({ preventScroll: true });
      },
    );
  };

  const closePickup = (event?: { stopPropagation?: () => void; preventDefault?: () => void }) => {
    event?.stopPropagation?.();
    const dlg = pickupDialogRef.current;
    if (!dlg?.open) {
      setPickupOpen(false);
      return;
    }
    if (dlg.dataset.closing === "true") return;
    cancelColumnPickupScrollReset.current?.();
    cancelPickupGlass.current?.();
    cancelColumnPickupScrollReset.current = null;
    dlg.dataset.closing = "true";
    if (pickupCloseTimer.current != null) window.clearTimeout(pickupCloseTimer.current);
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    pickupCloseTimer.current = window.setTimeout(
      () => {
        try {
          dlg.close();
        } catch {
          /* already closed */
        }
        delete dlg.dataset.closing;
        pickupCloseTimer.current = null;
        setPickupOpen(false);
      },
      reducedMotion ? 0 : 360,
    );
  };

  useDialogHistoryDismiss(episodePickupDialogRef, () => {
    episodePickupOpenedByKeyboard.current = false;
    closeEpisodePickup();
  });
  useDialogHistoryDismiss(pickupDialogRef, () => {
    cancelColumnPickupScrollReset.current?.();
    cancelPickupGlass.current?.();
    cancelColumnPickupScrollReset.current = null;
    if (pickupCloseTimer.current != null) window.clearTimeout(pickupCloseTimer.current);
    pickupCloseTimer.current = null;
    pickupDialogRef.current?.close();
    setPickupOpen(false);
  });

  return (
    <main
      ref={shellRef}
      className="site-shell motion-on film-edition mirage-edition"
      data-motion-enabled="true"
    >
      <WorldAtmosphere />
      <SideMenuLayer open={sideMenuOpen} onOpenChange={setSideMenuOpen} />
      <div className="ambient" aria-hidden="true">
        <div className="ambient-grid" />
        <div className="ambient-orb orb-a" />
        <div className="ambient-orb orb-b" />
        <div className="grain" />
      </div>

      <header className="topbar">
        <div className="topbar-leading">
          <a
            ref={openingBrandRef}
            className="brand"
            href="#top"
            aria-label="Deception World トップへ"
          >
            <span ref={openingSigilRef} className="brand-sigil">
              <i>DW</i>
            </span>
            <span>
              <b>DECEPTION WORLD</b>
              <small>KAMEN RIDER SAGA</small>
            </span>
          </a>
        </div>
        <WorldSectionNav />
        <div className="topbar-actions">
          <SideMenuTrigger open={sideMenuOpen} onOpenChange={setSideMenuOpen} />
        </div>
      </header>
      <section
        ref={openingHeroRef}
        className="hero world-artwork-hero"
        id="top"
        data-performance-region
      >
        <div ref={openingBackdropRef} className="world-artwork-light" aria-hidden="true" />
        <ArtworkStage
          variant="world"
          className="world-poster-stage"
          artwork={{
            id: current.src,
            src: current.src,
            alt: current.alt,
            width: current.width,
            height: current.height,
          }}
          economy={motionReduced}
          media={
            <div
              className="world-poster-media"
              id="poster-stage"
              tabIndex={-1}
              aria-busy={shuffling || posterResetting}
            >
              <div className="world-stage-media" data-transitioning={prevPoster !== null}>
                {[posterFrames.previous, posterFrames.current, posterFrames.pending].map(
                  (frame) => {
                    if (!frame) return null;
                    const art = POSTERS[frame.index];
                    const staged = frame === posterFrames.pending;
                    const active = frame === posterFrames.current;
                    const layer = staged ? "pending" : active ? "current" : "previous";
                    return (
                      <img
                        className={`world-stage-image world-stage-image-${layer}`}
                        data-layer={layer}
                        key={frame.key}
                        src={art.src}
                        width={art.width}
                        height={art.height}
                        {...posterImage(art.src)}
                        alt={active ? art.alt : ""}
                        fetchPriority={
                          frame.key === 0 || (staged && (shuffling || posterResetting))
                            ? "high"
                            : "low"
                        }
                        decoding="async"
                        onLoad={
                          staged
                            ? (event) => void decodePosterFrame(frame, event.currentTarget)
                            : undefined
                        }
                        onError={() => {
                          if (staged) settlePosterFrame(frame, false);
                          else if (active) setPosterFailure(frame.index);
                        }}
                      />
                    );
                  },
                )}
              </div>
            </div>
          }
          controls={
            <div
              className="world-stage-controls"
              onFocusCapture={() => {
                posterControlsFocusedRef.current = true;
                setPosterControlsFocused(true);
              }}
              onBlurCapture={(event) => {
                if (event.currentTarget.contains(event.relatedTarget)) return;
                posterControlsFocusedRef.current = false;
                setPosterControlsFocused(false);
              }}
            >
              <div
                className="world-stage-control-cluster"
                role="group"
                aria-label="キービジュアル操作"
              >
                <button
                  ref={posterShuffleButton}
                  type="button"
                  className="poster-shuffle ios26-glass"
                  data-liquid-pointer="true"
                  aria-disabled={shuffling}
                  aria-busy={shuffling}
                  aria-label="ポスターをシャッフル（SHUFFLE POSTER）"
                  onClick={shufflePoster}
                >
                  <LiquidPointerGlow />
                  <span aria-hidden="true">
                    <UiVectorIcon kind="shuffle" size={18} />
                  </span>
                  <b className="world-stage-state-label" aria-hidden="true">
                    <span data-inactive={shuffling || undefined}>SHUFFLE POSTER</span>
                    <span data-inactive={!shuffling || undefined}>SHUFFLING...</span>
                  </b>
                </button>
                <button
                  type="button"
                  className="poster-reset ios26-glass"
                  data-liquid-pointer="true"
                  aria-disabled={poster === 0 && !shuffling && !posterResetting}
                  aria-label="先頭のポスターへ戻る（RESET）"
                  onClick={() => {
                    if (poster !== 0 || shuffling || posterResetting) void requestPoster(0);
                  }}
                >
                  <LiquidPointerGlow />
                  <span aria-hidden="true">
                    <UiVectorIcon kind="reset" size={17} />
                  </span>
                  <b>RESET</b>
                </button>
                <button
                  type="button"
                  className={
                    locked
                      ? "poster-lock ios26-glass is-locked"
                      : "poster-lock ios26-glass is-unlocked"
                  }
                  data-liquid-pointer="true"
                  aria-pressed={locked}
                  aria-label={
                    locked ? "ロックを解除して自動切替にする" : "ポスターをロックして固定する"
                  }
                  onClick={() => {
                    cancelPosterShuffle();
                    setLocked((v) => !v);
                  }}
                >
                  <LiquidPointerGlow />
                  <span aria-hidden="true">
                    {locked ? (
                      <svg viewBox="0 0 24 24" width="14" height="14">
                        <path
                          d="M8 10V8a4 4 0 0 1 8 0v2"
                          fill="none"
                          stroke="currentColor"
                          strokeWidth="1.8"
                          strokeLinecap="round"
                        />
                        <rect
                          x="6"
                          y="10"
                          width="12"
                          height="10"
                          rx="2"
                          fill="none"
                          stroke="currentColor"
                          strokeWidth="1.8"
                        />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24" width="14" height="14">
                        <path
                          d="M8 10V8a4 4 0 0 1 7.5-2"
                          fill="none"
                          stroke="currentColor"
                          strokeWidth="1.8"
                          strokeLinecap="round"
                        />
                        <rect
                          x="6"
                          y="10"
                          width="12"
                          height="10"
                          rx="2"
                          fill="none"
                          stroke="currentColor"
                          strokeWidth="1.8"
                        />
                      </svg>
                    )}
                  </span>
                  <b className="world-stage-state-label" aria-hidden="true">
                    <span data-inactive={locked || undefined}>自動切替</span>
                    <span data-inactive={!locked || undefined}>固定中</span>
                  </b>
                </button>
              </div>
              <output
                aria-label="表示中のポスター"
                aria-live={locked || posterControlsFocused ? "polite" : "off"}
                aria-atomic="true"
                aria-busy={shuffling || posterResetting}
              >
                {String(poster + 1).padStart(2, "0")} / {String(POSTERS.length).padStart(2, "0")}
              </output>
              {posterFailure !== null && (
