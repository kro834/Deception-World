type EpisodePickup = {
  label: string;
  displayLines?: readonly string[];
  src: string;
  pos: string;
  alt: string;
  width: number;
  height: number;
  to: string;
  assets: readonly string[];
};

type EpisodeRecord = {
  no: string;
  title: string;
  src: string;
  pos: string;
  alt: string;
  pickups?: EpisodePickup[];
};

