                          fill="none"
                          stroke="currentColor"
                          strokeWidth="1.8"
                        />
                      </svg>
                    )}
                  </span>
                  <b>{locked ? "固定中" : "自動切替"}</b>
                </button>
              </div>
              <output
                aria-label="表示中のポスター"
                aria-live={locked || posterControlsFocused ? "polite" : "off"}
                aria-atomic="true"
                aria-busy={shuffling}
              >
                {String(poster + 1).padStart(2, "0")} / {String(POSTERS.length).padStart(2, "0")}
              </output>
            </div>
          }
        >
          <div className="world-stage-identity" data-film-reveal>
            <FilmTextScan />
            <p className="anime-work-title">
              <span>仮面ライダーサーガ 劇場版第二作</span>
              <b>
                <i className="mr-word" data-text="DECEPTION">
                  DECEPTION
                </i>{" "}
                <i className="mr-word" data-text="WORLD">
                  WORLD
                </i>
              </b>
            </p>
          </div>
          <div className="world-stage-copy">
            <p className="eyebrow">
              <span>THE SECOND SAGA</span>
              <i />
            </p>
            <h1
              ref={openingFocusRef}
              tabIndex={-1}
              data-opening-handoff-focus-target
              data-film-reveal
            >
              <FilmTextScan />
              <span>世界は、</span>
              <strong>
                <i className="mr-redact">欺瞞</i>でできている。
              </strong>
            </h1>
            <div className="world-stage-actions">
              <a className="primary-action ios26-glass" href="#story" data-liquid-pointer="true">
                <LiquidPointerGlow />
                <span>ENTER THE WORLD</span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h13M13 6l6 6-6 6" />
                </svg>
              </a>
              <a className="text-action" href="#poster-stage">
                POSTER
              </a>
            </div>
          </div>
          <div className="world-stage-context">
            <p className="world-stage-lead">
              救うべき世界は、目の前にある。
              <br />
              6人の最上位管理人と8人のライダーが、現実世界を舞台に交錯する。
            </p>
          </div>
        </ArtworkStage>
        <a className="scroll-cue" href="#story">
          <span>SCROLL TO DESCEND</span>
          <i />
        </a>
      </section>

      <MirageTicker variant="open" records={EPISODES.length} />

      <WorldContents />

      <section className="story-section" id="story">
        <div className="section-index" data-film-reveal>
          <span>01</span>
          <i className="film-boundary-line" aria-hidden="true" />
        </div>
        <div className="story-layout">
          <div className="story-heading">
            <h2 data-film-reveal data-text-reveal="heading" aria-label={revealLabel(STORY_TITLE)}>
              <FilmTextScan />
              <RevealText>{STORY_TITLE}</RevealText>
            </h2>
          </div>
          <div className="story-copy">
            <p className="story-lead story-lead-sequel">
              <span>『ドリームチャプター』に続く</span>
              <span>劇場版第二作</span>
            </p>
            <p data-text-reveal="copy">
              <RevealText copy>
                荒廃した碧栄で追われる月城悠真の前に、死んだはずのベル・アレインが現れるが、悠真はその手を取れず逃走を続ける。一方、サーガが管理人ローアの管轄から逸脱したことを知ったレックス・ロワは、六詠の介入を決める。
              </RevealText>
            </p>
            <p data-text-reveal="copy">
              <RevealText copy>
                悠真をかばうベルとローアに、刑事、怪盗、CODEのエージェントが加勢する。しかし、共闘してもフリートを攻略できない。再襲撃に備え、ベルはレジェンズルーレットを求めてREALMSフランス本部へ向かう。
              </RevealText>
            </p>
            <p data-text-reveal="copy">
              <RevealText copy>
                次に一行を狙ったのは六詠第三位のシュザだった。真守を連れ去られた悠真たちは、人の願いさえ書き換える支配と、夜明護尊に阻まれる。天守閣で追い詰められた彼らに残された逃げ道は、悠真自身の夢へと続いていた。
              </RevealText>
            </p>
          </div>
        </div>

        <div className="threat-panel" id="manager-archive" data-performance-region>
          <span
            id="manager-archive-dogs"
            className="manager-archive-return-anchor"
            aria-hidden="true"
          />
          <span
            id="manager-archive-other"
            className="manager-archive-return-anchor"
            aria-hidden="true"
          />
          <span
            id="manager-archive-unmanaged"
            className="manager-archive-return-anchor"
            aria-hidden="true"
          />
          <div className="threat-copy" data-film-reveal>
            <h3>
              {managerTab === 0 ? (
                <>
                  SIX SIGNALS
                  <br />
                  ABOVE THE WORLD.
                </>
              ) : managerTab === 1 ? (
                <>
                  OUTSIDE
                  <br />
                  THE SYSTEM.
                </>
              ) : managerTab === 2 ? (
                <>
                  OTHER
                  <br />
                  RECORDS.
                </>
              ) : (
                <>
                  DOGS
                  <br />
                  RECORDS.
                </>
              )}
            </h3>
            <p>
              {managerTab === 0
                ? "最上位管理人、六詠。六つの個体記録を照合できます。"
                : managerTab === 1
                  ? "六詠にも通常の管理人体系にも属さない、ダンテ／ヴァルグの人物資料を閲覧できます。"
                  : managerTab === 2
                    ? "物語に関わる、その他の人物資料を閲覧できます。"
                    : "終の来訪者『犬』の個体記録を閲覧できます。"}
            </p>
          </div>
          <div className="signal-column">
            <ManagerRail ref={managerRail} />

            {managerTab === 0 ? (
              <div
                id="manager-panel-0"
