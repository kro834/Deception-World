import { Fragment, useEffect, useRef, useState, type CSSProperties } from "react";
import { createPortal, flushSync } from "react-dom";
import { useRouter } from "@tanstack/react-router";
import { useWorldMode } from "./use-world-mode";
import { DossierNav, RIKUEI_NAV, NameText } from "./dossier-nav";
import { SlideOpenControl } from "./slide-open-control";
import { UiVectorIcon } from "./ui-vector-icon";
import { LiquidPointerGlow } from "./liquid-rail";
import { resetPickupScroll, settlePickupScroll } from "./pickup-scroll-reset";
import { DossierTopbar } from "./world-chrome";
import { DossierContents, DossierReader, PhrasedText } from "./dossier-reader";
import { DisplayName } from "@/components/name-text";
import { dossierImage, formPickupImage } from "@/lib/dossier-images";
import { useDialogHistoryDismiss } from "./use-dialog-history-dismiss";
import { FormSignature } from "./form-signature";
import { FormArrival, FormGate } from "./form-signature-gate";
import {
  formGate,
  measureGateScene,
  placeArrival,
  useFormSignatureArrival,
  type FormTheme,
  type GateScene,
} from "./form-signature-state";

type Section = { no: string; kicker: string; title: string; body: string[] };

export type RiderForm = {
  img: string;
  pos: string;
  system: string;
  name: string;
  prefix?: string;
  nameParts?: string[];
  sub?: string;
  calls: string[];
  quote?: string;
  overview?: string[];
  stats?: { dt: string; dd: string }[];
  /** group/tone render a coloured attribute heading before each new group. */
  abilities?: { name: string; body: string; group?: string; tone?: string }[];
  arsenal?: { name: string; body: string }[];
  finishers?: { name: string; body: string }[];
  extraForms?: { img: string; pos: string; name: string; sub?: string; theme?: FormTheme }[];
  theme?: FormTheme;
  /** A second supplied visual for the record's own figure (the card keeps img). */
  recordImg?: string;
  weaponGallery?: { img: string; pos?: string; name: string; label: string }[];
};

type Profile = {
  id: string;
  numeral: string;
  name: string;
  title: string;
  image: string;
  imageWebp: string;
  pos: string;
  accent: string;
  quotes: string[];
  facts: { dt: string; dd: string }[];
  sections: Section[];
  rider?: RiderForm;
  sovereign?: boolean;
};

export function FormPickup({ rider: record }: { rider: RiderForm }) {
  const router = useRouter();
  // Name markup marks word boundaries; labels and alt retain exact spelling.
  const rider = record;
  const signatureRef = useFormSignatureArrival(rider.theme);
  const dlg = useRef<HTMLDialogElement>(null);
  const opener = useRef<HTMLButtonElement>(null);
  const pointerOpened = useRef(false);
  const cancelScrollReset = useRef<(() => void) | null>(null);
  const gateTimer = useRef<number | null>(null);
  const gatePending = useRef(false);
  const gateSource = useRef<"keyboard" | "pointer">("pointer");
  const gateImage = useRef<HTMLImageElement | null>(null);
  const gateScene = useRef<GateScene | null>(null);
  const gateLifeEnded = useRef(false);
  const gateDecoded = useRef(false);
  const [gateActive, setGateActive] = useState(false);
  const riderPrefix = rider.prefix ?? "仮面ライダー";
  const formName = rider.nameParts ? (
    rider.nameParts.map((part) => (
      <span className="form-name-part" key={part}>
        <DisplayName value={part} />
      </span>
    ))
  ) : (
    <DisplayName value={record.name} />
  );
  const isRexonance = rider.theme === "rexonance";
  // The gated themes (Rexonance, Explom, 犭) open through their cover.
  const gate = formGate(rider.theme);
  const resetScroll = () => {
    const dialog = dlg.current;
    if (!dialog) return;
    resetPickupScroll(dialog, [".form-pickup-panel"]);
  };
  const clearPointerFocus = () => {
    if (!pointerOpened.current) return;
    const button = opener.current;
    if (!button) return;
    button.dataset.keyboardFocus = "false";
    button.blur();
  };
  const showDialog = (source: "keyboard" | "pointer") => {
    const dialog = dlg.current;
    if (!dialog) return;
    pointerOpened.current = source === "pointer";
    clearPointerFocus();
    cancelScrollReset.current?.();
    try {
      dialog.showModal();
    } catch {
      /* already open */
    }
    // The cover's light comes to rest in the record's own frame (laid out now).
    placeArrival(dialog, rider.theme, gate ? gateScene.current : null);
    cancelScrollReset.current = settlePickupScroll(dialog, [".form-pickup-panel"], () => {
      dialog.focus({ preventScroll: true });
      clearPointerFocus();
    });
  };
  const finishGate = () => {
    if (!gatePending.current) return;
    gatePending.current = false;
    if (gateTimer.current !== null) {
      window.clearTimeout(gateTimer.current);
      gateTimer.current = null;
    }
    gateImage.current = null;
    // One task: the cover leaves and the record opens under its last frame,
    // so no frame of the page shows between them.
    flushSync(() => setGateActive(false));
    showDialog(gateSource.current);
  };
  const endGateLife = () => {
    gateLifeEnded.current = true;
    // A cover that ends covering waits there for the record's art (up to its cap).
    if (!gate?.holdsForArt || gateDecoded.current) finishGate();
  };
  const open = (source: "keyboard" | "pointer") => {
    if (!gate) {
      showDialog(source);
      return;
    }
    pointerOpened.current = source === "pointer";
    clearPointerFocus();
    if (gatePending.current) return;
    gatePending.current = true;
    gateSource.current = source;
    gateLifeEnded.current = false;
    gateDecoded.current = false;
    gateScene.current = measureGateScene(
      rider.theme as FormTheme,
      opener.current,
      signatureRef.current,
    );
    setGateActive(true);
    const preload = new window.Image();
    preload.decoding = "async";
    preload.fetchPriority = "high";
    // The card's own candidate: the record then shows the warmed file.
    const { srcSet, sizes } = formPickupImage(rider.img);
    if (sizes) preload.sizes = sizes;
    if (srcSet) preload.srcset = srcSet;
    preload.src = rider.img;
    gateImage.current = preload;
    // The record's own figure loads with the cover (not at page load), so it
    // is laid out when the cover's light comes to rest on it.
    dlg.current
      ?.querySelector?.(".form-pickup-layout > figure > img")
      ?.setAttribute("loading", "eager");
    const decoded = () => {
      if (gateImage.current !== preload) return;
      gateDecoded.current = true;
      if (gateLifeEnded.current) finishGate();
    };
    // A failed decode never holds the cover: the record opens as it ends.
    void preload.decode?.().then(decoded, decoded);
    const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
    const economy = document.documentElement?.dataset.worldEffects === "economy";
    gateTimer.current = window.setTimeout(
      finishGate,
      reducedMotion ? 180 : economy ? gate.calmCap : gate.cap,
    );
  };
  const close = () => {
    cancelScrollReset.current?.();
    cancelScrollReset.current = null;
    dlg.current?.close();
    // WebKit restores dialog focus to its opener after close(). Pointer-opened
    // sliders must not look selected after that restoration. Keyboard-opened
    // sliders keep the native return focus for accessible navigation.
    clearPointerFocus();
    window.requestAnimationFrame(clearPointerFocus);
    resetScroll();
  };
  const stats = rider.stats ?? [];
  useDialogHistoryDismiss(dlg, () => {
    pointerOpened.current = true;
    close();
  });
  const abilities = rider.abilities ?? [];
  const arsenal = rider.arsenal ?? [];
  const finishers = rider.finishers ?? [];
  const extraForms = rider.extraForms ?? [];
  const overview = rider.overview ?? [];
  const weaponGallery = rider.weaponGallery ?? [];
  useEffect(() => {
    if (!gate) return;
    const cancelPendingGate = () => {
      if (!gatePending.current) return false;
      gatePending.current = false;
      if (gateTimer.current !== null) window.clearTimeout(gateTimer.current);
      gateTimer.current = null;
      gateImage.current = null;
      setGateActive(false);
      return true;
    };
    // A hash Back keeps the dossier mounted, so its pending form cover must
    // be cancelled explicitly (once the record is open, the record's own
    // history dismissal closes it).
    const stopHistory = router.history.subscribe(({ action }) => {
      if (action.type === "BACK" || action.type === "FORWARD" || action.type === "GO") {
        cancelPendingGate();
      }
    });
    const cancelWhenHidden = () => {
      if (document.hidden) cancelPendingGate();
    };
    // Escape stops the cover; a keyboard reader keeps the control it pressed.
    const cancelOnEscape = (event: KeyboardEvent) => {
      if (event.key !== "Escape" || !cancelPendingGate()) return;
      event.preventDefault();
      if (gateSource.current === "keyboard") opener.current?.focus({ preventScroll: true });
    };
    window.addEventListener("blur", cancelPendingGate);
    window.addEventListener("pagehide", cancelPendingGate);
    window.addEventListener("keydown", cancelOnEscape);
    document.addEventListener("visibilitychange", cancelWhenHidden);
    return () => {
      stopHistory();
      window.removeEventListener("blur", cancelPendingGate);
      window.removeEventListener("pagehide", cancelPendingGate);
      window.removeEventListener("keydown", cancelOnEscape);
      document.removeEventListener("visibilitychange", cancelWhenHidden);
    };
  }, [gate, router]);
  useEffect(
    () => () => {
      gatePending.current = false;
      if (gateTimer.current !== null) window.clearTimeout(gateTimer.current);
      gateImage.current = null;
      cancelScrollReset.current?.();
    },
    [],
  );
  return (
    <section
      ref={signatureRef}
      className={`form-pickup${isRexonance ? " is-rexonance-pickup" : ""}`}
      data-form-theme={rider.theme}
      aria-label={`${riderPrefix}${record.name}の記録`}
      aria-busy={gateActive}
    >
      <article className="form-pickup-card">
        {isRexonance ? (
          <div className="rexonance-card-ornaments" aria-hidden="true">
            <i />
            <i />
            <i />
            <span />
          </div>
        ) : null}
        <div className="form-pickup-visual">
          <img
            src={rider.img}
            {...dossierImage(rider.img)}
            {...formPickupImage(rider.img)}
            alt={`${riderPrefix}${record.name}のフォームビジュアル`}
            style={{ objectPosition: rider.pos }}
            decoding="async"
            fetchPriority="auto"
            loading="lazy"
          />
          <SlideOpenControl
            buttonRef={opener}
            className="form-pickup-plus"
            ariaLabel={`${riderPrefix}${record.name}をピックアップ`}
            label="フォーム詳細"
            onOpen={open}
          />
        </div>
        {/* The name leads: no kicker restates the card's role (2026-10-23). */}
        <div className="form-pickup-copy">
          {/* The signature lies behind the words: under the (opaque) art it
              was never seen. */}
          <FormSignature theme={rider.theme} />
          <h2>
            <span>{riderPrefix}</span>
            <b>{formName}</b>
          </h2>
          {rider.sub ? (
            <em>
              {rider.theme === "kemonohen" ? (
                <small className="form-signature-reading">けものへん</small>
              ) : null}
              <DisplayName value={rider.sub} />
            </em>
          ) : null}
          {/* A quote reads as a quote; a form without one shows its system
              as the plain line it is. */}
          {rider.quote ? (
            <q>{rider.quote}</q>
          ) : (
            <p className="form-pickup-system">{rider.system}</p>
          )}
          {/* The record strip (2026-10-21): the transformation calls as a
              numbered sequence and the spec sheet, on the card itself, the
              same on every file; the full record stays behind the control.
              Their shapes say what they are: no captions. */}
          <div className="form-pickup-record">
            <div className="form-pickup-record-calls">
              <ol className="form-pickup-calls" aria-label="変身音声">
                {rider.calls.map((call, index) => (
                  <li key={`${call}-${index}`}>
                    <i aria-hidden="true">{String(index + 1).padStart(2, "0")}</i>
                    <b>{call}</b>
                  </li>
                ))}
              </ol>
            </div>
            {stats.length ? (
              <div className="form-pickup-record-spec">
                <dl className="form-pickup-spec" aria-label="スペック">
                  {stats.map((s) => (
                    <div key={s.dt}>
                      <dt>{s.dt}</dt>
                      <dd>{s.dd}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ) : null}
          </div>
        </div>
      </article>
      <dialog
        ref={dlg}
        className={`form-pickup-dialog dg-focus-scope${isRexonance ? " is-rexonance-dialog" : ""}`}
        data-form-theme={rider.theme}
        tabIndex={-1}
        aria-label={`${riderPrefix}${record.name}`}
        onClose={resetScroll}
        onCancel={(e) => {
          e.preventDefault();
          close();
        }}
        onClick={(e) => {
          if (e.target === dlg.current) close();
        }}
      >
        <button
          type="button"
          className="form-pickup-close"
          data-liquid-pointer="true"
          onClick={close}
          aria-label="閉じる"
        >
          <LiquidPointerGlow />
          <span>CLOSE</span>
          <i aria-hidden="true">
            <UiVectorIcon kind="close" size={16} />
          </i>
        </button>
        <FormArrival theme={rider.theme} />
        <div className="form-pickup-panel">
          <FormSignature theme={rider.theme} />
          {isRexonance ? (
            <div className="rexonance-panel-ambient" aria-hidden="true">
              <i />
              <i />
              <i />
              <span />
            </div>
          ) : null}
          <div className="form-pickup-heading">
            <small>{rider.system}</small>
            <h2>
              <span>{riderPrefix}</span>
              <b>{formName}</b>
            </h2>
            {rider.sub ? (
              <em>
                {rider.theme === "kemonohen" ? (
                  <small className="form-signature-reading">けものへん</small>
                ) : null}
                <DisplayName value={rider.sub} />
              </em>
            ) : null}
            <div className="rider-call">
              {rider.calls.map((c, index) => (
                <b key={`${c}-${index}`}>{c}</b>
              ))}
            </div>
          </div>
          <div className="form-pickup-layout">
            <figure>
              <img
                src={rider.recordImg ?? rider.img}
                {...dossierImage(rider.recordImg ?? rider.img)}
                {...formPickupImage(rider.recordImg ?? rider.img)}
                alt=""
                style={{ objectPosition: rider.recordImg ? "50% 30%" : rider.pos }}
                decoding="async"
                // The record's own figure waits like every other: the gate's
                // warm-up (open) fetches the Rexonance file at high priority
                // when the record is asked for, not against the hero at load.
                loading="lazy"
                fetchPriority="auto"
              />
            </figure>
            <div>
              {overview.length ? (
                <section
                  className={`form-pickup-overview${
                    overview.length === 1 && [...overview[0]].length <= 12 ? " is-motto" : ""
                  }`}
                  aria-label="フォーム概要"
                >
                  <div>
                    {overview.map((paragraph) => (
                      <p key={paragraph.slice(0, 32)}>{paragraph}</p>
                    ))}
                  </div>
                </section>
